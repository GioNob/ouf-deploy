{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/authorization/authorization-policy-bundle-v1.json",
  "title": "OUF AuthorizationPolicyBundle v1",
  "description": "Immutable published policy snapshot loaded and evaluated locally by OUF service PEPs.",
  "type": "object",
  "required": [
    "publicationId",
    "policyVersion",
    "createdAt",
    "contentHash",
    "capabilitySchemaVersion",
    "grants",
    "denyRules"
  ],
  "properties": {
    "publicationId": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilitySchemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "policy-grant-v1.json"
      }
    },
    "denyRules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Authorization & Access Control Specification v1.3"
  ],
  "x-ouf-scope-control": "Authorization contracts only; no IAM vendor binding, Gateway route model, THS approval DTO, Query Governor model or MCP Server change.",
  "x-ouf-invariants": [
    "published bundle is immutable",
    "active pointer publication is atomic",
    "bundle is fully validated before atomic swap",
    "single request uses one policyVersion from evaluation start through decision/audit",
    "previous bundle remains available for rollback/audit",
    "no synchronous Policy Registry dependency on ordinary request path"
  ]
}
