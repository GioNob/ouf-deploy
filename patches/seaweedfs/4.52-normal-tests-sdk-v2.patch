+	"github.com/aws/aws-sdk-go-v2/credentials"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/aws-sdk-go-v2/service/s3/types"
+	"github.com/aws/smithy-go"
+	"github.com/stretchr/testify/require"
+)
+
+// newNormalS3Client preserves the explicit local endpoint, credentials and
+// addressing contract. The SDK never retries mutations implicitly.
+func newNormalS3Client(endpoint string, transport http.RoundTripper) *s3.Client {
+	return s3.New(s3.Options{
+		Region:           testRegion,
+		BaseEndpoint:     aws.String(endpoint),
+		Credentials:      credentials.NewStaticCredentialsProvider(testAccessKey, testSecretKey, ""),
+		UsePathStyle:     true,
+		RetryMaxAttempts: 1,
+		HTTPClient:       &http.Client{Transport: transport, Timeout: 30 * time.Second},
+	})
+}
+
+// signNormalS3Request signs the empty-body raw S3 fixtures without changing
+// their existing escaping, header or service contract.
+func signNormalS3Request(ctx context.Context, req *http.Request, now time.Time) error {
+	digest := sha256.Sum256(nil)
+	payloadHash := hex.EncodeToString(digest[:])
+	req.Header.Set("X-Amz-Content-Sha256", payloadHash)
+	return v4.NewSigner().SignHTTP(ctx, aws.Credentials{AccessKeyID: testAccessKey, SecretAccessKey: testSecretKey}, req, payloadHash, "s3", testRegion, now)
+}
+
+type normalRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f normalRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func normalResponse(r *http.Request, status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/xml"}}, Body: io.NopCloser(strings.NewReader(body)), Request: r}
+}
+
+func TestNormalSDKV2PutWireAndNoRetry(t *testing.T) {
+	for _, status := range []int{200, 400, 503} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			body := []byte("normal-sdk-fixture")
+			// This deliberately wrong MD5 must reach the server unchanged, as the
+			// existing negative checksum cases depend on a server-side BadDigest.
+			wrongMD5 := "AAAAAAAAAAAAAAAAAAAAAA=="
+			key := []byte("01234567890123456789012345678901")
+			keyHash := md5.Sum(key)
+			keyMD5 := base64.StdEncoding.EncodeToString(keyHash[:])
+			calls := 0
+			client := newNormalS3Client("http://127.0.0.1:8333", normalRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+				calls++
+				require.Equal(t, "PUT", r.Method)
+				require.Equal(t, "127.0.0.1:8333", r.URL.Host)
+				require.Equal(t, "/bucket/a%20b", r.URL.EscapedPath())
+				require.Equal(t, wrongMD5, r.Header.Get("Content-MD5"))
+				require.Equal(t, "AES256", r.Header.Get("X-Amz-Server-Side-Encryption-Customer-Algorithm"))
+				require.Equal(t, base64.StdEncoding.EncodeToString(key), r.Header.Get("X-Amz-Server-Side-Encryption-Customer-Key"))
+				require.Equal(t, keyMD5, r.Header.Get("X-Amz-Server-Side-Encryption-Customer-Key-Md5"))
+				require.Contains(t, r.Header.Get("Authorization"), "/us-west-2/s3/aws4_request")
+				raw, err := io.ReadAll(r.Body)
+				require.NoError(t, err)
+				require.Equal(t, body, raw)
+				if status == http.StatusOK {
+					return normalResponse(r, status, ""), nil
+				}
+				return normalResponse(r, status, "<Error><Code>BadDigest</Code><Message>fixture</Message></Error>"), nil
+			}))
+			_, err := client.PutObject(t.Context(), &s3.PutObjectInput{Bucket: aws.String("bucket"), Key: aws.String("a b"), Body: bytes.NewReader(body), ContentMD5: aws.String(wrongMD5), SSECustomerAlgorithm: aws.String("AES256"), SSECustomerKey: aws.String(base64.StdEncoding.EncodeToString(key)), SSECustomerKeyMD5: aws.String(keyMD5)})
+			if status == 200 {
+				require.NoError(t, err)
+			} else {
+				var apiError smithy.APIError
+				require.ErrorAs(t, err, &apiError)
+				require.Equal(t, "BadDigest", apiError.ErrorCode())
+			}
+			require.Equal(t, 1, calls, "the SDK must not replay ambiguous writes")
+		})
+	}
+}
