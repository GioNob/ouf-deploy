+	client, err := newClient("fixture-id", "fixture-secret", "us-east-1", "https://fixture.invalid", true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	opts := client.Options()
+	opts.HTTPClient = transport
+	return &S3Sink{conn: s3.New(opts), bucket: "bucket", uploaderPartSizeMb: 5, uploaderConcurrency: 1, uploaderMaxUploadParts: 10000}
+}
+
+func fixtureResponse(r *http.Request, status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Body: io.NopCloser(strings.NewReader(body)), Header: http.Header{"Content-Type": []string{"application/xml"}, "ETag": []string{`"fixture-etag"`}}, Request: r}
+}
+
+func checksumPresent(r *http.Request) bool {
+	return r.Header.Get("X-Amz-Checksum-Crc32") != "" || strings.Contains(r.Header.Get("X-Amz-Trailer"), "x-amz-checksum-crc32")
+}
+
+func TestS3SinkSinglePutMD5AndFlexibleChecksum(t *testing.T) {
+	content := []byte("whole-object fixture")
+	sum := md5.Sum(content)
+	calls := 0
+	sink := sdkSink(t, func(r *http.Request) (*http.Response, error) {
+		calls++
+		if r.Method != "PUT" || r.URL.Host != "fixture.invalid" || r.URL.Path != "/bucket/key" || !strings.Contains(r.Header.Get("Authorization"), "/us-east-1/s3/aws4_request") {
+			t.Fatal("request binding changed")
+		}
+		if r.Header.Get("Content-Md5") != base64.StdEncoding.EncodeToString(sum[:]) || !checksumPresent(r) {
+			t.Fatal("MD5 or flexible checksum missing")
+		}
+		if _, err := io.Copy(io.Discard, r.Body); err != nil {
+			t.Fatal(err)
+		}
+		return fixtureResponse(r, 200, ""), nil
+	})
+	err := sink.CreateEntry("/key", &filer_pb.Entry{Content: content, Attributes: &filer_pb.FuseAttributes{FileSize: uint64(len(content)), Md5: sum[:]}}, nil)
+	if err != nil || calls != 1 {
+		t.Fatalf("err=%v calls=%d", err, calls)
+	}
+}
