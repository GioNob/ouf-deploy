diff --git a/weed/replication/sink/filersink/chunk_progress.go b/weed/replication/sink/filersink/chunk_progress.go
new file mode 100644
--- /dev/null
+++ b/weed/replication/sink/filersink/chunk_progress.go
@@ -0,0 +1,52 @@
+package filersink
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"sync"
+)
+
+// chunkProgress is a deliberately small plain-text progress reporter for this
+// sink. It owns no goroutines and never treats a display failure as a copy
+// failure. Concurrent successful chunk completions share a single counter.
+type chunkProgress struct {
+	mu        sync.Mutex
+	writer    io.Writer
+	name      string
+	total     int64
+	completed int64
+}
+
+// Preserve the original progress bar's stdout stream. The final newline now
+// follows the counter on stdout instead of the old separate stderr callback.
+func newFilerChunkProgress(total int64, name string) *chunkProgress {
+	return newChunkProgress(total, name, os.Stdout)
+}
+
+func newChunkProgress(total int64, name string, writer io.Writer) *chunkProgress {
+	return &chunkProgress{writer: writer, name: name, total: total}
+}
+
+func (p *chunkProgress) Add(n int) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if n <= 0 || p.total <= 0 || p.completed >= p.total {
+		return
+	}
+	// Saturate before addition so an unusually large increment cannot wrap.
+	remaining := p.total - p.completed
+	if int64(n) >= remaining {
+		p.completed = p.total
+	} else {
+		p.completed += int64(n)
+	}
+	if p.writer == nil {
+		return
+	}
+	suffix := ""
+	if p.completed == p.total {
+		suffix = "\n"
+	}
+	_, _ = fmt.Fprintf(p.writer, "\r%s: %d/%d chunks%s", p.name, p.completed, p.total, suffix)
+}
diff --git a/weed/replication/sink/filersink/chunk_progress_test.go b/weed/replication/sink/filersink/chunk_progress_test.go
new file mode 100644
--- /dev/null
+++ b/weed/replication/sink/filersink/chunk_progress_test.go
@@ -0,0 +1,113 @@
+package filersink
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestChunkProgressReportsOnlySuccessfulCompletions(t *testing.T) {
+	var out bytes.Buffer
+	p := newChunkProgress(3, "sample [red].bin", &out)
+	if out.Len() != 0 {
+		t.Fatal("construction should not report progress")
+	}
+	p.Add(1)
+	p.Add(0)
+	p.Add(-1)
+	if got, want := out.String(), "\rsample [red].bin: 1/3 chunks"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+	// A failed copy does not call Add, and therefore cannot render completion.
+	if strings.Contains(out.String(), "3/3") || strings.Contains(out.String(), "\n") {
+		t.Fatal("unfinished copy reported complete")
+	}
+	p.Add(2)
+	p.Add(1)
+	if got, want := out.String(), "\rsample [red].bin: 1/3 chunks\rsample [red].bin: 3/3 chunks\n"; got != want {
+		t.Fatalf("got %q, want %q", got, want)
+	}
+}
+
+func TestChunkProgressConcurrentCompletionsAreSerialized(t *testing.T) {
+	var out bytes.Buffer
+	const total = 128
+	p := newChunkProgress(total, "large.bin", &out)
+	var wg sync.WaitGroup
+	for i := 0; i < total; i++ {
+		wg.Add(1)
+		go func() { defer wg.Done(); p.Add(1) }()
+	}
+	wg.Wait()
+	frames := strings.Split(out.String(), "\r")
+	if len(frames) != total+1 {
+		t.Fatalf("got %d progress frames", len(frames)-1)
+	}
+	for i := 1; i <= total; i++ {
+		want := fmt.Sprintf("large.bin: %d/%d chunks", i, total)
+		if i == total {
+			want += "\n"
+		}
+		if frames[i] != want {
+			t.Fatalf("frame %d=%q want %q", i, frames[i], want)
+		}
+	}
+}
+
+type progressFailWriter struct{ calls int }
+
+func (w *progressFailWriter) Write([]byte) (int, error) {
+	w.calls++
+	return 0, errors.New("display unavailable")
+}
+
+func TestChunkProgressWriterFailureDoesNotRetryOrPanic(t *testing.T) {
+	writer := &progressFailWriter{}
+	p := newChunkProgress(2, "sample", writer)
+	p.Add(1)
+	p.Add(1)
+	p.Add(1)
+	if writer.calls != 2 {
+		t.Fatalf("display failure retried or completed more than once: %d", writer.calls)
+	}
+	newChunkProgress(2, "sample", nil).Add(1)
+	newChunkProgress(0, "sample", io.Discard).Add(1)
+}
+
+func TestChunkProgressLargeIncrementCannotOverflow(t *testing.T) {
+	var out bytes.Buffer
+	p := newChunkProgress(int64(math.MaxInt), "large", &out)
+	p.Add(1)
+	p.Add(math.MaxInt)
+	if !strings.HasSuffix(out.String(), fmt.Sprintf("%d/%d chunks\n", math.MaxInt, math.MaxInt)) {
+		t.Fatalf("overflowed progress: %q", out.String())
+	}
+}
+
+func TestChunkProgressPreservesStdoutStream(t *testing.T) {
+	outputPath := filepath.Join(t.TempDir(), "stdout")
+	output, err := os.Create(outputPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	original := os.Stdout
+	os.Stdout = output
+	defer func() { os.Stdout = original; output.Close() }()
+	p := newFilerChunkProgress(2, "sample.bin")
+	p.Add(1)
+	p.Add(1)
+	bytes, err := os.ReadFile(outputPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got, want := string(bytes), "\rsample.bin: 1/2 chunks\rsample.bin: 2/2 chunks\n"; got != want {
+		t.Fatalf("progress stream changed: got %q want %q", got, want)
+	}
+}
