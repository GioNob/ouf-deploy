[Unit]
Description=OUF read-only semantic provider R3 health
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/ouf/operational-signals/r3-health.env
ExecStart=/usr/bin/python3 -I -B /opt/ouf-deploy/scripts/semantic-provider-r3-health.py --plan --install-root ${R3_INSTALL_ROOT} --wrapper ${R3_WRAPPER} --wrapper-sha256 ${R3_WRAPPER_SHA256} --docker ${R3_DOCKER} --docker-sha256 ${R3_DOCKER_SHA256} --docker-socket ${R3_DOCKER_SOCKET} --systemctl ${R3_SYSTEMCTL} --systemctl-sha256 ${R3_SYSTEMCTL_SHA256} --nft ${R3_NFT} --nft-sha256 ${R3_NFT_SHA256} --timeout-seconds 30 --status-path /var/lib/ouf-semantic-provider-health/status.json
StateDirectory=ouf-semantic-provider-health
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/ouf-semantic-provider-health
ReadOnlyPaths=/opt/ouf-deploy /etc/ouf -/run/docker.sock
RestrictAddressFamilies=AF_UNIX
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C OPENSSL_CONF=/dev/null

