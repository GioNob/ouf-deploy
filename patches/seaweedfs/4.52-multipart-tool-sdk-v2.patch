@@ -0,0 +1,23 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+)
+
+func TestNewS3ClientUsesBoundedLocalConfiguration(t *testing.T) {
+	options := newS3Client().Options()
+	if options.Region != "us-west-1" {
+		t.Fatalf("Region = %q, want %q", options.Region, "us-west-1")
+	}
+	if got := aws.ToString(options.BaseEndpoint); got != "http://localhost:8333" {
+		t.Fatalf("BaseEndpoint = %q, want %q", got, "http://localhost:8333")
+	}
+	if !options.UsePathStyle {
+		t.Fatal("UsePathStyle = false, want true for the local S3 fixture")
+	}
+	if options.RetryMaxAttempts != 1 {
+		t.Fatalf("RetryMaxAttempts = %d, want 1", options.RetryMaxAttempts)
+	}
+}

