+func TestNormalIAMSDKV2SingleAttempt(t *testing.T) {
+	c := newNormalIAMClient("http://127.0.0.1:8333", "fixture-key", "fixture-secret")
+	attempts := 0
+	_, err := c.CreateUser(t.Context(), &iam.CreateUserInput{UserName: aws.String("fixture-user")}, func(o *iam.Options) {
+		o.HTTPClient = &http.Client{Timeout: 30 * time.Second, Transport: normalIAMRoundTripper(func(req *http.Request) (*http.Response, error) {
+			attempts++
+			return &http.Response{StatusCode: 500, Header: http.Header{"Content-Type": {"text/xml"}}, Body: io.NopCloser(strings.NewReader(`<ErrorResponse><Error><Type>Receiver</Type><Code>ServiceFailure</Code><Message>fixture</Message></Error></ErrorResponse>`)), Request: req}, nil
+		})}
+	})
+	var apiError smithy.APIError
+	require.True(t, errors.As(err, &apiError))
+	require.Equal(t, "ServiceFailure", apiError.ErrorCode())
+	require.Equal(t, 1, attempts)
+}
