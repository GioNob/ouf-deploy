+func TestKMSProfileAndExplicitEndpoint(t *testing.T) {
+	isolateCredentials(t)
+	path := filepath.Join(t.TempDir(), "credentials")
+	if err := os.WriteFile(path, []byte("[fixture]\naws_access_key_id = profile-id\naws_secret_access_key = profile-secret\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", path)
+	c := fixtureConfig()
+	c.Set("access_key", "")
+	c.Set("secret_key", "")
+	c.Set("session_token", "")
+	c.Set("profile", "fixture")
+	c.Set("endpoint", "https://kms.fixture.invalid")
+	t.Setenv("AWS_ENDPOINT_URL_KMS", "https://unreviewed.invalid")
+	p := providerFor(t, c)
+	o := p.client.Options()
+	creds, err := o.Credentials.Retrieve(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if creds.AccessKeyID != "profile-id" || o.BaseEndpoint == nil || *o.BaseEndpoint != "https://kms.fixture.invalid" {
+		t.Fatal("profile or explicit endpoint lost")
+	}
+	tr := o.HTTPClient.(*awshttp.BuildableClient)
+	if tr.GetTimeout() != 30*time.Second || tr.GetDialer().Timeout != 10*time.Second {
+		t.Fatal("default bounds lost")
+	}
+}
