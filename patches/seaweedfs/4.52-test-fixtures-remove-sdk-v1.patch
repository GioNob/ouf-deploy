@@ -0,0 +1,183 @@
+// Package testclient builds IAM Query protocol requests for local handler tests.
+//
+// It intentionally implements only the request shapes exercised by SeaweedFS.
+// Keeping this small encoder local avoids retaining the end-of-support AWS SDK
+// for Go v1 merely as a test fixture.
+package testclient
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"reflect"
+	"strconv"
+	"strings"
+)
+
+const (
+	ErrCodeDeleteConflictException          = "DeleteConflict"
+	ErrCodeEntityAlreadyExistsException     = "EntityAlreadyExists"
+	ErrCodeInvalidInputException            = "InvalidInput"
+	ErrCodeLimitExceededException           = "LimitExceeded"
+	ErrCodeMalformedPolicyDocumentException = "MalformedPolicyDocument"
+	ErrCodeNoSuchEntityException            = "NoSuchEntity"
+	ErrCodeServiceFailureException          = "ServiceFailure"
+	ErrCodeUnmodifiableEntityException      = "UnmodifiableEntity"
+	StatusTypeInactive                      = "Inactive"
+)
+
+type Tag struct{ Key, Value *string }
+
+type CreateUserInput struct{ UserName *string }
+type ListUsersInput struct{}
+type GetUserInput struct{ UserName *string }
+type UpdateUserInput struct{ UserName, NewUserName *string }
+type DeleteUserInput struct{ UserName *string }
+type CreateAccessKeyInput struct{ UserName *string }
+type ListAccessKeysInput struct{ UserName *string }
+type UpdateAccessKeyInput struct{ UserName, AccessKeyId, Status *string }
+type DeleteAccessKeyInput struct{ UserName, AccessKeyId *string }
+type CreatePolicyInput struct{ PolicyName, PolicyDocument *string }
+type CreatePolicyVersionInput struct {
+	PolicyArn, PolicyDocument *string
+	SetAsDefault              *bool
+}
+type GetPolicyInput struct{ PolicyArn *string }
+type GetPolicyVersionInput struct{ PolicyArn, VersionId *string }
+type ListPolicyVersionsInput struct{ PolicyArn *string }
+type DeletePolicyInput struct{ PolicyArn *string }
+type PutUserPolicyInput struct{ UserName, PolicyName, PolicyDocument *string }
+type GetUserPolicyInput struct{ UserName, PolicyName *string }
+type DeleteUserPolicyInput struct{ UserName, PolicyName *string }
+type AttachUserPolicyInput struct{ UserName, PolicyArn *string }
+type DetachUserPolicyInput struct{ UserName, PolicyArn *string }
+type ListAttachedUserPoliciesInput struct{ UserName *string }
+type TagUserInput struct {
+	UserName *string
+	Tags     []*Tag
+}
+type ListUserTagsInput struct{ UserName *string }
+type UntagUserInput struct {
+	UserName *string
+	TagKeys  []*string
+}
+
+type Request struct{ HTTPRequest *http.Request }
+
+func (r *Request) Build() error { return nil }
+
+type Client struct{}
+
+func New(_ ...any) *Client { return &Client{} }
+
+func encode(values url.Values, prefix string, value reflect.Value) {
+	if !value.IsValid() {
+		return
+	}
+	if value.Kind() == reflect.Ptr {
+		if value.IsNil() {
+			return
+		}
+		encode(values, prefix, value.Elem())
+		return
+	}
+	switch value.Kind() {
+	case reflect.Struct:
+		t := value.Type()
+		for i := 0; i < value.NumField(); i++ {
+			name := t.Field(i).Name
+			if prefix != "" {
+				name = prefix + "." + name
+			}
+			encode(values, name, value.Field(i))
+		}
+	case reflect.Slice:
+		for i := 0; i < value.Len(); i++ {
+			encode(values, fmt.Sprintf("%s.member.%d", prefix, i+1), value.Index(i))
+		}
+	case reflect.String:
+		values.Set(prefix, value.String())
+	case reflect.Bool:
+		values.Set(prefix, strconv.FormatBool(value.Bool()))
+	}
+}
+
+func newRequest(action string, input any) (*Request, error) {
+	values := url.Values{"Action": {action}, "Version": {"2010-05-08"}}
+	encode(values, "", reflect.ValueOf(input))
+	req, err := http.NewRequest(http.MethodPost, "https://iam.amazonaws.com/", strings.NewReader(values.Encode()))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded; charset=utf-8")
+	return &Request{HTTPRequest: req}, nil
+}
+
+func (c *Client) CreateUserRequest(v *CreateUserInput) (*Request, error) {
+	return newRequest("CreateUser", v)
+}
