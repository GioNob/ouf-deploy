+package kafka
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/seaweedfs/seaweedfs/weed/notification"
+	"github.com/seaweedfs/seaweedfs/weed/util"
+	"github.com/spf13/viper"
+	"google.golang.org/protobuf/proto"
+)
+
+type allowedFixtureQueue struct{ initialized int }
+
+func (*allowedFixtureQueue) GetName() string { return "fixture" }
+func (q *allowedFixtureQueue) Initialize(util.Configuration, string) error {
+	q.initialized++
+	if os.Getenv("OUF_KAFKA_DENIAL_CHILD") != "" {
+		fmt.Println("OTHER_PROVIDER_INITIALIZED")
+	}
+	return nil
+}
+func (*allowedFixtureQueue) SendMessage(string, proto.Message) error { return nil }
+
+func TestOUFStandardKafkaRegisteredAndAlwaysRejected(t *testing.T) {
+	count := 0
+	for _, q := range notification.MessageQueues {
+		if q.GetName() == "kafka" {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatalf("Kafka must stay recognizable exactly once, found %d", count)
+	}
+	q := &KafkaQueue{}
+	if !errors.Is(q.Initialize(nil, "notification.kafka."), ErrUnsupportedInOUFStandardProfile) {
+		t.Fatal("excluded initialize accepted")
+	}
+	if !errors.Is(q.SendMessage("/never-send", nil), ErrUnsupportedInOUFStandardProfile) {
+		t.Fatal("excluded publish acknowledged")
+	}
+}
+
+func TestOUFStandardKafkaConfigurationStopsBeforeOtherProvider(t *testing.T) {
+	if mode := os.Getenv("OUF_KAFKA_DENIAL_CHILD"); mode != "" {
+		_ = flag.Set("logtostderr", "true")
+		other := &allowedFixtureQueue{}
+		notification.MessageQueues = []notification.MessageQueue{other, &KafkaQueue{}}
+		v := viper.New()
+		v.Set("notification.kafka.enabled", true)
+		if mode == "mixed" {
+			v.Set("notification.fixture.enabled", true)
+		}
+		notification.LoadConfiguration(util.NewViperProxy(v), "notification.")
+		fmt.Println("UNEXPECTED_CONFIGURATION_SUCCESS")
+		return
+	}
+	for _, mode := range []string{"kafka-only", "mixed"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestOUFStandardKafkaConfigurationStopsBeforeOtherProvider$")
+			cmd.Env = append(os.Environ(), "OUF_KAFKA_DENIAL_CHILD="+mode)
+			output, err := cmd.CombinedOutput()
+			if ctx.Err() != nil {
+				t.Fatalf("denial process exceeded budget: %s", output)
+			}
+			if err == nil || strings.Contains(string(output), "OTHER_PROVIDER_INITIALIZED") || strings.Contains(string(output), "UNEXPECTED_CONFIGURATION_SUCCESS") {
+				t.Fatalf("configuration did not stop before effects: %v %s", err, output)
+			}
+			wanted := "OUF_STANDARD_PROFILE_KAFKA_INTEGRATION_UNSUPPORTED"
+			if mode == "mixed" {
+				wanted = "Notification message queue is enabled for both"
+			}
+			if !strings.Contains(string(output), wanted) {
+				t.Fatalf("unexpected rejection: %s", output)
+			}
+		})
+	}
+}
+
+func TestOUFStandardNonKafkaQueueRemainsSelectable(t *testing.T) {
+	oldQueues, oldQueue := notification.MessageQueues, notification.Queue
+	defer func() { notification.MessageQueues = oldQueues; notification.Queue = oldQueue }()
+	other := &allowedFixtureQueue{}
+	notification.MessageQueues = []notification.MessageQueue{&KafkaQueue{}, other}
+	v := viper.New()
+	v.Set("notification.fixture.enabled", true)
+	notification.LoadConfiguration(util.NewViperProxy(v), "notification.")
+	if other.initialized != 1 || notification.Queue != other {
+		t.Fatal("supported queue selection changed")
+	}
+}
