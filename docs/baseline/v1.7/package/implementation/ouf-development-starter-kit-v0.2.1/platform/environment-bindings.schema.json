{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/starter/platform/environment-bindings.schema.json",
  "title": "OUF Starter Environment Bindings",
  "type": "object",
  "required": [
    "environment",
    "identityProfileRef",
    "telemetry",
    "secrets"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "identityProfileRef": {
      "type": "string",
      "minLength": 1
    },
    "telemetry": {
      "type": "object",
      "required": [
        "otlpEndpointRef"
      ],
      "properties": {
        "otlpEndpointRef": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "secrets": {
      "type": "object",
      "required": [
        "providerRef"
      ],
      "properties": {
        "providerRef": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "database": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "endpointRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "gateway": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "serviceRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "objectStorage": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "endpointRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
