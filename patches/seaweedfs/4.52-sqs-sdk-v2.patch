+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"google.golang.org/protobuf/proto"
+)
+
+type httpFunc func(*http.Request) (*http.Response, error)
+
+func (f httpFunc) Do(r *http.Request) (*http.Response, error) { return f(r) }
+
+func isolateCredentials(t *testing.T) {
+	t.Helper()
+	for _, name := range []string{"AWS_PROFILE", "AWS_DEFAULT_PROFILE", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN", "AWS_ENDPOINT_URL", "AWS_ENDPOINT_URL_SQS", "AWS_CONTAINER_CREDENTIALS_FULL_URI", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"} {
+		t.Setenv(name, "")
+	}
+	t.Setenv("AWS_EC2_METADATA_DISABLED", "true")
+	path := filepath.Join(t.TempDir(), "empty")
+	if err := os.WriteFile(path, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("AWS_CONFIG_FILE", path)
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", path)
+}
+
+func TestClientCredentialSelectionAndLimits(t *testing.T) {
+	isolateCredentials(t)
+	t.Setenv("AWS_ACCESS_KEY_ID", "environment-id")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "environment-secret")
+	for _, tc := range []struct{ name, id, secret, want string }{
+		{"explicit", "static-id", "static-secret", "static-id"}, {"default-chain", "", "", "environment-id"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client, err := NewClient(context.Background(), tc.id, tc.secret, "us-east-1")
+			if err != nil {
+				t.Fatal(err)
+			}
+			opts := client.Options()
+			creds, err := opts.Credentials.Retrieve(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if creds.AccessKeyID != tc.want {
+				t.Fatal("selected unexpected credential provider")
+			}
+			if opts.RetryMaxAttempts != 1 {
+				t.Fatalf("unexpected attempts %d", opts.RetryMaxAttempts)
+			}
+			transport, ok := opts.HTTPClient.(*awshttp.BuildableClient)
+			if !ok || transport.GetTimeout() != 30*time.Second {
+				t.Fatal("request timeout lost")
+			}
+		})
+	}
+	for _, pair := range [][2]string{{"partial", ""}, {"", "partial"}} {
+		if client, err := NewClient(context.Background(), pair[0], pair[1], "us-east-1"); err == nil || client != nil {
+			t.Fatal("partial credentials accepted")
+		}
+	}
+}
+
+func sdkFixture(t *testing.T, transport httpFunc) *sqs.Client {
+	t.Helper()
+	isolateCredentials(t)
+	client, err := NewClient(context.Background(), "fixture-id", "fixture-secret", "us-east-1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	opts := client.Options()
+	opts.HTTPClient = transport
+	return sqs.New(opts)
+}
+
+func response(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/x-amz-json-1.0"}}, Body: io.NopCloser(strings.NewReader(body))}
+}
+
+func TestSDKSendWireAndAmbiguousFailureNoRetry(t *testing.T) {
+	for _, status := range []int{200, 503} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			calls := 0
+			event := &filer_pb.EventNotification{NewParentPath: "/fixture"}
+			expected, err := proto.Marshal(event)
+			if err != nil {
+				t.Fatal(err)
+			}
+			client := sdkFixture(t, func(r *http.Request) (*http.Response, error) {
+				calls++
+				if r.Header.Get("X-Amz-Target") != "AmazonSQS.SendMessage" || !strings.Contains(r.Header.Get("Authorization"), "Credential=fixture-id/") {
+					t.Fatal("missing operation or signature")
+				}
+				var body struct {
+					DelaySeconds          int
+					MessageBody, QueueUrl string
+					MessageAttributes     map[string]struct{ DataType, StringValue string }
+				}
+				if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+					t.Fatal(err)
+				}
+				if body.DelaySeconds != 10 || body.MessageBody != string(expected) || body.QueueUrl != "https://sqs.us-east-1.amazonaws.com/123/fixture" || body.MessageAttributes["key"].DataType != "String" || body.MessageAttributes["key"].StringValue != "event-key" {
+					t.Fatalf("wire mismatch: %+v", body)
+				}
+				if status == 503 {
+					return response(503, `{"__type":"ServiceUnavailable","message":"ambiguous send"}`), nil
+				}
+				return response(200, `{"MessageId":"fixture"}`), nil
+			})
+			pub := AwsSqsPub{svc: client, queueUrl: "https://sqs.us-east-1.amazonaws.com/123/fixture"}
+			err = pub.SendMessage("event-key", event)
+			if (err != nil) != (status == 503) || calls != 1 {
+				t.Fatalf("err=%v calls=%d", err, calls)
+			}
+			if status == 503 {
+				var operation interface{ Unwrap() error }
+				if !errors.As(err, &operation) {
+					t.Fatal("error cause lost")
+				}
+			}
+		})
+	}
+}
+
+func TestSDKQueueResolution(t *testing.T) {
+	for _, tc := range []struct {
+		name, body       string
+		status           int
+		wantErr, missing bool
+	}{
+		{"success", `{"QueueUrl":"https://sqs.us-east-1.amazonaws.com/123/fixture"}`, 200, false, false},
+		{"empty", `{}`, 200, true, false},
+		{"missing", `{"__type":"QueueDoesNotExist","message":"missing"}`, 400, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			client := sdkFixture(t, func(r *http.Request) (*http.Response, error) {
+				var body struct{ QueueName string }
+				if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+					t.Fatal(err)
+				}
+				if body.QueueName != "fixture" || r.Header.Get("X-Amz-Target") != "AmazonSQS.GetQueueUrl" {
+					t.Fatal("lookup wire mismatch")
+				}
+				return response(tc.status, tc.body), nil
+			})
+			url, err := ResolveQueueURL(context.Background(), client, "fixture")
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("unexpected error %v", err)
+			}
+			if err == nil && url == "" {
+				t.Fatal("empty successful URL")
+			}
+			if tc.missing {
+				var missing *types.QueueDoesNotExist
+				if !errors.As(err, &missing) {
+					t.Fatalf("typed cause lost: %v", err)
+				}
+			}
+		})
+	}
+}
