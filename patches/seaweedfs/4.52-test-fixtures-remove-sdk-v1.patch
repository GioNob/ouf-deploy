diff --git a/workspace/scratch/98dabd1608e5/seaweedfs-src/weed/s3api/testv4/signer.go b/weed/s3api/testv4/signer.go
new file mode 100644
index 0000000..930a3f9
--- /dev/null
+++ b/weed/s3api/testv4/signer.go
@@ -0,0 +1,105 @@
+// Package testv4 adapts the maintained AWS SDK for Go v2 signer to the small
+// request-signing surface used by SeaweedFS regression tests.
+package testv4
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	sdkv4 "github.com/aws/aws-sdk-go-v2/aws/signer/v4"
+	"github.com/seaweedfs/seaweedfs/weed/s3api/testv4/credentials"
+)
+
+type Signer struct {
+	credentials aws.Credentials
+	signer      *sdkv4.Signer
+}
+
+func NewSigner(creds *credentials.Credentials) *Signer {
+	return &Signer{
+		credentials: aws.Credentials{
+			AccessKeyID: creds.AccessKeyID, SecretAccessKey: creds.SecretAccessKey,
+			SessionToken: creds.SessionToken,
+		},
+		signer: sdkv4.NewSigner(),
+	}
+}
+
+func payloadHash(body io.ReadSeeker) (string, error) {
+	if body == nil {
+		sum := sha256.Sum256(nil)
+		return hex.EncodeToString(sum[:]), nil
+	}
+	position, err := body.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return "", err
+	}
+	if _, err = body.Seek(0, io.SeekStart); err != nil {
+		return "", err
+	}
+	h := sha256.New()
+	if _, err = io.Copy(h, body); err != nil {
+		return "", err
+	}
+	if _, err = body.Seek(position, io.SeekStart); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(h.Sum(nil)), nil
+}
+
+func (s *Signer) Sign(req *http.Request, body io.ReadSeeker, service, region string, signingTime time.Time) (http.Header, error) {
+	hash, err := payloadHash(body)
+	if err != nil {
+		return nil, err
+	}
+	// The v1 signer excluded the transport-generated Content-Length header.
+	// It also materialized the S3 payload hash header before canonicalization.
+	contentLength := req.ContentLength
+	req.ContentLength = -1
+	defer func() { req.ContentLength = contentLength }()
+	if service == "s3" {
+		if suppliedHash := req.Header.Get("X-Amz-Content-Sha256"); suppliedHash != "" {
+			hash = suppliedHash
+		} else {
+			req.Header.Set("X-Amz-Content-Sha256", hash)
+		}
+	}
+	err = s.signer.SignHTTP(context.Background(), s.credentials, req, hash, service, region, signingTime)
+	return req.Header, err
+}
+
+func (s *Signer) Presign(req *http.Request, body io.ReadSeeker, service, region string, expires time.Duration, signingTime time.Time) (http.Header, error) {
+	hash, err := payloadHash(body)
+	if err != nil {
+		return nil, err
+	}
+	query := req.URL.Query()
+	query.Set("X-Amz-Expires", strconv.FormatInt(int64(expires/time.Second), 10))
+	req.URL.RawQuery = query.Encode()
+	contentLength := req.ContentLength
+	req.ContentLength = -1
+	defer func() { req.ContentLength = contentLength }()
+	if service == "s3" {
+		hash = "UNSIGNED-PAYLOAD"
+	}
+	signedURI, headers, err := s.signer.PresignHTTP(context.Background(), s.credentials, req, hash, service, region, signingTime)
+	if err != nil {
+		return nil, err
+	}
+	signedURL, err := url.Parse(signedURI)
+	if err != nil {
+		return nil, err
+	}
+	req.URL = signedURL
+	for name, values := range headers {
+		req.Header[name] = append([]string(nil), values...)
+	}
+	return headers, nil
+}
