{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/authorization/principal-context-v1.json",
  "title": "OUF PrincipalContext v1",
  "description": "Normalized trusted principal context derived from validated token/client trust model. Never authoritative when supplied by an application payload.",
  "type": "object",
  "required": [
    "subject",
    "actorType",
    "issuer"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "actorType": {
      "type": "string",
      "enum": [
        "HUMAN_USER",
        "AI_AGENT",
        "MCP_SERVER",
        "SERVICE_IDENTITY",
        "EXTERNAL_SYSTEM"
      ]
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "clientId": {
      "type": [
        "string",
        "null"
      ]
    },
    "externalRoleRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "orgRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acr": {
      "type": [
        "string",
        "null"
      ]
    },
    "amr": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "authTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "delegatedVia": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Authorization & Access Control Specification v1.3"
  ],
  "x-ouf-scope-control": "Authorization contracts only; no IAM vendor binding, Gateway route model, THS approval DTO, Query Governor model or MCP Server change.",
  "x-ouf-invariants": [
    "actorType derives from validated token/client trust model, never request body",
    "delegatedVia is audit/context only and never changes subject authority",
    "SERVICE_IDENTITY cannot satisfy HUMAN_USER guard"
  ]
}
