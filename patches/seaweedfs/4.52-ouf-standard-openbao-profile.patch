+
+func TestOUFStandardBackupRejectsBeforeSinkCheckpointOrRemoteOperations(t *testing.T) {
+	oldConfig := viper.Get("kms")
+	defer viper.Set("kms", oldConfig)
+	viper.Set("kms", map[string]interface{}{"providers": map[string]interface{}{"excluded": map[string]interface{}{"type": "openbao"}}})
+	offset, err := doFilerBackup(nil, nil, nil, nil, nil, 0, 0, 17)
+	if offset != 17 || !errors.Is(err, kms.ErrOUFUnsupportedKMSProvider) {
+		t.Fatalf("offset=%d error=%v", offset, err)
+	}
+}
