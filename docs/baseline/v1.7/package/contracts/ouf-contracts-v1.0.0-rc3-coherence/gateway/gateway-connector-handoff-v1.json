{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/gateway/gateway-connector-handoff-v1.json",
  "title": "OUF Gateway Connector Handoff v1",
  "description": "Logical handoff from Gateway boundary to Connector/Adapter for governed ingestion calls.",
  "type": "object",
  "required": [
    "ingestionId",
    "correlationId",
    "sourceId",
    "dataset",
    "capabilityId",
    "operation",
    "contentType",
    "sourceSchemaName",
    "sourceSchemaVersion",
    "extractionProfileId",
    "extractionProfileVersion",
    "authenticatedPrincipal"
  ],
  "properties": {
    "ingestionId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "SNAPSHOT",
        "UPSERT",
        "DELETE",
        "TOMBSTONE"
      ]
    },
    "contentType": {
      "type": "string",
      "minLength": 1
    },
    "sourceSchemaName": {
      "type": "string",
      "minLength": 1
    },
    "sourceSchemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "extractionProfileId": {
      "type": "string",
      "minLength": 1
    },
    "extractionProfileVersion": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "payload": {
      "type": [
        "object",
        "array",
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "objectReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "authenticatedPrincipal": {
      "$ref": "../authorization/principal-context-v1.json"
    },
    "routeMetadata": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "payload"
      ]
    },
    {
      "required": [
        "objectReference"
      ]
    }
  ],
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Urban API Gateway v1.2"
  ],
  "x-ouf-scope-control": "Gateway boundary/runtime contracts only. No Query Complexity Governor, fine-grained data authorization, Durable ACK authority, schema-drift classification, ETL, semantic processing, Object Resolution, UDP materialization, THS decision logic or MCP Server implementation.",
  "x-ouf-invariants": [
    "Gateway delivers native payload/reference; Connector builds CanonicalDataEnvelope",
    "Gateway does not perform semantic mapping, deduplication, object resolution or Data Lake/UDP persistence"
  ]
}
