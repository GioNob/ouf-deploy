diff --git a/weed/replication/sink/s3sink/client.go b/weed/replication/sink/s3sink/client.go
new file mode 100644
--- /dev/null
+++ b/weed/replication/sink/s3sink/client.go
@@ -0,0 +1,86 @@
+package S3Sink
+
+import (
+	"context"
+	"fmt"
+	"net/url"
+	"time"
+
+	awshttp "github.com/aws/aws-sdk-go-v2/aws/transport/http"
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/credentials"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/smithy-go/middleware"
+	smithyhttp "github.com/aws/smithy-go/transport/http"
+)
+
+// newClient keeps identity and endpoint selection explicit. One SDK attempt
+// avoids hidden replays of a PUT or multipart creation with an ambiguous outcome.
+// Existing owner recovery remains separate; this is not a durable retry policy.
+func newClient(accessKey, secretKey, region, endpoint string, pathStyle bool) (*s3.Client, error) {
+	if region == "" {
+		return nil, fmt.Errorf("S3 sink requires an explicit region")
+	}
+	if (accessKey == "") != (secretKey == "") {
+		return nil, fmt.Errorf("S3 sink requires both static credential fields or neither")
+	}
+	if endpoint != "" {
+		u, err := url.Parse(endpoint)
+		if err != nil || u.Hostname() == "" || (u.Scheme != "https" && u.Scheme != "http") || u.User != nil || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.Opaque != "" {
+			return nil, fmt.Errorf("S3 sink endpoint must be an explicit HTTP(S) binding without credentials, query or fragment")
+		}
+	}
+	opts := []func(*config.LoadOptions) error{config.WithRegion(region), config.WithRetryMaxAttempts(1), config.WithHTTPClient(awshttp.NewBuildableClient().WithTimeout(30 * time.Second))}
+	if accessKey != "" {
+		opts = append(opts, config.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(accessKey, secretKey, "")))
+	}
+	cfg, err := config.LoadDefaultConfig(context.Background(), opts...)
+	if err != nil {
+		return nil, fmt.Errorf("load S3 sink configuration: %w", err)
+	}
+	client := s3.NewFromConfig(cfg, func(o *s3.Options) {
+		o.UsePathStyle = pathStyle
+		if endpoint != "" {
+			o.BaseEndpoint = &endpoint
+		}
+	})
+	if endpoint == "" && client.Options().BaseEndpoint != nil {
+		return nil, fmt.Errorf("S3 sink endpoint override requires an explicit binding")
+	}
+	return client, nil
+}
+
+// transfermanager uses flexible checksums and has no ContentMD5 input field.
+// Keep the existing whole-object MD5 contract for a single PUT, alongside the
+// maintained client's checksums. Never attach it to UploadPart.
+type checksummedClient struct {
+	*s3.Client
+	contentMD5 string
+}
+
+func (c checksummedClient) PutObject(ctx context.Context, in *s3.PutObjectInput, opts ...func(*s3.Options)) (*s3.PutObjectOutput, error) {
+	copy := *in
+	if c.contentMD5 != "" {
+		copy.ContentMD5 = &c.contentMD5
+	}
+	if copy.ContentType == nil {
+		opts = append(opts, omitUnspecifiedContentType)
+	}
+	return c.Client.PutObject(ctx, &copy, opts...)
+}
+
+// SDK v2 defaults a missing PUT Content-Type to application/octet-stream.
+// Keep the historical omission, before SigV4 signing, without changing an
+// explicit MIME value or any multipart protocol request headers.
+func omitUnspecifiedContentType(o *s3.Options) {
+	o.APIOptions = append(o.APIOptions, func(stack *middleware.Stack) error {
+		return stack.Serialize.Insert(middleware.SerializeMiddlewareFunc("PreserveMissingContentType", func(ctx context.Context, in middleware.SerializeInput, next middleware.SerializeHandler) (middleware.SerializeOutput, middleware.Metadata, error) {
+			req, ok := in.Request.(*smithyhttp.Request)
+			if !ok {
+				return middleware.SerializeOutput{}, middleware.Metadata{}, fmt.Errorf("unexpected S3 request transport")
+			}
+			req.Header.Del("Content-Type")
+			return next.HandleSerialize(ctx, in)
+		}), "OperationSerializer", middleware.After)
+	})
+}
