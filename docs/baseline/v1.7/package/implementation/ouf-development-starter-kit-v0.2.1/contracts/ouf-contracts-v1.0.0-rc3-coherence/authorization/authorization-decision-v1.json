{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/authorization/authorization-decision-v1.json",
  "title": "OUF AuthorizationDecision v1",
  "type": "object",
  "required": [
    "decision",
    "reasonCode",
    "policyVersion",
    "bundleContentHash",
    "capabilityId"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "bundleContentHash": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "resourceScope": {
      "type": [
        "object",
        "null"
      ]
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Authorization & Access Control Specification v1.3"
  ],
  "x-ouf-scope-control": "Authorization contracts only; no IAM vendor binding, Gateway route model, THS approval DTO, Query Governor model or MCP Server change.",
  "x-ouf-note": "The PET freezes ALLOW/DENY + reasonCode + policyVersion and requires bundle checksum in decision/audit evidence. Obligations remain extensible because no exhaustive obligations DTO is frozen."
}
