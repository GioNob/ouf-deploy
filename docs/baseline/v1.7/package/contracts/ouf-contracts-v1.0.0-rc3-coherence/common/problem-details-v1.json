{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/common/problem-details-v1.json",
  "title": "OUF Problem Details v1",
  "description": "OUF HTTP Problem Details profile for boundary/backend error propagation.",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "code",
    "correlationId"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "instance": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasonCode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional compatibility alias for module-local decision reason; it does not replace the OUF application error code."
    },
    "retryable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "remediation": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "retryAfterSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "cross-module-reconciled-draft",
  "x-ouf-source-basis": [
    "Urban API Gateway v1.2 §14",
    "Cross-module error propagation rules"
  ],
  "x-ouf-note": "This draft correction replaces the earlier skeleton requirement for reasonCode with the Gateway-source-supported required field code."
}
