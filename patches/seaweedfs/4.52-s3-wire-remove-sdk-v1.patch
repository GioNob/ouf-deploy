diff --git a/weed/s3api/wire/types_test.go b/weed/s3api/wire/types_test.go
new file mode 100644
--- /dev/null
+++ b/weed/s3api/wire/types_test.go
@@ -0,0 +1,174 @@
+package wire
+
+import (
+	"bytes"
+	"encoding/json"
+	"encoding/xml"
+	"fmt"
+	"github.com/aws/aws-sdk-go/private/protocol/xml/xmlutil"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	legacy "github.com/aws/aws-sdk-go/service/s3"
+)
+
+func fillWireFixture(v reflect.Value) {
+	if v.Type() == reflect.TypeOf(time.Time{}) {
+		v.Set(reflect.ValueOf(time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)))
+		return
+	}
+	switch v.Kind() {
+	case reflect.Ptr:
+		v.Set(reflect.New(v.Type().Elem()))
+		fillWireFixture(v.Elem())
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Field(i).CanSet() {
+				fillWireFixture(v.Field(i))
+			}
+		}
+	case reflect.Slice:
+		v.Set(reflect.MakeSlice(v.Type(), 2, 2))
+		for i := 0; i < v.Len(); i++ {
+			fillWireFixture(v.Index(i))
+		}
+	case reflect.Map:
+		v.Set(reflect.MakeMap(v.Type()))
+		value := reflect.New(v.Type().Elem()).Elem()
+		fillWireFixture(value)
+		v.SetMapIndex(reflect.ValueOf("metadata-key"), value)
+	case reflect.String:
+		v.SetString("fixture<&\"")
+	case reflect.Bool:
+		v.SetBool(true)
+	case reflect.Int64:
+		v.SetInt(7)
+	}
+}
+
+func wirePairs() [][2]any {
+	return [][2]any{
+		{AbortMultipartUploadInput{}, legacy.AbortMultipartUploadInput{}},
+		{AbortMultipartUploadOutput{}, legacy.AbortMultipartUploadOutput{}},
+		{AccessControlPolicy{}, legacy.AccessControlPolicy{}},
+		{CompleteMultipartUploadInput{}, legacy.CompleteMultipartUploadInput{}},
+		{CompletedMultipartUpload{}, legacy.CompletedMultipartUpload{}},
+		{CompletedPart{}, legacy.CompletedPart{}},
+		{CreateMultipartUploadInput{}, legacy.CreateMultipartUploadInput{}},
+		{CreateMultipartUploadOutput{}, legacy.CreateMultipartUploadOutput{}},
+		{Grant{}, legacy.Grant{}},
+		{Grantee{}, legacy.Grantee{}},
+		{Initiator{}, legacy.Initiator{}},
+		{ListMultipartUploadsInput{}, legacy.ListMultipartUploadsInput{}},
+		{ListPartsInput{}, legacy.ListPartsInput{}},
+		{MultipartUpload{}, legacy.MultipartUpload{}},
+		{Owner{}, legacy.Owner{}},
+		{OwnershipControls{}, legacy.OwnershipControls{}},
+		{OwnershipControlsRule{}, legacy.OwnershipControlsRule{}},
+		{Part{}, legacy.Part{}},
+		{VersioningConfiguration{}, legacy.VersioningConfiguration{}},
+	}
+}
+
+// JSON is a persisted ACL format, so nil pointers, empty collections and order matter.
+func TestLegacyJSONCompatibility(t *testing.T) {
+	for _, pair := range wirePairs() {
+		t.Run(reflect.TypeOf(pair[0]).Name(), func(t *testing.T) {
+			for _, populated := range []bool{false, true} {
+				var data [2][]byte
+				for i, value := range pair {
+					fixture := reflect.New(reflect.TypeOf(value)).Elem()
+					if populated {
+						fillWireFixture(fixture)
+					}
+					var err error
+					data[i], err = json.Marshal(fixture.Interface())
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				if !bytes.Equal(data[0], data[1]) {
+					t.Fatalf("JSON differs populated=%v: %s / %s", populated, data[0], data[1])
+				}
+				local := reflect.New(reflect.TypeOf(pair[0])).Interface()
+				if err := json.Unmarshal(data[1], local); err != nil {
+					t.Fatal(err)
+				}
+				roundTrip, err := json.Marshal(local)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !bytes.Equal(roundTrip, data[1]) {
+					t.Fatal("persisted legacy JSON did not round trip")
+				}
+			}
+		})
+	}
+}
+
+// Compare the standard XML serializer actually used for multipart responses.
+func TestLegacyXMLCompatibility(t *testing.T) {
+	for _, pair := range wirePairs() {
+		name := reflect.TypeOf(pair[0]).Name()
+		if strings.HasSuffix(name, "Input") {
+			continue
+		}
+		t.Run(name, func(t *testing.T) {
+			for _, populated := range []bool{false, true} {
+				var data [2][]byte
+				for i, value := range pair {
+					fixture := reflect.New(reflect.TypeOf(value)).Elem()
+					if populated {
+						fillWireFixture(fixture)
+					}
+					var err error
+					data[i], err = xml.Marshal(fixture.Interface())
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				if !bytes.Equal(data[0], data[1]) {
+					t.Fatalf("XML differs populated=%v: %s / %s", populated, data[0], data[1])
+				}
+			}
+		})
+	}
+}
+
+// Keep the historical request parser and prove its attribute/list tags still work.
+func TestLegacyRequestParsing(t *testing.T) {
+	cases := []struct {
+		body       string
+		local, old any
+	}{
+		{`<AccessControlPolicy><Owner><ID>owner&amp;x</ID></Owner><AccessControlList><Grant><Grantee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="CanonicalUser"><ID>owner&amp;x</ID></Grantee><Permission>FULL_CONTROL</Permission></Grant><Grant><Grantee xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="Group"><URI>http://acs.amazonaws.com/groups/global/AllUsers</URI></Grantee><Permission>READ</Permission></Grant></AccessControlList></AccessControlPolicy>`, &AccessControlPolicy{}, &legacy.AccessControlPolicy{}},
+		{`<AccessControlPolicy><AccessControlList/></AccessControlPolicy>`, &AccessControlPolicy{}, &legacy.AccessControlPolicy{}},
+		{`<OwnershipControls><Rule><ObjectOwnership>BucketOwnerPreferred</ObjectOwnership></Rule><Rule><ObjectOwnership>ObjectWriter</ObjectOwnership></Rule></OwnershipControls>`, &OwnershipControls{}, &legacy.OwnershipControls{}},
+		{`<VersioningConfiguration><Status>Enabled</Status><MFADelete>Disabled</MFADelete></VersioningConfiguration>`, &VersioningConfiguration{}, &legacy.VersioningConfiguration{}},
+		{`<VersioningConfiguration><Status>Enable<Other/>d</Status></VersioningConfiguration>`, &VersioningConfiguration{}, &legacy.VersioningConfiguration{}},
+		{`<VersioningConfiguration><Status>Enabled</Status></VersioningConfiguration><VersioningConfiguration><Status>Suspended</Status></VersioningConfiguration>`, &VersioningConfiguration{}, &legacy.VersioningConfiguration{}},
+		{`<VersioningConfiguration><Status>Enabled</Status>`, &VersioningConfiguration{}, &legacy.VersioningConfiguration{}},
+	}
+	for n, tc := range cases {
+		t.Run(fmt.Sprint(n), func(t *testing.T) {
+			a := xmlutil.UnmarshalXML(tc.local, xml.NewDecoder(strings.NewReader(tc.body)), "")
+			b := xmlutil.UnmarshalXML(tc.old, xml.NewDecoder(strings.NewReader(tc.body)), "")
+			if fmt.Sprint(a) != fmt.Sprint(b) {
+				t.Fatalf("parser errors differ: %v / %v", a, b)
+			}
+			x, err := json.Marshal(tc.local)
+			if err != nil {
+				t.Fatal(err)
+			}
+			y, err := json.Marshal(tc.old)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(x, y) {
+				t.Fatalf("decoded values differ: %s / %s", x, y)
+			}
+		})
+	}
+}
