+			child, childErr := xmlToNode(decoder, &element)
+			out.findNamespaces()
+			if childErr != nil {
+				return out, childErr
+			}
+			child.name = typed.Name
+			child.findNamespaces()
+			parentCopy := *out
+			child.parent = &parentCopy
+			out.children[name] = append(out.children[name], child)
+		case xml.EndElement:
+			if start != nil && start.Name.Local == typed.Name.Local {
+				return out, nil
+			}
+			out = &xmlNode{}
+		}
+	}
+	return out, nil
+}
+
+func (node *xmlNode) findNamespaces() {
+	node.namespaces = map[string]string{}
+	for _, attr := range node.attr {
+		if attr.Name.Space == "xmlns" {
+			node.namespaces[attr.Value] = attr.Name.Local
+		}
+	}
+}
+
+func (node *xmlNode) findAttribute(name string) (string, bool) {
+	for current := node; current != nil; current = current.parent {
+		for _, attr := range current.attr {
+			namespace := attr.Name.Space
+			if prefix, ok := current.namespaces[namespace]; ok {
+				namespace = prefix
+			}
+			if name == fmt.Sprintf("%s:%s", namespace, attr.Name.Local) {
+				return attr.Value, true
+			}
+		}
+	}
+	return "", false
+}
+
+func parseXMLValue(value reflect.Value, node *xmlNode, tag reflect.StructTag) error {
+	if xmlTag := tag.Get("xml"); xmlTag != "" && strings.SplitAfterN(xmlTag, ",", 2)[0] == "-" {
+		return nil
+	}
+	valueType := value.Type()
+	if valueType.Kind() == reflect.Ptr {
+		valueType = valueType.Elem()
+	}
+	kind := tag.Get("type")
+	if kind == "" {
+		switch valueType.Kind() {
+		case reflect.Struct:
+			if _, ok := value.Interface().(*time.Time); !ok {
+				kind = "structure"
+			}
+		case reflect.Slice:
+			if _, ok := value.Interface().([]byte); !ok {
+				kind = "list"
+			}
+		case reflect.Map:
+			kind = "map"
+		}
+	}
+	switch kind {
+	case "structure":
+		if field, ok := valueType.FieldByName("_"); ok {
+			tag = field.Tag
+		}
+		return parseXMLStruct(value, node, tag)
+	case "list":
+		return parseXMLList(value, node, tag)
+	case "map":
+		return parseXMLMap(value, node, tag)
+	default:
+		return parseXMLScalar(value, node, tag)
+	}
+}
+
+func parseXMLStruct(value reflect.Value, node *xmlNode, tag reflect.StructTag) error {
+	valueType := value.Type()
+	if value.Kind() == reflect.Ptr {
+		if value.IsNil() {
+			value.Set(reflect.New(value.Type().Elem()))
+		}
+		value = value.Elem()
+		valueType = valueType.Elem()
+	}
+	if payload := tag.Get("payload"); payload != "" {
+		field, _ := valueType.FieldByName(payload)
+		return parseXMLStruct(value.FieldByName(payload), node, field.Tag)
+	}
+	for i := 0; i < valueType.NumField(); i++ {
+		field := valueType.Field(i)
+		if first := field.Name[0:1]; strings.ToLower(first) == first {
+			continue
+		}
+		name := field.Name
+		if field.Tag.Get("flattened") != "" && field.Tag.Get("locationNameList") != "" {
+			name = field.Tag.Get("locationNameList")
+		} else if location := field.Tag.Get("locationName"); location != "" {
+			name = location
+		}
+		elements := node.children[name]
+		if elements == nil {
+			if attribute, ok := node.findAttribute(name); ok {
+				elements = []*xmlNode{{text: attribute}}
+			}
+		}
+		member := value.FieldByName(field.Name)
+		for _, element := range elements {
+			if err := parseXMLValue(member, element, field.Tag); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func parseXMLList(value reflect.Value, node *xmlNode, tag reflect.StructTag) error {
+	valueType := value.Type()
+	if tag.Get("flattened") == "" {
+		memberName := "member"
+		if name := tag.Get("locationNameList"); name != "" {
+			memberName = name
+		}
+		children := node.children[memberName]
+		if children != nil {
+			if value.IsNil() {
+				value.Set(reflect.MakeSlice(valueType, len(children), len(children)))
+			}
+			for i, child := range children {
+				if err := parseXMLValue(value.Index(i), child, ""); err != nil {
+					return err
+				}
+			}
+		}
+		return nil
+	}
+	if value.IsNil() {
+		value.Set(reflect.MakeSlice(valueType, 0, 0))
+	}
+	value.Set(reflect.Append(value, reflect.Zero(valueType.Elem())))
+	return parseXMLValue(value.Index(value.Len()-1), node, "")
+}
+
+func parseXMLMap(value reflect.Value, node *xmlNode, tag reflect.StructTag) error {
+	if value.IsNil() {
+		value.Set(reflect.MakeMap(value.Type()))
+	}
+	if tag.Get("flattened") == "" {
+		for _, entry := range node.children["entry"] {
+			if err := parseXMLMapEntry(value, entry, tag); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	return parseXMLMapEntry(value, node, tag)
+}
+
+func parseXMLMapEntry(value reflect.Value, node *xmlNode, tag reflect.StructTag) error {
+	keyName, valueName := "key", "value"
+	if name := tag.Get("locationNameKey"); name != "" {
+		keyName = name
+	}
+	if name := tag.Get("locationNameValue"); name != "" {
+		valueName = name
+	}
+	keys := node.children[keyName]
+	values := node.children[valueName]
+	for i, key := range keys {
+		if i >= len(values) {
+			return fmt.Errorf("map value missing for key %q", key.text)
+		}
+		decoded := reflect.New(value.Type().Elem()).Elem()
+		if err := parseXMLValue(decoded, values[i], ""); err != nil {
+			return err
+		}
+		value.SetMapIndex(reflect.ValueOf(key.text), decoded)
+	}
+	return nil
+}
+
+func parseXMLScalar(value reflect.Value, node *xmlNode, tag reflect.StructTag) error {
+	switch value.Interface().(type) {
+	case *string:
+		value.Set(reflect.ValueOf(new(node.text)))
+	case []byte:
+		decoded, err := base64.StdEncoding.DecodeString(node.text)
+		if err != nil {
+			return err
+		}
+		value.Set(reflect.ValueOf(decoded))
+	case *bool:
+		decoded, err := strconv.ParseBool(node.text)
+		if err != nil {
+			return err
+		}
+		value.Set(reflect.ValueOf(new(decoded)))
+	case *int64:
+		decoded, err := strconv.ParseInt(node.text, 10, 64)
+		if err != nil {
+			return err
+		}
+		value.Set(reflect.ValueOf(new(decoded)))
+	case *float64:
+		var decoded float64
+		var err error
+		switch {
+		case strings.EqualFold(node.text, "NaN"):
+			decoded = math.NaN()
+		case strings.EqualFold(node.text, "Infinity"):
+			decoded = math.Inf(1)
+		case strings.EqualFold(node.text, "-Infinity"):
+			decoded = math.Inf(-1)
+		default:
+			decoded, err = strconv.ParseFloat(node.text, 64)
+		}
+		if err != nil {
+			return err
+		}
+		value.Set(reflect.ValueOf(new(decoded)))
+	case *time.Time:
+		decoded, err := parseXMLTime(tag.Get("timestampFormat"), node.text)
+		if err != nil {
+			return err
+		}
+		value.Set(reflect.ValueOf(new(decoded)))
+	default:
+		return fmt.Errorf("unsupported XML value: %v (%s)", value.Interface(), value.Type())
+	}
+	return nil
+}
+
+func parseXMLTime(format, text string) (time.Time, error) {
+	switch format {
+	case "unixTimestamp":
+		seconds, err := strconv.ParseFloat(text, 64)
+		if err != nil {
+			return time.Time{}, err
+		}
+		whole, fraction := math.Modf(seconds)
+		return time.Unix(int64(whole), int64(fraction*float64(time.Second))).UTC(), nil
+	case "rfc822":
+		for _, layout := range []string{time.RFC1123, time.RFC1123Z, time.RFC822, time.RFC822Z} {
+			if parsed, err := time.Parse(layout, text); err == nil {
+				return parsed, nil
+			}
+		}
+		return time.Time{}, fmt.Errorf("invalid RFC822 timestamp %q", text)
+	default:
+		return time.Parse(time.RFC3339Nano, text)
+	}
+}
