+func TestKMSSDKWireEnvelopeAndAliases(t *testing.T) {
+	calls := 0
+	plain := bytes.Repeat([]byte{42}, 32)
+	cipher := []byte("encrypted-fixture")
+	encCtx := map[string]string{"aws:s3:arn": "arn:aws:s3:::fixture/key"}
+	p := sdkFixture(t, func(r *http.Request) (*http.Response, error) {
+		calls++
+		if !strings.Contains(r.Header.Get("Authorization"), "Credential=fixture-id/") || !strings.Contains(r.Header.Get("Authorization"), "/us-east-1/kms/aws4_request") || r.Header.Get("X-Amz-Security-Token") != "fixture-session" {
+			t.Fatal("SigV4 or session binding lost")
+		}
+		var body struct {
+			KeyId, KeySpec    string
+			CiphertextBlob    []byte
+			EncryptionContext map[string]string
+		}
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatal(err)
+		}
+		switch r.Header.Get("X-Amz-Target") {
+		case "TrentService.GenerateDataKey":
+			if body.KeyId != "alias/fixture" || body.KeySpec != "AES_256" || !reflect.DeepEqual(body.EncryptionContext, encCtx) {
+				t.Fatal("generate request changed")
+			}
+			return response(200, fmt.Sprintf(`{"KeyId":"resolved-key","Plaintext":%q,"CiphertextBlob":%q}`, base64.StdEncoding.EncodeToString(plain), base64.StdEncoding.EncodeToString(cipher))), nil
+		case "TrentService.Decrypt":
+			if !bytes.Equal(body.CiphertextBlob, cipher) || !reflect.DeepEqual(body.EncryptionContext, encCtx) {
+				t.Fatal("decrypt context/ciphertext changed")
+			}
+			return response(200, fmt.Sprintf(`{"KeyId":"resolved-key","Plaintext":%q}`, base64.StdEncoding.EncodeToString(plain))), nil
+		case "TrentService.DescribeKey":
+			if body.KeyId != "alias/fixture" {
+				t.Fatal("alias changed")
+			}
+			return response(200, `{"KeyMetadata":{"KeyId":"resolved-key","Arn":"arn:fixture","Description":"fixture","KeyUsage":"ENCRYPT_DECRYPT","KeyState":"Enabled","Origin":"AWS_KMS"}}`), nil
+		default:
+			t.Fatal("unexpected operation")
+			return nil, nil
+		}
+	})
+	ctx := context.Background()
+	generated, err := p.GenerateDataKey(ctx, &seaweedkms.GenerateDataKeyRequest{KeyID: "alias/fixture", KeySpec: seaweedkms.KeySpecAES256, EncryptionContext: encCtx})
+	if err != nil {
+		t.Fatal(err)
+	}
+	expected, err := seaweedkms.CreateEnvelope("aws", "resolved-key", base64.StdEncoding.EncodeToString(cipher), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(generated.CiphertextBlob, expected) || !bytes.Equal(generated.Plaintext, plain) || generated.KeyID != "resolved-key" {
+		t.Fatal("stored envelope or key changed")
+	}
+	decrypted, err := p.Decrypt(ctx, &seaweedkms.DecryptRequest{CiphertextBlob: expected, EncryptionContext: encCtx})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(decrypted.Plaintext, plain) || decrypted.KeyID != "resolved-key" {
+		t.Fatal("decrypt result changed")
+	}
+	desc, err := p.DescribeKey(ctx, &seaweedkms.DescribeKeyRequest{KeyID: "alias/fixture"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if desc.KeyID != "resolved-key" || desc.ARN != "arn:fixture" || desc.Description != "fixture" || desc.KeyUsage != seaweedkms.KeyUsageEncryptDecrypt || desc.KeyState != seaweedkms.KeyStateEnabled || desc.Origin != seaweedkms.KeyOriginAWS {
+		t.Fatal("metadata changed")
+	}
+	id, err := p.GetKeyID(ctx, "alias/fixture")
+	if err != nil || id != "resolved-key" {
+		t.Fatal("alias resolution failed")
+	}
+	if calls != 4 {
+		t.Fatalf("calls=%d", calls)
+	}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
