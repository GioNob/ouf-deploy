+
+type httpFunc func(*http.Request) (*http.Response, error)
+
+func (f httpFunc) Do(r *http.Request) (*http.Response, error) { return f(r) }
+
+func isolateCredentials(t *testing.T) {
+	t.Helper()
+	for _, key := range []string{"AWS_PROFILE", "AWS_DEFAULT_PROFILE", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN", "AWS_ENDPOINT_URL", "AWS_ENDPOINT_URL_S3", "AWS_CONTAINER_CREDENTIALS_FULL_URI", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI", "AWS_S3_USE_ARN_REGION", "AWS_S3_DISABLE_MULTIREGION_ACCESS_POINTS"} {
+		t.Setenv(key, "")
+	}
+	t.Setenv("AWS_EC2_METADATA_DISABLED", "true")
+	path := filepath.Join(t.TempDir(), "empty")
+	if err := os.WriteFile(path, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("AWS_CONFIG_FILE", path)
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", path)
+}
+
+func TestS3ClientBindings(t *testing.T) {
+	isolateCredentials(t)
+	t.Setenv("AWS_ACCESS_KEY_ID", "env-id")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "env-secret")
+	for _, explicit := range []bool{true, false} {
+		t.Run(fmt.Sprint(explicit), func(t *testing.T) {
+			id, secret, want := "static-id", "static-secret", "static-id"
+			if !explicit {
+				id = ""
+				secret = ""
+				want = "env-id"
+			}
+			c, err := newClient(id, secret, "us-east-1", "https://fixture.invalid", true)
+			if err != nil {
+				t.Fatal(err)
+			}
+			o := c.Options()
+			cred, err := o.Credentials.Retrieve(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if cred.AccessKeyID != want || o.RetryMaxAttempts != 1 || !o.UsePathStyle || aws.ToString(o.BaseEndpoint) != "https://fixture.invalid" {
+				t.Fatal("identity, endpoint or retry drift")
+			}
+			tr, ok := o.HTTPClient.(*awshttp.BuildableClient)
+			if !ok || tr.GetTimeout() != 30*time.Second {
+				t.Fatal("timeout lost")
+			}
+		})
+	}
+	for _, tc := range []struct{ id, secret, region, endpoint string }{
+		{"partial", "", "us-east-1", ""}, {"", "partial", "us-east-1", ""}, {"id", "secret", "", ""},
+		{"id", "secret", "us-east-1", "file:///fixture"}, {"id", "secret", "us-east-1", "https://user:secret@fixture.invalid"},
+		{"id", "secret", "us-east-1", "https://fixture.invalid?secret=value"},
+	} {
+		if _, err := newClient(tc.id, tc.secret, tc.region, tc.endpoint, true); err == nil {
+			t.Fatal("invalid binding accepted")
+		}
+	}
+	for _, key := range []string{"AWS_ENDPOINT_URL", "AWS_ENDPOINT_URL_S3"} {
+		t.Run(key, func(t *testing.T) {
+			t.Setenv(key, "https://unexpected.invalid")
+			if _, err := newClient("id", "secret", "us-east-1", "", true); err == nil {
+				t.Fatal("implicit endpoint accepted")
+			}
+			c, err := newClient("id", "secret", "us-east-1", "https://explicit.invalid", true)
+			if err != nil || aws.ToString(c.Options().BaseEndpoint) != "https://explicit.invalid" {
+				t.Fatal("explicit endpoint lost")
+			}
+		})
+	}
+}
+
+func TestS3SinkRejectsChecksumDowngrade(t *testing.T) {
+	isolateCredentials(t)
+	c := viper.New()
+	c.Set("region", "us-east-1")
+	c.Set("s3_disable_content_md5_validation", true)
+	s := &S3Sink{}
+	if err := s.Initialize(util.NewViperProxy(c), ""); err == nil {
+		t.Fatal("checksum downgrade silently accepted")
+	}
+}
