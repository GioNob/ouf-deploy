{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/authorization/resource-context-v1.json",
  "title": "OUF ResourceContext v1",
  "description": "Typed, bounded resource attributes supplied by the resource-owning service to local authorization evaluation.",
  "type": "object",
  "required": [
    "resourceType"
  ],
  "properties": {
    "resourceType": {
      "type": "string",
      "minLength": 1
    },
    "resourceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownerOrgRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "domainRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "objectType": {
      "type": [
        "string",
        "null"
      ]
    },
    "propertyRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "geometryRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "relationType": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineageClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifactClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "historyClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "resultScopeRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "resultSizeClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataAccessLabels": {
      "type": "array",
      "items": {
        "$ref": "../common/data-access-label-v1.json"
      },
      "uniqueItems": true
    },
    "authorityProvenanceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Authorization & Access Control Specification v1.3"
  ],
  "x-ouf-scope-control": "Authorization contracts only; no IAM vendor binding, Gateway route model, THS approval DTO, Query Governor model or MCP Server change.",
  "x-ouf-note": "The PET defines resourceContext semantically and enumerates minimum contexts for object/property/geometry/relationship/lineage/raw/history/export; it does not freeze one universal exhaustive resource DTO."
}
