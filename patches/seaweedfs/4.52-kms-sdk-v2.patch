+func TestKMSSDKErrorMappingAndNoHiddenRetry(t *testing.T) {
+	for _, tc := range []struct{ code, want string }{
+		{"NotFoundException", seaweedkms.ErrCodeNotFoundException}, {"DisabledException", seaweedkms.ErrCodeKeyUnavailable},
+		{"KeyUnavailableException", seaweedkms.ErrCodeKeyUnavailable}, {"AccessDeniedException", seaweedkms.ErrCodeAccessDenied},
+		{"InvalidKeyUsageException", seaweedkms.ErrCodeInvalidKeyUsage}, {"InvalidCiphertextException", seaweedkms.ErrCodeInvalidCiphertext},
+		{"KMSInternalException", seaweedkms.ErrCodeKMSInternalFailure}, {"KMSInvalidStateException", seaweedkms.ErrCodeKMSInternalFailure},
+		{"UnexpectedFailure", seaweedkms.ErrCodeKMSInternalFailure},
+	} {
+		t.Run(tc.code, func(t *testing.T) {
+			calls := 0
+			p := sdkFixture(t, func(r *http.Request) (*http.Response, error) {
+				calls++
+				return response(500, fmt.Sprintf(`{"__type":%q,"message":"fixture error"}`, tc.code)), nil
+			})
+			_, err := p.GenerateDataKey(context.Background(), &seaweedkms.GenerateDataKeyRequest{KeyID: "alias/fixture", KeySpec: seaweedkms.KeySpecAES256})
+			var mapped *seaweedkms.KMSError
+			if !errors.As(err, &mapped) || mapped.Code != tc.want || mapped.KeyID != "alias/fixture" || !strings.Contains(mapped.Message, "fixture error") || calls != 1 {
+				t.Fatalf("mapping/retry mismatch: %v calls=%d", err, calls)
+			}
+		})
+	}
+}
