[Unit]
Description=OUF hash-pinned trust window inventory

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/ouf/operational-signals/trust-windows.env
ExecStart=/usr/bin/python3 -I -B /opt/ouf-deploy/scripts/trust-window-status.py --inventory ${TRUST_INVENTORY} --inventory-sha256 ${TRUST_INVENTORY_SHA256} --status-path /var/lib/ouf-trust-windows/status.json
StateDirectory=ouf-trust-windows
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/ouf-trust-windows
ReadOnlyPaths=/opt/ouf-deploy /etc/ouf
RestrictAddressFamilies=AF_UNIX

