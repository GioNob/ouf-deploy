diff --git a/test/s3/policy/bucket_policy_sdk_v2_test.go b/test/s3/policy/bucket_policy_sdk_v2_test.go
new file mode 100644
--- /dev/null
+++ b/test/s3/policy/bucket_policy_sdk_v2_test.go
@@ -0,0 +1,115 @@
+package policy
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/smithy-go"
+	"github.com/stretchr/testify/require"
+)
+
+type policyRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f policyRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestBucketPolicySDKV2Configuration(t *testing.T) {
+	client := newS3ClientForCluster(t, &TestCluster{s3Endpoint: "http://127.0.0.1:8333"})
+	opts := client.Options()
+	require.Equal(t, "us-east-1", opts.Region)
+	require.Equal(t, "http://127.0.0.1:8333", aws.ToString(opts.BaseEndpoint))
+	require.True(t, opts.UsePathStyle)
+	require.Equal(t, 1, opts.RetryMaxAttempts)
+	httpClient, ok := opts.HTTPClient.(*http.Client)
+	require.True(t, ok)
+	require.Equal(t, 30*time.Second, httpClient.Timeout)
+	creds, err := opts.Credentials.Retrieve(t.Context())
+	require.NoError(t, err)
+	require.Equal(t, "admin", creds.AccessKeyID)
+	require.Equal(t, "admin", creds.SecretAccessKey)
+}
+
+// This transport fixture checks SDK request/response semantics, not a live
+// SeaweedFS policy evaluation or authorization boundary.
+func TestBucketPolicySDKV2RoundTrip(t *testing.T) {
+	client := newS3ClientForCluster(t, &TestCluster{s3Endpoint: "http://127.0.0.1:8333"})
+	const policy = `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":"*","Action":"s3:GetObject","Resource":"arn:aws:s3:::fixture/*"}]}`
+	stored := ""
+	var methods []string
+	transport := policyRoundTripper(func(req *http.Request) (*http.Response, error) {
+		require.Equal(t, "127.0.0.1:8333", req.URL.Host)
+		require.Equal(t, "/fixture", req.URL.Path)
+		require.True(t, req.URL.Query().Has("policy"))
+		require.Contains(t, req.Header.Get("Authorization"), "Credential=admin/")
+		require.Contains(t, req.Header.Get("Authorization"), "/us-east-1/s3/aws4_request")
+		methods = append(methods, req.Method)
+		status, body, contentType := 200, "", "application/json"
+		switch req.Method {
+		case http.MethodPut:
+			data, err := io.ReadAll(req.Body)
+			require.NoError(t, err)
+			require.Equal(t, policy, string(data))
+			stored = string(data)
+		case http.MethodGet:
+			body = stored
+			if stored == "" {
+				status, contentType = 404, "application/xml"
+				body = `<Error><Code>NoSuchBucketPolicy</Code><Message>no policy</Message></Error>`
+			}
+		case http.MethodDelete:
+			stored, status = "", 204
+		default:
+			t.Fatalf("unexpected method: %s", req.Method)
+		}
+		return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": {contentType}}, Body: io.NopCloser(strings.NewReader(body)), Request: req}, nil
+	})
+	option := func(o *s3.Options) { o.HTTPClient = &http.Client{Transport: transport, Timeout: 30 * time.Second} }
+	for i := 0; i < 2; i++ {
+		_, err := client.PutBucketPolicy(t.Context(), &s3.PutBucketPolicyInput{Bucket: aws.String("fixture"), Policy: aws.String(policy)}, option)
+		require.NoError(t, err)
+		out, err := client.GetBucketPolicy(t.Context(), &s3.GetBucketPolicyInput{Bucket: aws.String("fixture")}, option)
+		require.NoError(t, err)
+		require.Equal(t, policy, aws.ToString(out.Policy))
+	}
+	_, err := client.DeleteBucketPolicy(t.Context(), &s3.DeleteBucketPolicyInput{Bucket: aws.String("fixture")}, option)
+	require.NoError(t, err)
+	_, err = client.GetBucketPolicy(t.Context(), &s3.GetBucketPolicyInput{Bucket: aws.String("fixture")}, option)
+	var apiError smithy.APIError
+	require.True(t, errors.As(err, &apiError))
+	require.Equal(t, "NoSuchBucketPolicy", apiError.ErrorCode())
+	require.Equal(t, []string{"PUT", "GET", "PUT", "GET", "DELETE", "GET"}, methods)
+}
+
+func TestBucketPolicySDKV2SingleAttempt(t *testing.T) {
+	client := newS3ClientForCluster(t, &TestCluster{s3Endpoint: "http://127.0.0.1:8333"})
+	attempts := 0
+	_, err := client.PutBucketPolicy(t.Context(), &s3.PutBucketPolicyInput{Bucket: aws.String("fixture"), Policy: aws.String(`{}`)}, func(o *s3.Options) {
+		o.HTTPClient = &http.Client{Transport: policyRoundTripper(func(req *http.Request) (*http.Response, error) {
+			attempts++
+			return &http.Response{StatusCode: 503, Header: http.Header{"Content-Type": {"application/xml"}}, Body: io.NopCloser(strings.NewReader(`<Error><Code>ServiceUnavailable</Code><Message>fixture</Message></Error>`)), Request: req}, nil
+		}), Timeout: 30 * time.Second}
+	})
+	require.Error(t, err)
+	require.Equal(t, 1, attempts)
+}
+
+func TestBucketPolicySDKV2Cancellation(t *testing.T) {
+	client := newS3ClientForCluster(t, &TestCluster{s3Endpoint: "http://127.0.0.1:8333"})
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	attempts := 0
+	_, err := client.GetBucketPolicy(ctx, &s3.GetBucketPolicyInput{Bucket: aws.String("fixture")}, func(o *s3.Options) {
+		o.HTTPClient = &http.Client{Transport: policyRoundTripper(func(req *http.Request) (*http.Response, error) {
+			attempts++
+			return nil, errors.New("unexpected request after cancellation")
+		}), Timeout: 30 * time.Second}
+	})
+	require.ErrorIs(t, err, context.Canceled)
+	require.Zero(t, attempts)
+}
