{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "levels",
    "governedElsewhere",
    "docker",
    "dockerSocket",
    "stopTimeoutSeconds",
    "inventoryTimeoutSeconds",
    "receipts",
    "incidents",
    "bootRetryDelaysSeconds"
  ],
  "properties": {
    "schema": {
      "const": "ouf.platform-restart-profile.v1"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeoutSeconds",
          "containers"
        ],
        "properties": {
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "containers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "containerName",
                "readiness"
              ],
              "properties": {
                "containerName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                  "allOf": [
                    {
                      "not": {
                        "pattern": "[Rr][Ee][Tt][Aa][Ii][Nn][Ee][Dd]|[Rr][Ee][Tt][Ii][Rr][Ee][Dd]|[Bb][Ee][Ff][Oo][Rr][Ee]-"
                      }
                    }
                  ]
                },
                "readiness": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "stableSeconds"
                      ],
                      "properties": {
                        "type": {
                          "const": "running"
                        },
                        "stableSeconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "healthy"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "network",
                        "port",
                        "timeoutSeconds"
                      ],
                      "properties": {
                        "type": {
                          "const": "tcp"
                        },
                        "network": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "timeoutSeconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "address",
                        "port",
                        "path",
                        "timeoutSeconds",
                        "budgetSeconds",
                        "acceptStatus"
                      ],
                      "properties": {
                        "type": {
                          "const": "actuator"
                        },
                        "address": {
                          "type": "string",
                          "format": "ipv4",
                          "pattern": "^127\\."
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "path": {
                          "type": "string",
                          "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
                        },
                        "timeoutSeconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400
                        },
                        "budgetSeconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400
                        },
                        "acceptStatus": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "type": "integer",
                            "minimum": 100,
                            "maximum": 599
                          }
                        },
                        "jsonStatus": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "gate": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entrypoint"
                  ],
                  "properties": {
                    "imageId": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "entrypoint": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "prefixItems": [
                        {
                          "allOf": [
                            {
                              "type": "string",
                              "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
                            },
                            {
                              "pattern": "/sh$"
                            }
                          ]
                        },
                        {
                          "const": "-c"
                        },
                        {
                          "const": "OUF_APPLICATION_GATE=0; trap \"OUF_APPLICATION_GATE=1\" USR1; while [ \"$OUF_APPLICATION_GATE\" = 0 ]; do sleep 1 & wait \"$!\"; done; exec \"$@\""
                        },
                        {
                          "const": "ouf-gated-application"
                        }
                      ]
                    },
                    "command": {
                      "type": "array",
                      "minItems": 1,
                      "prefixItems": [
                        {
                          "type": "string",
                          "anyOf": [
                            {
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                            },
                            {
                              "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
                            }
                          ]
                        }
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^\\u0000]+$"
                      }
                    },
                    "identity": {
                      "description": "Executor installation and module journal in root custody. The public key is the DER SPKI bound by the executor.",
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "source": {
                              "const": "module-release"
                            },
                            "executorRoot": {
                              "$ref": "#/properties/receipts"
                            },
                            "journalRoot": {
                              "$ref": "#/properties/receipts"
                            },
                            "module": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                            },
                            "receiptSigning": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "publicKey": {
                                  "$ref": "#/properties/docker"
                                },
                                "openssl": {
                                  "$ref": "#/properties/docker"
                                }
                              },
                              "required": [
                                "publicKey",
                                "openssl"
                              ]
                            }
                          },
                          "required": [
                            "source",
                            "executorRoot",
                            "journalRoot",
                            "module"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "source": {
                              "const": "semantic-a2"
                            },
                            "executorRoot": {
                              "$ref": "#/properties/receipts"
                            }
                          },
                          "required": [
                            "source",
                            "executorRoot"
                          ]
                        }
                      ]
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "imageId",
                        "command"
                      ],
                      "not": {
                        "required": [
                          "identity"
                        ]
                      }
                    },
                    {
                      "required": [
                        "identity"
                      ],
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "imageId"
                            ]
                          },
                          {
                            "required": [
                              "command"
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              "if": {
                "properties": {
                  "readiness": {
                    "properties": {
                      "type": {
                        "const": "actuator"
                      }
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "gate"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "gate"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "governedElsewhere": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dockerSocket": {
      "type": "string",
      "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
    },
    "stopTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "inventoryTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "receipts": {
      "type": "string",
      "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
    },
    "incidents": {
      "type": "string",
      "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
    },
    "bootRetryDelaysSeconds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      },
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
