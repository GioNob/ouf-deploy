{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/gateway/capability-manifest-v1.json",
  "title": "OUF Capability Manifest v1",
  "description": "Product-independent, versioned capability descriptor linked to service/API contracts and technical bindings.",
  "type": "object",
  "required": [
    "capabilityId",
    "version",
    "owner",
    "operationType",
    "riskLevel",
    "input",
    "output",
    "authorization",
    "bindings",
    "mcp"
  ],
  "properties": {
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "operationType": {
      "type": "string",
      "enum": [
        "read",
        "compute",
        "propose",
        "command"
      ]
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "schemaRef": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "schemaRef": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "authorization": {
      "type": "object",
      "required": [
        "coarseScope"
      ],
      "properties": {
        "coarseScope": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "backendCapabilityId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "bindings": {
      "type": "object",
      "properties": {
        "rest": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "method",
            "path"
          ],
          "additionalProperties": true
        },
        "ogc": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "collection": {
              "type": [
                "string",
                "null"
              ]
            },
            "featureType": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "mcp": {
      "type": "object",
      "required": [
        "toolEligible"
      ],
      "properties": {
        "toolEligible": {
          "type": "boolean"
        },
        "toolName": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "useWhen": {
          "type": [
            "string",
            "null"
          ]
        },
        "doNotUseWhen": {
          "type": [
            "string",
            "null"
          ]
        },
        "preferredAlternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operationalLimits": {
          "type": [
            "object",
            "null"
          ]
        },
        "resultSemantics": {
          "type": [
            "object",
            "string",
            "null"
          ]
        },
        "securityNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "dataClassification": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Urban API Gateway v1.2"
  ],
  "x-ouf-scope-control": "Gateway boundary/runtime contracts only. No Query Complexity Governor, fine-grained data authorization, Durable ACK authority, schema-drift classification, ETL, semantic processing, Object Resolution, UDP materialization, THS decision logic or MCP Server implementation.",
  "x-ouf-invariants": [
    "toolEligible=true allows exposure consideration but never grants authorization",
    "capability and technical binding remain distinct",
    "every consumer-facing endpoint must resolve to one registered capability",
    "coarse scope does not replace backend fine-grained authorization"
  ]
}
