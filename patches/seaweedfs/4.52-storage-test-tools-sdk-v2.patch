index 000000000..ba401684b
--- /dev/null
+++ b/unmaintained/s3/presigned_put/presigned_put_test.go
@@ -0,0 +1,41 @@
+package main
+
+import (
+	"io"
+	"net/http"
+	"testing"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/credentials"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+)
+
+func TestPresignedPutRequest(t *testing.T) {
+	client := s3.New(s3.Options{
+		Region:       "us-east-1",
+		BaseEndpoint: aws.String("http://localhost:8333"),
+		UsePathStyle: true,
+		Credentials:  credentials.NewStaticCredentialsProvider("fixture", "fixture-secret", ""),
+	})
+	req, err := presignedPutRequest(t.Context(), s3.NewPresignClient(client), "dev", "key with space", "abc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer req.Body.Close()
+	if req.Method != http.MethodPut || req.URL.Host != "localhost:8333" ||
+		req.Host != "localhost:8333" || req.URL.EscapedPath() != "/dev/key%20with%20space" {
+		t.Fatal("PUT endpoint, signed host or object path changed")
+	}
+	query := req.URL.Query()
+	if query.Get("X-Amz-SignedHeaders") != "content-md5;host" ||
+		query.Get("X-Amz-Expires") != "900" || query.Get("X-Amz-Signature") == "" {
+		t.Fatal("missing signed headers, expiry or signature")
+	}
+	if got := req.Header.Get("Content-MD5"); got != "kAFQmDzST7DWlj99KOF/cg==" {
+		t.Fatalf("Content-MD5 = %q", got)
+	}
+	body, err := io.ReadAll(req.Body)
+	if err != nil || string(body) != "abc" {
+		t.Fatalf("unexpected request body: %q, %v", body, err)
+	}
+}
