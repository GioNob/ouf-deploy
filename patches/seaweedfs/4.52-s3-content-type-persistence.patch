+func TestS3ContentTypeSurvivesFilerPersistence(t *testing.T) {
+	for _, tc := range []struct {
+		name, key, contentType, want string
+		body                         []byte
+	}{
+		{"explicit octet-stream overrides txt extension", "binary.txt", "application/octet-stream", "application/octet-stream", []byte("plain looking bytes\n")},
+		{"explicit octet-stream overrides json extension", "binary.json", "application/octet-stream", "application/octet-stream", []byte("{\"fixture\":true}")},
+		{"empty object retains explicit type", "empty.txt", "application/octet-stream", "application/octet-stream", nil},
+		{"custom explicit type retained", "custom.txt", "application/x-ouf-fixture", "application/x-ouf-fixture", []byte("fixture\n")},
+		{"missing type still detected", "inferred.bin", "", "text/plain; charset=utf-8", []byte("plain text fixture\n")},
+		{"missing type empty object keeps PUT default", "empty-default.txt", "", "application/octet-stream", nil},
+		{"missing type binary body keeps detected type", "binary-default.txt", "", "application/octet-stream", []byte{0, 1, 2, 3, 255}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			volume := startContentTypeVolume(t)
+			backend := &ambiguousPutFiler{volume: volume, apply: true, entries: map[string]*filer_pb.Entry{}}
+			store := &contentTypeStore{backend: backend}
+			persistence := &contentTypeFiler{ambiguousPutFiler: backend, wrapper: filer.NewFilerStoreWrapper(store)}
+			address := startFakeFiler(t, persistence)
+			s3a := newPutTestServer(t, address)
+			s3a.readerCache = filer.NewReaderCache(2, (*chunk_cache.TieredChunkCache)(nil), s3a.filerClient.GetLookupFileIdFunction(), s3a.filerClient)
+			s3a.iam = NewIdentityAccessManagementWithStore(s3a.option, nil, "memory")
+			t.Cleanup(s3a.iam.Shutdown)
+			bucketEntry := &filer_pb.Entry{Name: "b", IsDirectory: true, Attributes: &filer_pb.FuseAttributes{}, Extended: map[string][]byte{s3_constants.ExtAmzOwnerKey: []byte(AccountAdmin.Id)}}
+			backend.entries["/buckets/b"] = bucketEntry
+			s3a.bucketConfigCache = NewBucketConfigCache(time.Minute)
+			s3a.bucketConfigCache.Set("b", &BucketConfig{Name: "b", Owner: AccountAdmin.Id})
+			s3a.bucketRegistry = NewBucketRegistry(s3a)
+			s3a.bucketRegistry.LoadBucketMetadata(bucketEntry)
+			ctx, cancel := context.WithTimeout(t.Context(), 10*time.Second)
+			defer cancel()
+			request := func(method string) *http.Request {
+				r := httptest.NewRequest(method, "/b/"+tc.key, bytes.NewReader(tc.body)).WithContext(ctx)
+				return mux.SetURLVars(r, map[string]string{"bucket": "b", "object": tc.key})
+			}
+			put := request(http.MethodPut)
+			if tc.contentType != "" {
+				put.Header.Set("Content-Type", tc.contentType)
+			}
+			output := httptest.NewRecorder()
+			s3a.PutObjectHandler(output, put)
+			require.Equal(t, http.StatusOK, output.Code, output.Body.String())
+			stored, err := store.FindEntry(ctx, util.FullPath("/buckets/b/"+tc.key))
+			require.NoError(t, err)
+			require.Equal(t, tc.want, stored.Mime, "persisted MIME must survive a fresh protobuf decode")
+			require.NotEmpty(t, stored.Extended[s3_constants.ExtETagKey], "actual PUT stamps S3 object metadata")
+			for _, method := range []string{http.MethodGet, http.MethodHead} {
+				response := httptest.NewRecorder()
+				if method == http.MethodGet {
+					s3a.GetObjectHandler(response, request(method))
+				} else {
+					s3a.HeadObjectHandler(response, request(method))
+				}
+				require.Equal(t, http.StatusOK, response.Code, response.Body.String())
+				require.Equal(t, tc.want, response.Header().Get("Content-Type"), method)
+				if method == http.MethodGet {
+					require.Equal(t, string(tc.body), response.Body.String())
+				}
+			}
+		})
+	}
+}
