+func TestOUFGoogleProfileCacheNeverBuilds(t *testing.T) {
+	conf := &remote_pb.RemoteConf{Type: "gcs", Name: "excluded", GcsGoogleApplicationCredentials: "/must-not-read"}
+	c, e := GetRemoteStorage(conf)
+	if c != nil || !errors.Is(e, googleprofile.ErrUnsupported) {
