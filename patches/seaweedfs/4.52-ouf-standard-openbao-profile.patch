+// Exercise the actual file loader used by startup and reload, plus the byte
+// loader used by live IAM updates. No LDAP, KMS server, Docker, or network runs.
+func TestOUFStandardKMSDeniedBeforeFileAndBytePublication(t *testing.T) {
+	for _, mode := range []string{"file-first-load", "file-reload", "bytes-reload"} {
+		for _, excluded := range []string{"openbao", "vault"} {
+			t.Run(mode+"/"+excluded, func(t *testing.T) {
+				s3a := newTestS3ApiServerWithMemoryIAM(t, []*iam_pb.Identity{})
+				if mode != "file-first-load" {
+					path := writeTempIamConfig(t, `{"identities":[{"name":"retained","credentials":[{"accessKey":"KEPTKEY","secretKey":"kept-secret"}],"actions":["Read:fixture/*"]}]}`)
+					if err := s3a.iam.loadS3ApiConfigurationFromFile(path); err != nil {
+						t.Fatal(err)
+					}
+				}
+				beforeConfig, err := s3a.iam.credentialManager.LoadConfiguration(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				beforeBytes, err := json.Marshal(beforeConfig)
+				if err != nil {
+					t.Fatal(err)
+				}
+				oldStatic := s3a.iam.IsStaticConfig()
+				oldIdentity, oldCredential, oldFound := s3a.iam.lookupByAccessKey("KEPTKEY")
+
+				created, closed := 0, 0
+				typeName := "ouf-preserved-" + t.Name()
+				instanceName := "ouf-instance-" + t.Name()
+				kms.RegisterProvider(typeName, func(util.Configuration) (kms.KMSProvider, error) {
+					created++
+					return &oufProfileKMSFixture{closed: &closed}, nil
+				})
+				manager := kms.GetKMSManager()
+				priorDefault := manager.GetBucketKMSProvider("")
+				if err := manager.AddKMSProvider(instanceName, &kms.KMSConfig{Provider: typeName}); err != nil {
+					t.Fatal(err)
+				}
+				if err := manager.SetDefaultKMSProvider(instanceName); err != nil {
+					t.Fatal(err)
+				}
+				bucket := "ouf-bucket-" + t.Name()
+				if err := manager.SetBucketKMSProvider(bucket, instanceName); err != nil {
+					t.Fatal(err)
+				}
+				retainedProvider, err := manager.GetKMSProvider(bucket)
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() {
+					if err := manager.RemoveKMSProvider(instanceName); err != nil {
+						t.Error(err)
+					}
+					if priorDefault != "" {
+						if err := manager.SetDefaultKMSProvider(priorDefault); err != nil {
+							t.Error(err)
+						}
+					}
+				})
+
+				// The supported provider would replace/close an existing instance
+				// if iteration began before the entire declaration was validated.
+				config := map[string]interface{}{
+					"identities": []interface{}{map[string]interface{}{"name": "unexpected", "credentials": []interface{}{map[string]interface{}{"accessKey": "NEWKEY", "secretKey": "new-secret"}}, "actions": []string{"Admin"}}},
+					"kms": map[string]interface{}{"default_provider": instanceName, "providers": map[string]interface{}{
+						instanceName: map[string]interface{}{"type": typeName},
+						"excluded":   map[string]interface{}{"type": excluded},
+					}},
+				}
+				content, err := json.Marshal(config)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if mode == "bytes-reload" {
+					err = s3a.iam.LoadS3ApiConfigurationFromBytes(content)
+				} else {
+					err = s3a.iam.loadS3ApiConfigurationFromFile(writeTempIamConfig(t, string(content)))
+				}
+				if err == nil || !strings.Contains(err.Error(), "OUF standard profile excludes OpenBao/Vault KMS") {
+					t.Fatalf("excluded configuration was not rejected: %v", err)
+				}
+				if hasIdentity(s3a.iam, "unexpected") {
+					t.Fatal("denied configuration published identity")
+				}
+				identity, credential, found := s3a.iam.lookupByAccessKey("KEPTKEY")
+				if found != oldFound || identity != oldIdentity || credential != oldCredential || s3a.iam.IsStaticConfig() != oldStatic {
+					t.Fatal("denied reload changed existing identity/credential/static state")
+				}
+				if _, _, found := s3a.iam.lookupByAccessKey("NEWKEY"); found {
+					t.Fatal("denied reload published credential")
+				}
+				afterConfig, err := s3a.iam.credentialManager.LoadConfiguration(context.Background())
+				if err != nil {
+					t.Fatal(err)
+				}
+				afterBytes, err := json.Marshal(afterConfig)
+				if err != nil || !reflect.DeepEqual(beforeBytes, afterBytes) {
+					t.Fatal("denied reload modified credential store")
+				}
+				gotProvider, err := manager.GetKMSProvider(bucket)
+				if err != nil || gotProvider != retainedProvider || manager.GetBucketKMSProvider("") != instanceName || manager.GetBucketKMSProvider(bucket) != instanceName {
+					t.Fatal("denied reload changed KMS instance, default, or bucket binding")
+				}
+				if created != 1 || closed != 0 {
+					t.Fatalf("denied load invoked factories or closed retained instance: created=%d closed=%d", created, closed)
+				}
+				if _, err := manager.GetKMSProviderByName("excluded"); err == nil {
+					t.Fatal("excluded provider registered")
+				}
+			})
+		}
+	}
+}
