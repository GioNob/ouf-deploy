diff --git a/test/s3/iam/framework_clients_v2.go b/test/s3/iam/framework_clients_v2.go
new file mode 100644
index 0000000..0a0734b
--- /dev/null
+++ b/test/s3/iam/framework_clients_v2.go
@@ -0,0 +1,69 @@
+package iam
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/iam"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/smithy-go"
+)
+
+func fixtureStaticCredentials(access, secret, token string) aws.CredentialsProvider {
+	return aws.CredentialsProviderFunc(func(context.Context) (aws.Credentials, error) {
+		if access == "" || secret == "" {
+			return aws.Credentials{}, errors.New("fixture static credentials require both access key and secret key")
+		}
+		return aws.Credentials{AccessKeyID: access, SecretAccessKey: secret, SessionToken: token}, nil
+	})
+}
+
+func iamFrameworkConfig(creds aws.CredentialsProvider, httpClient *http.Client) aws.Config {
+	if httpClient == nil {
+		httpClient = &http.Client{Timeout: 30 * time.Second}
+	} else if httpClient.Timeout == 0 {
+		// Preserve the selected BearerTokenTransport without sharing mutable client configuration.
+		copy := *httpClient
+		copy.Timeout = 30 * time.Second
+		httpClient = &copy
+	}
+	return aws.Config{
+		Region: TestRegion, Credentials: creds, HTTPClient: httpClient,
+		Retryer:                    func() aws.Retryer { return aws.NopRetryer{} },
+		RequestChecksumCalculation: aws.RequestChecksumCalculationWhenSupported,
+		ResponseChecksumValidation: aws.ResponseChecksumValidationWhenSupported,
+	}
+}
+
+func newIAMFrameworkS3(creds aws.CredentialsProvider, httpClient *http.Client) *s3.Client {
+	return s3.NewFromConfig(iamFrameworkConfig(creds, httpClient), func(o *s3.Options) {
+		o.BaseEndpoint = aws.String(TestS3Endpoint)
+		o.UsePathStyle = true
+	})
+}
+
+func newIAMFrameworkIAM(creds aws.CredentialsProvider, httpClient *http.Client) *iam.Client {
+	return iam.NewFromConfig(iamFrameworkConfig(creds, httpClient), func(o *iam.Options) {
+		o.BaseEndpoint = aws.String(TestS3Endpoint)
+	})
+}
+
+func iamAPIError(err error) (smithy.APIError, bool) {
+	var apiErr smithy.APIError
+	ok := errors.As(err, &apiErr)
+	return apiErr, ok
+}
+
+func waitIAMFixture(ctx context.Context, duration time.Duration) error {
+	timer := time.NewTimer(duration)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
diff --git a/test/s3/iam/framework_clients_v2_test.go b/test/s3/iam/framework_clients_v2_test.go
new file mode 100644
index 0000000..a060ce3
--- /dev/null
+++ b/test/s3/iam/framework_clients_v2_test.go
@@ -0,0 +1,155 @@
+package iam
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	iamclient "github.com/aws/aws-sdk-go-v2/service/iam"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/stretchr/testify/require"
+)
+
+func TestIAMFrameworkV2StaticQueryAndToken(t *testing.T) {
+	f := &S3IAMTestFramework{t: t, ctx: t.Context()}
+	client, err := f.CreateIAMClientWithJWT("fixture-user", "TestAdminRole")
+	require.NoError(t, err)
+	o := client.Options()
+	require.Equal(t, TestRegion, o.Region)
+	require.Equal(t, TestS3Endpoint, aws.ToString(o.BaseEndpoint))
+	require.Equal(t, 1, o.Retryer.MaxAttempts())
+	require.Equal(t, 30*time.Second, o.HTTPClient.(*http.Client).Timeout)
+	creds, err := o.Credentials.Retrieve(t.Context())
+	require.NoError(t, err)
+	require.True(t, strings.HasPrefix(creds.AccessKeyID, "ASIA"))
+	require.NotEmpty(t, creds.SessionToken)
+	calls := 0
+	o.HTTPClient = &http.Client{Transport: iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		require.Equal(t, "POST", r.Method)
+		require.Equal(t, TestS3Endpoint+"/", r.URL.String())
+		require.Contains(t, r.Header.Get("Authorization"), "/us-west-2/iam/aws4_request")
+		require.Equal(t, creds.SessionToken, r.Header.Get("X-Amz-Security-Token"))
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		form, err := url.ParseQuery(string(body))
+		require.NoError(t, err)
+		require.Equal(t, "CreateUser", form.Get("Action"))
+		require.Equal(t, "2010-05-08", form.Get("Version"))
+		require.Equal(t, "fixture+user", form.Get("UserName"))
+		return fixtureResponse(r, http.StatusOK, `<CreateUserResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/"><CreateUserResult><User><UserName>fixture+user</UserName><UserId>fixture-id</UserId><Arn>arn:aws:iam::123456789012:user/fixture+user</Arn></User></CreateUserResult></CreateUserResponse>`), nil
+	})}
+	out, err := iamclient.New(o).CreateUser(t.Context(), &iamclient.CreateUserInput{UserName: aws.String("fixture+user")})
+	require.NoError(t, err)
+	require.Equal(t, "fixture+user", aws.ToString(out.User.UserName))
+	require.Equal(t, 1, calls)
+}
+
+func TestIAMFrameworkV2S3RegionAndChecksum(t *testing.T) {
+	f := &S3IAMTestFramework{t: t, ctx: t.Context()}
+	client, err := f.CreateS3ClientWithSessionToken("fixture-session")
+	require.NoError(t, err)
+	o := client.Options()
+	require.Equal(t, TestRegion, o.Region)
+	require.True(t, o.UsePathStyle)
+	require.Equal(t, aws.RequestChecksumCalculationWhenSupported, o.RequestChecksumCalculation)
+	require.Equal(t, aws.ResponseChecksumValidationWhenSupported, o.ResponseChecksumValidation)
+	o.HTTPClient = &http.Client{Transport: iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		require.Equal(t, "/fixture-bucket/a%20b.txt", r.URL.EscapedPath())
+		require.Contains(t, r.Header.Get("Authorization"), "/us-west-2/s3/aws4_request")
+		require.Equal(t, "fixture-session", r.Header.Get("X-Amz-Security-Token"))
+		require.Equal(t, "2zEPiw==", r.Header.Get("X-Amz-Checksum-Crc32"))
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		require.Equal(t, "fixture-body", string(body))
+		return fixtureResponse(r, http.StatusOK, ""), nil
+	})}
+	_, err = s3.New(o).PutObject(t.Context(), &s3.PutObjectInput{Bucket: aws.String("fixture-bucket"), Key: aws.String("a b.txt"), Body: strings.NewReader("fixture-body")})
+	require.NoError(t, err)
+}
+
+func TestIAMFrameworkV2BearerIdentity(t *testing.T) {
+	for _, service := range []string{"iam", "s3"} {
+		t.Run(service, func(t *testing.T) {
+			calls := 0
+			transport := &BearerTokenTransport{Token: "fixture.invalid.jwt", Transport: iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				require.Equal(t, "Bearer fixture.invalid.jwt", r.Header.Get("Authorization"))
+				require.Empty(t, r.Header.Get("X-Amz-Security-Token"))
+				require.Empty(t, r.Header.Get("X-Amz-Date"))
+				return fixtureResponse(r, http.StatusForbidden, `<ErrorResponse><Error><Type>Sender</Type><Code>AccessDenied</Code><Message>fixture denied</Message></Error></ErrorResponse>`), nil
+			})}
+			httpClient := &http.Client{Transport: transport}
+			if service == "iam" {
+				client := newIAMFrameworkIAM(aws.AnonymousCredentials{}, httpClient)
+				require.Equal(t, 30*time.Second, client.Options().HTTPClient.(*http.Client).Timeout)
+				_, err := client.ListUsers(t.Context(), &iamclient.ListUsersInput{})
+				require.Error(t, err)
+			} else {
+				client := newIAMFrameworkS3(aws.AnonymousCredentials{}, httpClient)
+				_, err := client.ListBuckets(t.Context(), &s3.ListBucketsInput{})
+				require.Error(t, err)
+			}
+			require.Zero(t, httpClient.Timeout, "constructor must not mutate caller's client")
+			require.Equal(t, 1, calls)
+		})
+	}
+}
+
+func TestIAMFrameworkV2ErrorsAndBoundedRetry(t *testing.T) {
+	calls := 0
+	client := newIAMFrameworkIAM(fixtureStaticCredentials("key", "secret", ""), &http.Client{Transport: iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return fixtureResponse(r, http.StatusServiceUnavailable, `<ErrorResponse><Error><Type>Sender</Type><Code>AccessDenied</Code><Message>fixture denied</Message></Error></ErrorResponse>`), nil
+	})})
+	_, err := client.ListUsers(t.Context(), &iamclient.ListUsersInput{})
+	require.Error(t, err)
+	apiErr, ok := iamAPIError(fmt.Errorf("wrapped fixture: %w", err))
+	require.True(t, ok)
+	require.Equal(t, "AccessDenied", apiErr.ErrorCode())
+	require.True(t, isAccessDenied(err))
+	require.False(t, isAccessDenied(errors.New("transport failure")))
+	require.Equal(t, 1, calls)
+}
+
+func TestIAMFrameworkV2CancellationAndPartialCredentials(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	transport := &http.Client{Transport: iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		t.Fatal("cancelled or incomplete identity must not reach transport")
+		return nil, errors.New("unexpected request")
+	})}
+	_, err := newIAMFrameworkIAM(fixtureStaticCredentials("key", "secret", ""), transport).ListUsers(ctx, &iamclient.ListUsersInput{})
+	require.ErrorIs(t, err, context.Canceled)
+	_, err = newIAMFrameworkIAM(fixtureStaticCredentials("key", "", ""), transport).ListUsers(t.Context(), &iamclient.ListUsersInput{})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "require both access key and secret key")
+	require.ErrorIs(t, waitIAMFixture(ctx, time.Hour), context.Canceled)
+}
+
+func TestIAMFrameworkV2RawExtensionSigning(t *testing.T) {
+	original := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = original })
+	calls := 0
+	http.DefaultTransport = iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		require.Contains(t, r.Header.Get("Authorization"), "/us-west-2/iam/aws4_request")
+		require.NotEmpty(t, r.Header.Get("X-Amz-Security-Token"))
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		require.Equal(t, "Action=UpdateGroup&Disabled=true&GroupName=fixture", string(body))
+		return fixtureResponse(r, http.StatusOK, "<UpdateGroupResponse/>"), nil
+	})
+	f := &S3IAMTestFramework{t: t, ctx: t.Context()}
+	resp, err := callIAMAPIAuthenticated(t, f, "UpdateGroup", url.Values{"Disabled": {"true"}, "GroupName": {"fixture"}})
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	require.Equal(t, 1, calls)
+}
