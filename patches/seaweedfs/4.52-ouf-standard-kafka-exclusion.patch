+package sub
+
+import (
+	"errors"
+	"testing"
+
+	kafkanotification "github.com/seaweedfs/seaweedfs/weed/notification/kafka"
+)
+
+func TestOUFStandardKafkaInputRegisteredAndRejectedWithoutAcknowledgement(t *testing.T) {
+	count := 0
+	for _, input := range NotificationInputs {
+		if input.GetName() == "kafka" {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatalf("Kafka input must stay recognizable exactly once, found %d", count)
+	}
+	input := &KafkaInput{}
+	if !errors.Is(input.Initialize(nil, "notification.kafka."), kafkanotification.ErrUnsupportedInOUFStandardProfile) {
+		t.Fatal("excluded input initialization accepted")
+	}
+	key, message, success, failure, err := input.ReceiveMessage()
+	if !errors.Is(err, kafkanotification.ErrUnsupportedInOUFStandardProfile) || key != "" || message != nil || success != nil || failure != nil {
+		t.Fatal("excluded input produced a message, acknowledgement or false success")
+	}
+}
