+package sub
+
+import (
+	"testing"
+	"time"
+
+	"github.com/IBM/sarama"
+	kafkanotif "github.com/seaweedfs/seaweedfs/weed/notification/kafka"
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestMaintainedSaramaConsumerWireAndReplicationAcknowledgement(t *testing.T) {
+	broker := sarama.NewMockBroker(t, 1)
+	defer broker.Close()
+	expected := &filer_pb.EventNotification{NewEntry: &filer_pb.Entry{Name: "farmacy.csv"}}
+	wire, err := proto.Marshal(expected)
+	if err != nil {
+		t.Fatal(err)
+	}
+	broker.SetHandlerByMap(map[string]sarama.MockResponse{
+		"MetadataRequest": sarama.NewMockMetadataResponse(t).SetBroker(broker.Addr(), 1).SetLeader("fixture", 0, 1),
+		"OffsetRequest":   sarama.NewMockOffsetResponse(t).SetOffset("fixture", 0, sarama.OffsetOldest, 11).SetOffset("fixture", 0, sarama.OffsetNewest, 12),
+		"FetchRequest":    sarama.NewMockFetchResponse(t, 1).SetMessageWithKey("fixture", 0, 11, sarama.StringEncoder("/fixture/farmacy.csv"), sarama.ByteEncoder(wire)).SetHighWaterMark("fixture", 0, 12),
+	})
+	config := kafkanotif.NewSaramaConfig()
+	config.Consumer.Return.Errors = true
+	config.Net.DialTimeout = time.Second
+	config.Net.ReadTimeout = time.Second
+	config.Net.WriteTimeout = time.Second
+	consumer, err := sarama.NewConsumer([]string{broker.Addr()}, config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := consumer.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	partition, err := consumer.ConsumePartition("fixture", 0, sarama.OffsetOldest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := partition.Close(); err != nil {
+			t.Error(err)
+		}
+	}()
+	var delivered *sarama.ConsumerMessage
+	select {
+	case delivered = <-partition.Messages():
+	case err := <-partition.Errors():
+		t.Fatal(err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("bounded consumer exchange timed out")
+	}
+	if delivered.Offset != 11 || delivered.Partition != 0 || delivered.Topic != "fixture" {
+		t.Fatalf("delivery coordinates changed: %#v", delivered)
+	}
+	input := &KafkaInput{messageChan: make(chan *sarama.ConsumerMessage, 1), progress: newTestProgress()}
+	input.progress.PartitionOffsets[0] = 10
+	input.messageChan <- delivered
+	key, observed, onSuccess, onFailure, err := input.ReceiveMessage()
+	if err != nil || key != "/fixture/farmacy.csv" || !proto.Equal(observed, expected) {
+		t.Fatalf("notification decoding changed: %q %v %v", key, observed, err)
+	}
+	if input.progress.PartitionOffsets[0] != 10 {
+		t.Fatal("receipt prematurely committed replication offset")
+	}
+	onFailure()
+	onSuccess()
+	if input.progress.PartitionOffsets[0] != 10 {
+		t.Fatal("failure hold did not block later acknowledgement")
+	}
+	input.progress = newTestProgress()
+	input.progress.PartitionOffsets[0] = 10
+	input.messageChan <- delivered
+	_, _, onSuccess, _, err = input.ReceiveMessage()
+	if err != nil {
+		t.Fatal(err)
+	}
+	onSuccess()
+	if input.progress.PartitionOffsets[0] != 11 {
+		t.Fatal("successful replication did not advance offset")
+	}
+	fetches := 0
+	for _, exchange := range broker.History() {
+		switch request := exchange.Request.(type) {
+		case *sarama.FetchRequest:
+			fetches++
+			if request.Version != 6 {
+				t.Fatalf("unexpected fetch wire version: %d", request.Version)
+			}
+		case *sarama.ApiVersionsRequest:
+			t.Fatal("unexpected broker version negotiation")
+		}
+	}
+	if fetches == 0 {
+		t.Fatal("no real protocol fetch observed")
+	}
+}
