+func TestS3SinkAmbiguousPutAndDeleteSingleAttempt(t *testing.T) {
+	for _, op := range []string{"PUT", "DELETE"} {
+		t.Run(op, func(t *testing.T) {
+			calls := 0
+			sink := sdkSink(t, func(r *http.Request) (*http.Response, error) {
+				calls++
+				if r.Method != op {
+					t.Fatal("wrong method")
+				}
+				if r.Body != nil {
+					io.Copy(io.Discard, r.Body)
+				}
+				return fixtureResponse(r, 503, `<Error><Code>ServiceUnavailable</Code><Message>ambiguous fixture</Message></Error>`), nil
+			})
+			var err error
+			if op == "PUT" {
+				err = sink.CreateEntry("key", &filer_pb.Entry{Content: []byte("fixture"), Attributes: &filer_pb.FuseAttributes{}}, nil)
+			} else {
+				err = sink.DeleteEntry("key", false, false, nil)
+			}
+			if err == nil || calls != 1 {
+				t.Fatalf("hidden replay: err=%v calls=%d", err, calls)
+			}
+		})
+	}
+}
