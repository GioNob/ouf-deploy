+func TestKMSInvalidBindingsFailBeforeRequests(t *testing.T) {
+	isolateCredentials(t)
+	if p, err := NewAWSKMSProvider(nil); err == nil || p != nil {
+		t.Fatal("nil config accepted")
+	}
+	for _, tc := range []struct {
+		name, key string
+		value     any
+	}{
+		{"region", "region", ""}, {"partial-id", "access_key", ""}, {"partial-secret", "secret_key", ""},
+		{"role", "role_arn", "arn:fixture"}, {"external", "external_id", "fixture"},
+		{"retries", "max_retries", 3}, {"negative-retries", "max_retries", -1},
+		{"negative-connect", "connect_timeout", -1}, {"negative-request", "request_timeout", -1},
+		{"overflow", "request_timeout", math.MaxInt64},
+		{"relative", "endpoint", "kms.invalid"}, {"scheme", "endpoint", "file:///fixture"},
+		{"userinfo", "endpoint", "https://user:pass@kms.invalid"}, {"query", "endpoint", "https://kms.invalid?secret=x"},
+		{"fragment", "endpoint", "https://kms.invalid#fragment"}, {"parse", "endpoint", "https://%xx"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := fixtureConfig()
+			c.Set(tc.key, tc.value)
+			if p, err := NewAWSKMSProvider(util.NewViperProxy(c)); err == nil || p != nil {
+				t.Fatal("unsafe configuration accepted")
+			}
+		})
+	}
+	c := fixtureConfig()
+	c.Set("access_key", "")
+	c.Set("secret_key", "")
+	if _, err := NewAWSKMSProvider(util.NewViperProxy(c)); err == nil {
+		t.Fatal("orphan session token accepted")
+	}
+	for _, key := range []string{"AWS_ENDPOINT_URL", "AWS_ENDPOINT_URL_KMS"} {
+		t.Run(key, func(t *testing.T) {
+			t.Setenv(key, "https://unexpected.invalid")
+			if _, err := NewAWSKMSProvider(util.NewViperProxy(fixtureConfig())); err == nil {
+				t.Fatal("implicit endpoint accepted")
+			}
+		})
+	}
+}
