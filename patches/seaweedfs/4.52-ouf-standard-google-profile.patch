@@ -0,0 +1,38 @@
+package filer
+
+import (
+	"context"
+	"errors"
+	"github.com/seaweedfs/seaweedfs/weed/pb/remote_pb"
+	"github.com/seaweedfs/seaweedfs/weed/util"
+	"github.com/seaweedfs/seaweedfs/weed/util/googleprofile"
+	"google.golang.org/protobuf/proto"
+	"reflect"
+	"testing"
+)
+
+func TestOUFGoogleProfileReloadPreservesPreviousMap(t *testing.T) {
+	rs := NewFilerRemoteStorage()
+	old := &remote_pb.RemoteConf{Name: "old", Type: "s3"}
+	rs.storageNameToConf["old"] = old
+	rs.mapDirectoryToRemoteStorage("/original", &remote_pb.RemoteStorageLocation{Name: "old", Bucket: "unchanged"})
+	before := rs.MountedDirectories()
+	store := newStubFilerStore()
+	payload, _ := proto.Marshal(&remote_pb.RemoteConf{Name: "bad", Type: "gcs", GcsGoogleApplicationCredentials: "/must-not-read"})
+	key := string(DirectoryEtcRemote) + "/bad.conf"
+	store.entries[key] = &Entry{FullPath: util.FullPath(key), Attr: Attr{Mode: 0644}, Content: payload}
+	rs.SetConfValidator(func(context.Context, *remote_pb.RemoteConf) error {
+		t.Fatal("validator called before profile denial")
+		return nil
+	})
+	f := newTestFiler(t, store, rs)
+	if e := rs.LoadRemoteStorageConfigurationsAndMapping(f); !errors.Is(e, googleprofile.ErrUnsupported) {
+		t.Fatal(e)
+	}
+	if len(rs.storageNameToConf) != 1 || rs.storageNameToConf["old"] != old || !reflect.DeepEqual(before, rs.MountedDirectories()) {
+		t.Fatal("previous map changed")
+	}
+	if string(store.entries[key].Content) != string(payload) {
+		t.Fatal("persisted configuration changed")
+	}
+}
