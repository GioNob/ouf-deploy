+package gcssink
+
+import (
+	"errors"
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"github.com/seaweedfs/seaweedfs/weed/util/googleprofile"
+	"testing"
+)
+
+func TestOUFGoogleProfileSinkNeverSucceeds(t *testing.T) {
+	g := &GcsSink{}
+	for _, e := range []error{g.Initialize(nil, ""), g.CreateEntry("", nil, nil), g.CreateEntry("", &filer_pb.Entry{IsDirectory: true}, nil), g.DeleteEntry("", false, false, nil), g.DeleteEntry("", true, false, nil)} {
+		if !errors.Is(e, googleprofile.ErrUnsupported) {
+			t.Fatal(e)
+		}
+	}
+	found, e := g.UpdateEntry("", nil, "", nil, false, nil)
+	if found || !errors.Is(e, googleprofile.ErrUnsupported) {
+		t.Fatal(found, e)
+	}
+}
