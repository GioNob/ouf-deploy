+func signS3TablesRequest(req *http.Request, body string, signingTime time.Time) error {
+	creds, err := credentials.NewStaticCredentialsProvider("test-ak", "test-sk", "").Retrieve(req.Context())
+	if err != nil {
+		return err
+	}
+	payloadHash := fmt.Sprintf("%x", sha256.Sum256([]byte(body)))
+	return v4.NewSigner().SignHTTP(req.Context(), creds, req, payloadHash, "s3tables", "us-east-1", signingTime)
+}
+
+func TestSignS3TablesRequestUsesS3TablesScope(t *testing.T) {
+	body := `{"name":"test-bucket"}`
+	req, err := http.NewRequest(http.MethodPut, "http://127.0.0.1:8333/buckets", strings.NewReader(body))
+	if err != nil {
+		t.Fatalf("create request: %v", err)
+	}
+	signingTime := time.Date(2026, time.November, 3, 12, 0, 0, 0, time.UTC)
+	if err := signS3TablesRequest(req, body, signingTime); err != nil {
+		t.Fatalf("sign request: %v", err)
+	}
+
+	authorization := req.Header.Get("Authorization")
+	if !strings.Contains(authorization, "/20261103/us-east-1/s3tables/aws4_request") {
+		t.Fatalf("authorization scope = %q, want s3tables scope", authorization)
+	}
+	if got := req.Header.Get("X-Amz-Date"); got != "20261103T120000Z" {
+		t.Fatalf("X-Amz-Date = %q, want 20261103T120000Z", got)
 	}
