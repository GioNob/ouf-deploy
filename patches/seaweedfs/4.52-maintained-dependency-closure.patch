@@ -0,0 +1,45 @@
+package s3api
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/seaweedfs/seaweedfs/weed/kms"
+)
+
+// validateOUFStandardKMSConfig runs before either static-file KMS initialization
+// or identity parsing/publication, including reloads through the byte API.
+func validateOUFStandardKMSConfig(content []byte) error {
+	var config map[string]interface{}
+	if err := json.Unmarshal(content, &config); err != nil {
+		// The existing configuration parser reports malformed JSON. No KMS
+		// loader can act on it either, so retain the existing parse diagnostic.
+		return nil
+	}
+	value, exists := config["kms"]
+	if !exists {
+		return nil
+	}
+	return kms.ValidateOUFStandardConfig(value)
+}
+
+// readOUFStandardS3Config pins the initially validated bytes before credential
+// stores, background reload workers, filer clients or KMS are initialized.
+func readOUFStandardS3Config(option *S3ApiServerOption) (string, []byte, error) {
+	fileName := option.Config
+	if fileName == "" {
+		fileName = option.IamConfig
+	}
+	if fileName == "" {
+		return "", nil, nil
+	}
+	content, err := os.ReadFile(fileName)
+	if err != nil {
+		return fileName, nil, fmt.Errorf("fail to read %s: %w", fileName, err)
+	}
+	if err := validateOUFStandardKMSConfig(content); err != nil {
+		return fileName, nil, err
+	}
+	return fileName, content, nil
+}
