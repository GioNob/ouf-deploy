+func presignedPutRequest(ctx context.Context, client *s3.PresignClient, bucket, key, body string) (*http.Request, error) {
+	digest := md5.Sum([]byte(body))
+	md5Header := base64.StdEncoding.EncodeToString(digest[:])
+	signed, err := client.PresignPutObject(ctx, &s3.PutObjectInput{
+		Bucket:     aws.String(bucket),
+		Key:        aws.String(key),
+		ContentMD5: aws.String(md5Header),
+	}, s3.WithPresignExpires(15*time.Minute))
 	if err != nil {
-		fmt.Printf("error put request: %v\n", err)
-		return
+		return nil, err
 	}
-	defer util_http.CloseResponse(resp)
-	fmt.Printf("response: %+v\n", resp)
+	req, err := http.NewRequestWithContext(ctx, signed.Method, signed.URL, strings.NewReader(body))
+	if err != nil {
+		return nil, fmt.Errorf("invalid presigned request")
+	}
+	req.Header = signed.SignedHeader.Clone()
+	req.Host = req.Header.Get("Host")
+	req.Header.Del("Host")
