+func TestKMSCancelledContextAndMissingMetadata(t *testing.T) {
+	calls := 0
+	p := sdkFixture(t, func(*http.Request) (*http.Response, error) { calls++; return response(200, `{}`), nil })
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := p.DescribeKey(ctx, &seaweedkms.DescribeKeyRequest{KeyID: "key"}); err == nil || calls != 0 {
+		t.Fatal("cancelled operation sent")
+	}
+	if _, err := p.DescribeKey(context.Background(), &seaweedkms.DescribeKeyRequest{KeyID: "key"}); err == nil {
+		t.Fatal("missing metadata accepted")
+	}
