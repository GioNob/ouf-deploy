@@ -0,0 +1,29 @@
+package weed_server
+
+import (
+	"github.com/seaweedfs/seaweedfs/weed/util"
+	"github.com/spf13/viper"
+)
+
+// snapshotFilerClientTLSConfig preserves the pre-filer/notification merge
+// inputs consumed by security.LoadClientTLS and LoadClientTLSForTarget. Read
+// each key through ViperProxy so automatic environment overrides are captured
+// even when a key is not listed by AllKeys. This performs no certificate reads
+// or provider construction. Keep this key set aligned with security/tls.go.
+func snapshotFilerClientTLSConfig(config *util.ViperProxy) *util.ViperProxy {
+	snapshot := viper.New()
+	keys := []string{
+		"grpc.ca",
+		"grpc.filer.client_cert", "grpc.filer.client_key",
+		"grpc.filer.cert", "grpc.filer.key",
+		"grpc.allowed_server_commonNames", "grpc.allowed_server_wildcard_domain",
+		"grpc.filer.allowed_server_commonNames", "grpc.filer.allowed_server_wildcard_domain",
+	}
+	for _, target := range []string{"master", "volume", "s3"} {
+		keys = append(keys, "grpc.filer."+target+"_allowed_server_commonNames", "grpc.filer."+target+"_allowed_server_wildcard_domain")
+	}
+	for _, key := range keys {
+		snapshot.Set(key, config.GetString(key))
+	}
+	return util.NewViperProxy(snapshot)
+}
