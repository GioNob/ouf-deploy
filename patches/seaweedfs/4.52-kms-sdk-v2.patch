+type httpFunc func(*http.Request) (*http.Response, error)
+
+func (f httpFunc) Do(r *http.Request) (*http.Response, error) { return f(r) }
+
+func isolateCredentials(t *testing.T) {
+	t.Helper()
+	for _, key := range []string{"AWS_PROFILE", "AWS_DEFAULT_PROFILE", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_WEB_IDENTITY_TOKEN_FILE", "AWS_ROLE_ARN", "AWS_ENDPOINT_URL", "AWS_ENDPOINT_URL_KMS", "AWS_CONTAINER_CREDENTIALS_FULL_URI", "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI"} {
+		t.Setenv(key, "")
+	}
+	t.Setenv("AWS_EC2_METADATA_DISABLED", "true")
+	path := filepath.Join(t.TempDir(), "empty")
+	if err := os.WriteFile(path, nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("AWS_CONFIG_FILE", path)
+	t.Setenv("AWS_SHARED_CREDENTIALS_FILE", path)
+}
+
+func fixtureConfig() *viper.Viper {
+	c := viper.New()
+	c.Set("region", "us-east-1")
+	c.Set("access_key", "fixture-id")
+	c.Set("secret_key", "fixture-secret")
+	c.Set("session_token", "fixture-session")
+	return c
+}
+
+func providerFor(t *testing.T, c *viper.Viper) *AWSKMSProvider {
+	t.Helper()
+	p, err := NewAWSKMSProvider(util.NewViperProxy(c))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return p.(*AWSKMSProvider)
+}
+
+func sdkFixture(t *testing.T, transport httpFunc) *AWSKMSProvider {
+	t.Helper()
+	isolateCredentials(t)
+	p := providerFor(t, fixtureConfig())
+	opts := p.client.Options()
+	opts.HTTPClient = transport
+	p.client = kms.New(opts)
+	return p
+}
+
+func response(status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": []string{"application/x-amz-json-1.1"}}, Body: io.NopCloser(strings.NewReader(body))}
+}
