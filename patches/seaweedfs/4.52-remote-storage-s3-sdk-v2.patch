+		return stack.Serialize.Insert(middleware.SerializeMiddlewareFunc("AddContentMD5", func(ctx context.Context, in middleware.SerializeInput, next middleware.SerializeHandler) (middleware.SerializeOutput, middleware.Metadata, error) {
+			req, ok := in.Request.(*smithyhttp.Request)
