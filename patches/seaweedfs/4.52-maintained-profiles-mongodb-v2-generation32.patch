+func TestOUFGoogleProfileBackupBeforeSinkCheckpoint(t *testing.T) {
+	for _, key := range []string{"notification.google_pub_sub.enabled", "sink.google_cloud_storage.enabled"} {
+		t.Run(key, func(t *testing.T) {
+			old := viper.Get(key)
+			defer viper.Set(key, old)
+			viper.Set(key, true)
+			offset, err := doFilerBackup(nil, nil, nil, nil, nil, 0, 0, 17)
+			if offset != 17 || !errors.Is(err, googleprofile.ErrUnsupported) {
+				t.Fatalf("offset=%d err=%v", offset, err)
+			}
+		})
+	}
+}
