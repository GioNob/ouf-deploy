+func TestNormalSDKV2SSECKeyEncoding(t *testing.T) {
+	key, md5B64 := generateSSECKey()
+	raw, err := base64.StdEncoding.DecodeString(key)
+	require.NoError(t, err)
+	require.Len(t, raw, 32)
+	digest := md5.Sum(raw)
+	require.Equal(t, base64.StdEncoding.EncodeToString(digest[:]), md5B64)
+}
