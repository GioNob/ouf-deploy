+package replication
+
+import (
+	"errors"
+	"github.com/seaweedfs/seaweedfs/weed/kms"
+	"github.com/spf13/viper"
+	"testing"
+)
+
+func TestOUFStandardReplicatorRejectsBeforeSourceAndSinkInitialization(t *testing.T) {
+	oldConfig := viper.Get("kms")
+	defer viper.Set("kms", oldConfig)
+	viper.Set("kms", map[string]interface{}{"providers": map[string]interface{}{"excluded": map[string]interface{}{"type": "vault"}}})
+	// Nil dependencies cannot be initialized. The real constructor must reject
+	// the config before touching source settings or assigning a filer to a sink.
+	replicator, err := NewReplicator(nil, "", nil)
+	if replicator != nil || !errors.Is(err, kms.ErrOUFUnsupportedKMSProvider) {
+		t.Fatalf("replicator=%v error=%v", replicator, err)
+	}
+}
