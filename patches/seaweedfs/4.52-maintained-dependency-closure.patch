diff --git a/weed/server/filer_server_ouf_kafka_profile_test.go b/weed/server/filer_server_ouf_kafka_profile_test.go
new file mode 100644
index 000000000..52cb1959a
--- /dev/null
+++ b/weed/server/filer_server_ouf_kafka_profile_test.go
@@ -0,0 +1,128 @@
+package weed_server
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+
+	kafkanotification "github.com/seaweedfs/seaweedfs/weed/notification/kafka"
+	"github.com/seaweedfs/seaweedfs/weed/util"
+	"github.com/spf13/viper"
+)
+
+// A fresh process isolates the shared Viper singleton and environment. Passing
+// nil masters (and, in one case, nil options) proves the denial precedes option
+// writes, TLS setup, sweepers, DNS refresh, store setup and master connections.
+func TestOUFStandardKafkaFilerPreflightBeforeEffects(t *testing.T) {
+	if mode := os.Getenv("OUF_KAFKA_FILER_CHILD"); mode != "" {
+		directory := t.TempDir()
+		util.ConfigurationFileDirectory = util.DirectoryValueType(directory)
+		filerConfig := "[leveldb2]\nenabled = true\ndir = '" + filepath.Join(directory, "store") + "'\n"
+		notificationConfig := "[notification.kafka]\nenabled = true\n"
+		switch mode {
+		case "filer-file":
+			filerConfig += "[notification.kafka]\nenabled = true\n"
+			notificationConfig = ""
+		case "merge-and-mixed":
+			filerConfig += "[notification.kafka]\nenabled = false\n"
+			notificationConfig += "[notification.webhook]\nenabled = true\nendpoint = 'http://127.0.0.1:1/never'\n"
+		case "environment":
+			notificationConfig = "[notification.kafka]\nenabled = false\n"
+			t.Setenv("WEED_NOTIFICATION_KAFKA_ENABLED", "true")
+		}
+		if err := os.WriteFile(filepath.Join(directory, "filer.toml"), []byte(filerConfig), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(directory, "notification.toml"), []byte(notificationConfig), 0600); err != nil {
+			t.Fatal(err)
+		}
+		var options *FilerOption
+		if mode != "notification-file" {
+			options = &FilerOption{DefaultLevelDbDir: filepath.Join(directory, "default-store"), AllowedOrigins: []string{"unchanged"}, ExposeDirectoryData: true}
+		}
+		// Invalid TLS files would abort startup if TLS construction happened
+		// before the Kafka guard. They must never be read on this path.
+		v := util.GetViper()
+		v.Set("grpc.filer.client_cert", filepath.Join(directory, "never-read.crt"))
+		v.Set("grpc.filer.client_key", filepath.Join(directory, "never-read.key"))
+		v.Set("grpc.ca", filepath.Join(directory, "never-read-ca.crt"))
+		fs, err := NewFilerServer(nil, nil, options)
+		if fs != nil || !errors.Is(err, kafkanotification.ErrUnsupportedInOUFStandardProfile) {
+			t.Fatalf("expected rejection before construction, got filer=%v error=%v", fs, err)
+		}
+		if options != nil && (!reflect.DeepEqual(options.AllowedOrigins, []string{"unchanged"}) || !options.ExposeDirectoryData) {
+			t.Fatal("preflight mutated caller options")
+		}
+		for _, name := range []string{"store", "default-store"} {
+			if _, err := os.Stat(filepath.Join(directory, name)); !os.IsNotExist(err) {
+				t.Fatalf("store touched: %s (%v)", name, err)
+			}
+		}
+		return
+	}
+	for _, mode := range []string{"notification-file", "filer-file", "merge-and-mixed", "environment"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestOUFStandardKafkaFilerPreflightBeforeEffects$")
+			cmd.Env = append(os.Environ(), "OUF_KAFKA_FILER_CHILD="+mode)
+			output, err := cmd.CombinedOutput()
+			if err != nil || ctx.Err() != nil {
+				t.Fatalf("early denial failed: %v %s", err, output)
+			}
+		})
+	}
+}
+
+func TestOUFStandardFilerTLSSnapshotPreservesEffectiveInputs(t *testing.T) {
+	values := map[string]string{
+		"grpc.ca":                "original-ca",
+		"grpc.filer.client_cert": "original-client-cert", "grpc.filer.client_key": "original-client-key",
+		"grpc.filer.cert": "original-cert", "grpc.filer.key": "original-key",
+		"grpc.allowed_server_commonNames": "original-global-names", "grpc.allowed_server_wildcard_domain": "original-global-wildcard",
+		"grpc.filer.allowed_server_commonNames": "original-filer-names", "grpc.filer.allowed_server_wildcard_domain": "original-filer-wildcard",
+	}
+	for _, target := range []string{"master", "volume", "s3"} {
+		values["grpc.filer."+target+"_allowed_server_commonNames"] = "original-" + target + "-names"
+		values["grpc.filer."+target+"_allowed_server_wildcard_domain"] = "original-" + target + "-wildcard"
+	}
+	// This override is absent from AllKeys when no file/default provides it.
+	delete(values, "grpc.filer.client_cert")
+	original := viper.New()
+	original.SetEnvPrefix("OUF_TLS_SNAPSHOT")
+	original.SetEnvKeyReplacer(strings.NewReplacer(".", "_"))
+	original.AutomaticEnv()
+	for key, value := range values {
+		original.SetDefault(key, value)
+	}
+	t.Setenv("OUF_TLS_SNAPSHOT_GRPC_FILER_CLIENT_CERT", "environment-client-cert")
+	config := util.NewViperProxy(original)
+	snapshot := snapshotFilerClientTLSConfig(config)
+	values["grpc.filer.client_cert"] = "environment-client-cert"
+	// Simulate a later filer/notification config merge changing every key.
+	merged := map[string]interface{}{}
+	for key := range values {
+		merged[key] = "later-file-value"
+	}
+	if err := original.MergeConfigMap(merged); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("OUF_TLS_SNAPSHOT_GRPC_FILER_CLIENT_CERT", "later-environment-value")
+	for key, wanted := range values {
+		if got := snapshot.GetString(key); got != wanted {
+			t.Errorf("snapshot %s=%q, want %q", key, got, wanted)
+		}
+		if got := config.GetString(key); got == wanted {
+			t.Errorf("fixture did not change %s", key)
+		}
+	}
+	if snapshot.GetString("grpc.filer.unrelated_new_key") != "" {
+		t.Fatal("unexpected snapshot content")
+	}
+}
