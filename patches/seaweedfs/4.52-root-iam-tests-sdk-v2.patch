+func TestNormalIAMSDKV2Cancellation(t *testing.T) {
+	c := newNormalIAMClient("http://127.0.0.1:8333", "fixture-key", "fixture-secret")
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	attempts := 0
+	_, err := c.DeleteUser(ctx, &iam.DeleteUserInput{UserName: aws.String("fixture-user")}, func(o *iam.Options) {
+		o.HTTPClient = &http.Client{Timeout: 30 * time.Second, Transport: normalIAMRoundTripper(func(req *http.Request) (*http.Response, error) {
+			attempts++
+			return nil, errors.New("unexpected request after cancellation")
+		})}
+	})
+	require.ErrorIs(t, err, context.Canceled)
+	require.Zero(t, attempts)
+}
