{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/authorization/policy-grant-v1.json",
  "title": "OUF PolicyGrant v1",
  "type": "object",
  "required": [
    "grantId",
    "effect",
    "subject",
    "capabilityId",
    "actorTypes",
    "status"
  ],
  "properties": {
    "grantId": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "externalRoleRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "principalRef": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "externalRoleRef"
          ]
        },
        {
          "required": [
            "principalRef"
          ]
        }
      ]
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "actorTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "HUMAN_USER",
          "AI_AGENT",
          "MCP_SERVER",
          "SERVICE_IDENTITY",
          "EXTERNAL_SYSTEM"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "organizationScope": {
      "$ref": "organization-scope-v1.json"
    },
    "assurance": {
      "$ref": "assurance-requirement-v1.json"
    },
    "resourceConditions": {
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "REVOKED"
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Authorization & Access Control Specification v1.3"
  ],
  "x-ouf-scope-control": "Authorization contracts only; no IAM vendor binding, Gateway route model, THS approval DTO, Query Governor model or MCP Server change.",
  "x-ouf-evaluation": "Default deny; explicit applicable DENY overrides ALLOW."
}
