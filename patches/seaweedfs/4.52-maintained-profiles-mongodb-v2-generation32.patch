+package gcs
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/seaweedfs/seaweedfs/weed/util/googleprofile"
+)
+
+func TestOUFGoogleProfileDirectFactoryRejectsBeforeConfig(t *testing.T) {
+	c, e := (gcsRemoteStorageMaker{}).Make(nil)
+	if c != nil || !errors.Is(e, googleprofile.ErrUnsupported) {
+		t.Fatal(c, e)
+	}
+	c, e = MakeWithHTTPClient(nil, nil)
+	if c != nil || !errors.Is(e, googleprofile.ErrUnsupported) {
+		t.Fatal(c, e)
+	}
+}
