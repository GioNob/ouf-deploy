+func TestOUFGoogleProfileConfigureBeforeFiler(t *testing.T) {
+	c := &commandRemoteConfigure{}
+	if e := c.Do([]string{"-name=excluded", "-type=gcs"}, nil, io.Discard); !errors.Is(e, googleprofile.ErrUnsupported) {
