+func TestNormalSDKV2MultipartAndCancellation(t *testing.T) {
+	calls := 0
+	client := newNormalS3Client("http://127.0.0.1:8333", normalRoundTripFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		require.Equal(t, "POST", r.Method)
+		require.Equal(t, "fixture-upload", r.URL.Query().Get("uploadId"))
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		require.Contains(t, string(body), "<PartNumber>1</PartNumber>")
+		require.Contains(t, string(body), "<ETag>fixture-etag</ETag>")
+		return normalResponse(r, 200, "<CompleteMultipartUploadResult><Bucket>bucket</Bucket><Key>key</Key><ETag>complete-etag</ETag></CompleteMultipartUploadResult>"), nil
+	}))
+	out, err := client.CompleteMultipartUpload(t.Context(), &s3.CompleteMultipartUploadInput{Bucket: aws.String("bucket"), Key: aws.String("key"), UploadId: aws.String("fixture-upload"), MultipartUpload: &types.CompletedMultipartUpload{Parts: []types.CompletedPart{{ETag: aws.String("fixture-etag"), PartNumber: aws.Int32(1)}}}})
+	require.NoError(t, err)
+	require.Equal(t, "complete-etag", aws.ToString(out.ETag))
+	require.Equal(t, 1, calls)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, err = client.PutObject(ctx, &s3.PutObjectInput{Bucket: aws.String("bucket"), Key: aws.String("key"), Body: strings.NewReader("cancelled")})
+	require.True(t, errors.Is(err, context.Canceled))
+	require.Equal(t, 1, calls)
+}
