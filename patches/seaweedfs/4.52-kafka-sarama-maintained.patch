diff --git a/weed/notification/kafka/sarama_config.go b/weed/notification/kafka/sarama_config.go
new file mode 100644
--- /dev/null
+++ b/weed/notification/kafka/sarama_config.go
@@ -0,0 +1,17 @@
+package kafka
+
+import "github.com/IBM/sarama"
+
+// NewSaramaConfig keeps the Kafka wire profile selected before migrating from
+// Shopify Sarama 1.38.1. Moving to the maintained module must not silently raise
+// the broker protocol, SASL framing version or maximum notification size.
+func NewSaramaConfig() *sarama.Config {
+	config := sarama.NewConfig()
+	config.Version = sarama.V1_0_0_0
+	config.Net.SASL.Version = sarama.SASLHandshakeV0
+	config.Producer.MaxMessageBytes = 1000000
+	// Sarama 1.38.1 only sent ApiVersions for Kafka >= 2.4. Current Sarama
+	// negotiates whenever this flag is set, and forbids negotiation with SASL v0.
+	config.ApiVersionsRequest = false
+	return config
+}
diff --git a/weed/notification/kafka/sarama_config_test.go b/weed/notification/kafka/sarama_config_test.go
new file mode 100644
--- /dev/null
+++ b/weed/notification/kafka/sarama_config_test.go
@@ -0,0 +1,142 @@
+package kafka
+
+import (
+	"bytes"
+	"crypto/tls"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/IBM/sarama"
+	"github.com/seaweedfs/seaweedfs/weed/pb/filer_pb"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestMaintainedSaramaPreservesSelectedWireAndRetryProfile(t *testing.T) {
+	c := NewSaramaConfig()
+	if c.Version != sarama.V1_0_0_0 || c.Net.SASL.Version != sarama.SASLHandshakeV0 || c.ApiVersionsRequest {
+		t.Fatal("migration changed broker version, SASL framing or negotiation")
+	}
+	if c.Producer.MaxMessageBytes != 1000000 || c.Producer.RequiredAcks != sarama.WaitForLocal || c.Producer.Retry.Max != 3 {
+		t.Fatal("migration changed notification size, acknowledgement or retry policy")
+	}
+	if c.Metadata.Retry.Max != 3 || c.Producer.Timeout != 10*time.Second || c.Net.DialTimeout != 30*time.Second || c.Net.ReadTimeout != 30*time.Second || c.Net.WriteTimeout != 30*time.Second {
+		t.Fatal("migration changed established finite transport and metadata budgets")
+	}
+	if err := c.Validate(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestMaintainedSaramaSecurityConfiguration(t *testing.T) {
+	for _, mechanism := range []string{"PLAIN", "SCRAM-SHA-256", "SCRAM-SHA-512"} {
+		t.Run(mechanism, func(t *testing.T) {
+			c := NewSaramaConfig()
+			err := ConfigureSASLTLS(c, SASLTLSConfig{SASLEnabled: true, SASLMechanism: mechanism,
+				SASLUsername: "fixture-user", SASLPassword: "fixture-secret", TLSEnabled: true})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = c.Validate(); err != nil {
+				t.Fatal(err)
+			}
+			if !c.Net.SASL.Enable || string(c.Net.SASL.Mechanism) != mechanism || c.Net.SASL.User != "fixture-user" || c.Net.SASL.Password != "fixture-secret" {
+				t.Fatal("SASL credentials or mechanism changed")
+			}
+			if !c.Net.TLS.Enable || c.Net.TLS.Config == nil || c.Net.TLS.Config.MinVersion != tls.VersionTLS12 || c.Net.TLS.Config.InsecureSkipVerify {
+				t.Fatal("TLS verification defaults changed")
+			}
+			if strings.HasPrefix(mechanism, "SCRAM") {
+				client := c.Net.SASL.SCRAMClientGeneratorFunc()
+				if err := client.Begin("fixture-user", "fixture-secret", ""); err != nil {
+					t.Fatal(err)
+				}
+				first, err := client.Step("")
+				if err != nil || !strings.Contains(first, "n=fixture-user,r=") || client.Done() {
+					t.Fatalf("invalid SCRAM initial exchange: %q, %v", first, err)
+				}
+			}
+		})
+	}
+	for _, cfg := range []SASLTLSConfig{{SASLEnabled: true, SASLMechanism: "unsupported"}, {TLSEnabled: true, TLSClientCert: "missing-client-cert"}, {TLSEnabled: true, TLSCACert: "missing-ca"}} {
+		if ConfigureSASLTLS(NewSaramaConfig(), cfg) == nil {
+			t.Fatal("invalid security configuration accepted")
+		}
+	}
+}
+
+func TestMaintainedSaramaNotificationBrokerRoundTrip(t *testing.T) {
+	for _, failed := range []bool{false, true} {
+		name := "success"
+		if failed {
+			name = "permanent-error"
+		}
+		t.Run(name, func(t *testing.T) {
+			broker := sarama.NewMockBroker(t, 1)
+			defer broker.Close()
+			code := sarama.ErrNoError
+			if failed {
+				code = sarama.ErrMessageSizeTooLarge
+			}
+			broker.SetHandlerByMap(map[string]sarama.MockResponse{
+				"MetadataRequest": sarama.NewMockMetadataResponse(t).SetBroker(broker.Addr(), 1).SetLeader("fixture", 0, 1),
+				"ProduceRequest":  sarama.NewMockProduceResponse(t).SetError("fixture", 0, code),
+			})
+			cfg := NewSaramaConfig()
+			cfg.Producer.Return.Successes = true
+			cfg.Net.DialTimeout = time.Second
+			cfg.Net.ReadTimeout = time.Second
+			cfg.Net.WriteTimeout = time.Second
+			producer, err := sarama.NewAsyncProducer([]string{broker.Addr()}, cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() {
+				if err := producer.Close(); err != nil {
+					t.Error(err)
+				}
+			}()
+			q := KafkaQueue{producer: producer, topic: "fixture"}
+			message := &filer_pb.EventNotification{NewEntry: &filer_pb.Entry{Name: "farmacy.csv"}}
+			if err = q.SendMessage("/fixture/farmacy.csv", message); err != nil {
+				t.Fatal(err)
+			}
+			var observed *sarama.ProducerMessage
+			select {
+			case m := <-producer.Successes():
+				if failed {
+					t.Fatal("failed produce became success")
+				}
+				observed = m
+			case e := <-producer.Errors():
+				if !failed || e.Err != code {
+					t.Fatalf("unexpected produce error: %v", e)
+				}
+				observed = e.Msg
+			case <-time.After(5 * time.Second):
+				t.Fatal("bounded produce exchange timed out")
+			}
+			key, _ := observed.Key.Encode()
+			value, _ := observed.Value.Encode()
+			expected, _ := proto.Marshal(message)
+			if string(key) != "/fixture/farmacy.csv" || !bytes.Equal(value, expected) || observed.Topic != "fixture" {
+				t.Fatal("notification key or protobuf changed")
+			}
+			count := 0
+			for _, exchange := range broker.History() {
+				switch request := exchange.Request.(type) {
+				case *sarama.ProduceRequest:
+					count++
+					if request.Version != 5 || request.RequiredAcks != sarama.WaitForLocal || request.Timeout != 10000 {
+						t.Fatalf("unexpected wire profile: %#v", request)
+					}
+				case *sarama.ApiVersionsRequest:
+					t.Fatal("unexpected broker version negotiation")
+				}
+			}
+			if count != 1 {
+				t.Fatalf("expected exactly one produce request, got %d", count)
+			}
+		})
+	}
+}
