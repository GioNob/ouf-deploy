{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "levels",
    "governedElsewhere",
    "docker",
    "dockerSocket",
    "stopTimeoutSeconds",
    "inventoryTimeoutSeconds",
    "receipts",
    "incidents",
    "bootRetryDelaysSeconds"
  ],
  "properties": {
    "schema": {
      "const": "ouf.platform-restart-profile.v1"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeoutSeconds",
          "containers"
        ],
        "properties": {
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "containers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "containerName",
                "readiness"
              ],
              "properties": {
                "containerName": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
                  "allOf": [
                    {
                      "not": {
                        "pattern": "[Rr][Ee][Tt][Aa][Ii][Nn][Ee][Dd]|[Rr][Ee][Tt][Ii][Rr][Ee][Dd]|[Bb][Ee][Ff][Oo][Rr][Ee]-"
                      }
                    }
                  ]
                },
                "readiness": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "stableSeconds"
                      ],
                      "properties": {
                        "type": {
                          "const": "running"
                        },
                        "stableSeconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "const": "healthy"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "network",
                        "port",
                        "timeoutSeconds"
                      ],
                      "properties": {
                        "type": {
                          "const": "tcp"
                        },
                        "network": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "timeoutSeconds": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 86400
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "governedElsewhere": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dockerSocket": {
      "type": "string",
      "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
    },
    "stopTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "inventoryTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "receipts": {
      "type": "string",
      "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
    },
    "incidents": {
      "type": "string",
      "pattern": "^(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+)+$"
    },
    "bootRetryDelaysSeconds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      },
      "maxItems": 5,
      "uniqueItems": true
    }
  }
}
