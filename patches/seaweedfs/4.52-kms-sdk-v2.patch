+		return nil, nil
+	})
+	ctx := context.Background()
+	for _, req := range []*seaweedkms.GenerateDataKeyRequest{nil, {}, {KeyID: "key", KeySpec: "unknown"}} {
+		if _, err := p.GenerateDataKey(ctx, req); err == nil {
+			t.Fatal("invalid generate accepted")
+		}
+	}
+	for _, req := range []*seaweedkms.DescribeKeyRequest{nil, {}} {
+		if _, err := p.DescribeKey(ctx, req); err == nil {
+			t.Fatal("invalid describe accepted")
+		}
+	}
+	for _, blob := range [][]byte{nil, []byte("bad json"), []byte(`{"provider":"other","key_id":"key","ciphertext":"YQ=="}`), []byte(`{"provider":"aws","key_id":"key","ciphertext":"*"}`)} {
+		if _, err := p.Decrypt(ctx, &seaweedkms.DecryptRequest{CiphertextBlob: blob}); err == nil {
+			t.Fatal("invalid decrypt accepted")
+		}
+	}
+	if _, err := p.Decrypt(ctx, nil); err == nil {
+		t.Fatal("nil decrypt accepted")
+	}
+	if _, err := p.GetKeyID(ctx, ""); err == nil {
+		t.Fatal("empty alias accepted")
+	}
+}
