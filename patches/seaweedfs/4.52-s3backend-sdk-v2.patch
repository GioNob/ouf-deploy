+func TestS3BackendClientHasExplicitBindingAndOneAttempt(t *testing.T) {
+	client, err := createSession("fixture-id", "fixture-secret", "eu-west-1", "https://fixture.invalid", true, httpOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s3Client, ok := client.(*s3.Client)
+	if !ok {
+		t.Fatalf("unexpected client type %T", client)
+	}
+	o := s3Client.Options()
+	creds, err := o.Credentials.Retrieve(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if o.Region != "eu-west-1" || !o.UsePathStyle || o.RetryMaxAttempts != 1 || o.BaseEndpoint == nil || *o.BaseEndpoint != "https://fixture.invalid" {
+		t.Fatalf("unexpected client binding: region=%q path=%t attempts=%d endpoint=%v", o.Region, o.UsePathStyle, o.RetryMaxAttempts, o.BaseEndpoint)
+	}
+	if creds.AccessKeyID != "fixture-id" || creds.SecretAccessKey != "fixture-secret" {
+		t.Fatal("the client did not retain the explicit static identity")
+	}
+}
