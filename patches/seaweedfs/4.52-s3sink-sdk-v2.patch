+func TestS3SinkMultipartSuccessAndPartFailure(t *testing.T) {
+	for _, fail := range []bool{false, true} {
+		t.Run(fmt.Sprint(fail), func(t *testing.T) {
+			content := bytes.Repeat([]byte("x"), 6*1024*1024)
+			sum := md5.Sum(content)
+			calls := map[string]int{}
+			var mu sync.Mutex
+			sink := sdkSink(t, func(r *http.Request) (*http.Response, error) {
+				mu.Lock()
+				defer mu.Unlock()
+				q := r.URL.Query()
+				op := ""
+				switch {
+				case r.Method == "POST" && q.Has("uploads"):
+					op = "create"
+				case r.Method == "PUT" && q.Get("partNumber") != "":
+					op = "part" + q.Get("partNumber")
+				case r.Method == "POST" && q.Get("uploadId") != "":
+					op = "complete"
+				case r.Method == "DELETE" && q.Get("uploadId") != "":
+					op = "abort"
+				default:
+					t.Fatalf("unexpected multipart request: %s %s", r.Method, r.URL)
+				}
+				calls[op]++
+				if r.Header.Get("Content-Md5") != "" {
+					t.Fatal("whole-object MD5 used for multipart")
+				}
+				if strings.HasPrefix(op, "part") && !checksumPresent(r) {
+					t.Fatal("part checksum disabled")
+				}
+				if r.Body != nil {
+					if _, err := io.Copy(io.Discard, r.Body); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if fail && op == "part1" {
+					return fixtureResponse(r, 503, `<Error><Code>ServiceUnavailable</Code><Message>ambiguous fixture</Message></Error>`), nil
+				}
+				switch op {
+				case "create":
+					return fixtureResponse(r, 200, `<InitiateMultipartUploadResult><Bucket>bucket</Bucket><Key>key</Key><UploadId>fixture-upload</UploadId></InitiateMultipartUploadResult>`), nil
+				case "complete":
+					return fixtureResponse(r, 200, `<CompleteMultipartUploadResult><Bucket>bucket</Bucket><Key>key</Key><ETag>fixture-etag</ETag></CompleteMultipartUploadResult>`), nil
+				default:
+					return fixtureResponse(r, 200, ""), nil
+				}
+			})
+			err := sink.CreateEntry("/key", &filer_pb.Entry{Content: content, Attributes: &filer_pb.FuseAttributes{FileSize: uint64(len(content)), Md5: sum[:]}}, nil)
+			if (err != nil) != fail || calls["create"] != 1 || calls["part1"] != 1 {
+				t.Fatalf("err=%v calls=%v", err, calls)
+			}
+			if fail {
+				if calls["complete"] != 0 || calls["abort"] != 1 {
+					t.Fatalf("failed upload finalized or cleanup lost: %v", calls)
+				}
+			} else {
+				if calls["part2"] != 1 || calls["complete"] != 1 || calls["abort"] != 0 {
+					t.Fatalf("multipart mismatch: %v", calls)
+				}
+			}
+		})
+	}
+}
