{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/gateway/route-binding-v1.json",
  "title": "OUF Route Binding v1",
  "type": "object",
  "required": [
    "routeId",
    "capabilityId",
    "sourceId",
    "direction",
    "backendBinding"
  ],
  "properties": {
    "routeId": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": [
        "string",
        "null"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "northbound",
        "southbound"
      ]
    },
    "extractionProfileRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestContract": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "mediaType": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "backendBinding": {
      "type": "object",
      "required": [
        "service",
        "operation"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "timeout": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "processingProfile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "etlPipeline": {
          "type": [
            "string",
            "null"
          ]
        },
        "semanticProfile": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetDataProduct": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "APPROVED",
        "ACTIVE",
        "DISABLED",
        "SUPERSEDED",
        null
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Urban API Gateway v1.2"
  ],
  "x-ouf-scope-control": "Gateway boundary/runtime contracts only. No Query Complexity Governor, fine-grained data authorization, Durable ACK authority, schema-drift classification, ETL, semantic processing, Object Resolution, UDP materialization, THS decision logic or MCP Server implementation.",
  "x-ouf-invariants": [
    "active PULL route requires resolvable sourceId, extractionProfileId/version, endpoint/backend binding and credential reference when required",
    "route binding never authorizes semantic reinterpretation"
  ]
}
