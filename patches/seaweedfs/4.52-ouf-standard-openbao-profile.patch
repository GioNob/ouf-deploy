+package kms
+
+import (
+	"errors"
+	"github.com/seaweedfs/seaweedfs/weed/util"
+	"testing"
+)
+
+func TestOUFStandardProfileChecksAllProviderDeclarations(t *testing.T) {
+	for _, provider := range []string{"openbao", "vault", " OpenBao ", "VAULT"} {
+		for _, field := range []string{"provider", "type", "providers"} {
+			t.Run(provider+"/"+field, func(t *testing.T) {
+				config := map[string]interface{}{field: provider}
+				if field == "providers" {
+					config[field] = map[string]interface{}{"ordinary-instance": map[string]interface{}{"type": provider}}
+				}
+				if err := ValidateOUFStandardConfig(config); !errors.Is(err, ErrOUFUnsupportedKMSProvider) {
+					t.Fatalf("got %v", err)
+				}
+			})
+		}
+	}
+	for _, config := range []interface{}{nil, "bad", map[string]interface{}{"providers": []string{"vault"}}, map[string]interface{}{"providers": map[string]interface{}{"bad": "vault"}}, map[string]interface{}{"providers": map[string]interface{}{"bad": map[string]interface{}{"type": false}}}} {
+		if err := ValidateOUFStandardConfig(config); err == nil {
+			t.Fatalf("malformed KMS accepted: %#v", config)
+		}
+	}
+	config := map[string]interface{}{"providers": map[string]interface{}{"vault": map[string]interface{}{"type": "local", "secret": "openbao"}}}
+	if err := ValidateOUFStandardConfig(config); err != nil {
+		t.Fatalf("supported actual type rejected: %v", err)
+	}
+	if err := ValidateOUFStandardConfig(map[string]interface{}{}); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestOUFStandardLoaderDeniedWithoutCreatingOrProbingKMS(t *testing.T) {
+	prior := globalKMSManager
+	globalKMSManager = nil
+	defer func() { globalKMSManager = prior }()
+	for _, provider := range []string{"openbao", "vault"} {
+		config := map[string]interface{}{"providers": map[string]interface{}{"excluded": map[string]interface{}{"type": provider}}}
+		loader := NewConfigLoader(&directConfigAdapter{config: map[string]interface{}{"kms": config}})
+		if globalKMSManager != nil {
+			t.Fatal("constructor created global manager before preflight")
+		}
+		for _, call := range []func() error{loader.LoadConfigurations, loader.ValidateConfiguration, func() error { return LoadKMSFromConfig(config) }} {
+			if err := call(); !errors.Is(err, ErrOUFUnsupportedKMSProvider) {
+				t.Fatalf("got %v", err)
+			}
+			if globalKMSManager != nil {
+				t.Fatal("denied config created global KMS state")
+			}
+		}
+	}
+}
+
+type oufClosingProvider struct {
+	*countingKMSProvider
+	closed int
+}
+
+func (p *oufClosingProvider) Close() error { p.closed++; return nil }
+func TestOUFStandardDirectProviderAPIsRejectBeforeReplacementOrFactory(t *testing.T) {
+	for _, provider := range []string{"openbao", "vault", "VAULT"} {
+		t.Run(provider, func(t *testing.T) {
+			old := &oufClosingProvider{countingKMSProvider: newCountingKMSProvider()}
+			km := &KMSManager{providers: map[string]KMSProvider{"kept": old}, configs: map[string]*KMSConfig{"kept": {Provider: "local"}}, bucketKMS: map[string]string{"bucket": "kept"}, defaultKMS: "kept"}
+			oldConfig := km.configs["kept"]
+			if err := km.AddKMSProvider("kept", &KMSConfig{Provider: provider}); !errors.Is(err, ErrOUFUnsupportedKMSProvider) {
+				t.Fatalf("got %v", err)
+			}
+			if old.closed != 0 || km.providers["kept"] != old || km.configs["kept"] != oldConfig || km.defaultKMS != "kept" || km.bucketKMS["bucket"] != "kept" {
+				t.Fatal("denied provider changed retained state")
+			}
+			registry := NewProviderRegistry()
+			calls := 0
+			registry.RegisterProvider(provider, func(util.Configuration) (KMSProvider, error) { calls++; return old, nil })
+			if _, err := registry.GetProvider(provider, nil); !errors.Is(err, ErrOUFUnsupportedKMSProvider) {
+				t.Fatalf("got %v", err)
+			}
+			registry.instances[provider] = old
+			if _, err := registry.GetProvider(provider, nil); !errors.Is(err, ErrOUFUnsupportedKMSProvider) {
+				t.Fatalf("cached provider bypassed denial: %v", err)
+			}
+			if calls != 0 || old.closed != 0 {
+				t.Fatal("denied provider invoked factory/close")
+			}
+		})
+	}
+}
