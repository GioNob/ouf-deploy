+// The volume HTTP write protocol is multipart. Store the part bytes, not the
+// multipart envelope, so the real GET path must return exactly the PUT body.
+func startContentTypeVolume(t *testing.T) *fakeVolumeServer {
+	t.Helper()
+	volume := &fakeVolumeServer{stored: map[string][]byte{}}
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		fid := strings.TrimPrefix(r.URL.Path, "/")
+		if r.Method == http.MethodGet || r.Method == http.MethodHead {
+			volume.mu.Lock()
+			body, ok := volume.stored[fid]
+			volume.mu.Unlock()
+			if !ok {
+				http.NotFound(w, r)
+				return
+			}
+			w.Header().Set("Content-Length", fmt.Sprint(len(body)))
+			if r.Method == http.MethodGet {
+				w.Write(body)
+			}
+			return
+		}
+		reader, err := r.MultipartReader()
+		if err != nil {
+			http.Error(w, err.Error(), 400)
+			return
+		}
+		part, err := reader.NextPart()
+		if err != nil {
+			http.Error(w, err.Error(), 400)
+			return
+		}
+		body, err := io.ReadAll(io.LimitReader(part, 1024*1024))
+		if err != nil {
+			http.Error(w, err.Error(), 400)
+			return
+		}
+		volume.mu.Lock()
+		volume.stored[fid] = body
+		volume.mu.Unlock()
+		w.WriteHeader(http.StatusCreated)
+		fmt.Fprintf(w, `{"size":%d}`, len(body))
+	}))
+	t.Cleanup(server.Close)
+	volume.httpAddr = strings.TrimPrefix(server.URL, "http://")
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	grpcServer := grpc.NewServer()
+	volume_server_pb.RegisterVolumeServerServer(grpcServer, volume)
+	go grpcServer.Serve(listener)
+	t.Cleanup(grpcServer.Stop)
+	volume.grpcPort = uint32(listener.Addr().(*net.TCPAddr).Port)
+	return volume
+}
+
+// Keep the real FilerStoreWrapper in the RPC persistence path: a mock that
+// only retains the outgoing protobuf misses MIME normalization on disk writes.
+type contentTypeStore struct {
+	filer.FilerStore
+	backend *ambiguousPutFiler
+}
+
+func (*contentTypeStore) GetName() string { return "content-type-regression" }
+func (s *contentTypeStore) InsertEntry(ctx context.Context, entry *filer.Entry) error {
+	data, err := proto.Marshal(entry.ToProtoEntry())
+	if err != nil {
+		return err
+	}
+	persisted := new(filer_pb.Entry)
+	if err := proto.Unmarshal(data, persisted); err != nil {
+		return err
+	}
+	s.backend.mu.Lock()
+	defer s.backend.mu.Unlock()
+	s.backend.entries[string(entry.FullPath)] = persisted
+	return nil
+}
+func (s *contentTypeStore) FindEntry(ctx context.Context, path util.FullPath) (*filer.Entry, error) {
+	s.backend.mu.Lock()
+	defer s.backend.mu.Unlock()
+	entry := s.backend.entries[string(path)]
+	if entry == nil {
+		return nil, filer_pb.ErrNotFound
+	}
+	return filer.FromPbEntry("/buckets/b", proto.Clone(entry).(*filer_pb.Entry)), nil
+}
+
+type contentTypeFiler struct {
+	*ambiguousPutFiler
+	wrapper *filer.FilerStoreWrapper
+}
+
+// Real volume IDs have a canonical representation; the generic upload-only
+// fixture returns padded IDs, which would differ after chunk serialization.
+func (f *contentTypeFiler) AssignVolume(ctx context.Context, req *filer_pb.AssignVolumeRequest) (*filer_pb.AssignVolumeResponse, error) {
+	response, err := f.ambiguousPutFiler.AssignVolume(ctx, req)
+	if err != nil {
+		return nil, err
+	}
+	id, err := needle.ParseFileIdFromString(response.FileId)
+	if err != nil {
+		return nil, err
+	}
+	response.FileId = id.String()
+	return response, nil
+}
+
+func (f *contentTypeFiler) CreateEntry(ctx context.Context, req *filer_pb.CreateEntryRequest) (*filer_pb.CreateEntryResponse, error) {
+	if err := f.wrapper.InsertEntry(ctx, filer.FromPbEntry(req.Directory, req.Entry)); err != nil {
+		return nil, err
+	}
+	return &filer_pb.CreateEntryResponse{}, nil
+}
