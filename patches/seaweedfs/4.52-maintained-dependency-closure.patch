+package repl_util
+
+import (
+	"errors"
+	"github.com/seaweedfs/seaweedfs/weed/kms"
+	"github.com/spf13/viper"
+	"testing"
+)
+
+func TestOUFStandardSSERejectsBeforeFilerAndCachedInitialization(t *testing.T) {
+	oldConfig := viper.Get("kms")
+	oldInitialized := sseInitialized
+	defer func() { viper.Set("kms", oldConfig); sseInitialized = oldInitialized }()
+	for _, provider := range []string{"openbao", "vault"} {
+		for _, initialized := range []bool{false, true} {
+			viper.Set("kms", map[string]interface{}{"providers": map[string]interface{}{"excluded": map[string]interface{}{"type": provider}}})
+			sseInitialized = initialized
+			// A nil filer cannot perform any remote operation; if the guard is late,
+			// SSE initialization panics instead of returning the profile denial.
+			err := InitializeSSEForReplication(nil)
+			if !errors.Is(err, kms.ErrOUFUnsupportedKMSProvider) {
+				t.Fatalf("provider=%s initialized=%v error=%v", provider, initialized, err)
+			}
+			if sseInitialized != initialized {
+				t.Fatal("denied config changed SSE initialized state")
+			}
+		}
+	}
+}
