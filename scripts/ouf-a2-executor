#!/usr/bin/python3 -I
"""The only sudoers command. All caller data arrives on a bounded stdin."""
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path("/opt/ouf-a2")
if __name__ == "__main__":
    # Hold the shared installation lock until process exit, including all imports.
    import fcntl
    try:
        installation = os.open(ROOT.parent, os.O_DIRECTORY)
        fcntl.flock(installation, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        sys.exit("INSTALLATION_LOCK_UNAVAILABLE")
sys.path.insert(0, str(ROOT / "lib"))
from mandate import Held, authorize, github_reader, need, validate
from store import read, trusted
from pipeline import Cutover
from module_operation import ModuleRelease
from gateway_operation import GatewayRelease


def dispatch(req, cfg, state, get, source_get=None, *, token=None):
    review = authorize(req, cfg, get, state)
    if req.get("operation") == "semantic-database-migration":
        return Cutover(cfg, state, req).database_operation(review)
    if req.get("operation") == "module-release":
        return ModuleRelease(cfg, state, req).execute(review)
    if req.get("operation") == "gateway-release":
        return GatewayRelease(cfg, state, req).execute(review, token)
    return Cutover(cfg, state, req, source_get).execute(review)


def main():
    import fcntl
    need(os.geteuid() == 0 and sys.flags.isolated and len(sys.argv) == 1, "ROOT_ENTRYPOINT_ONLY")
    os.umask(0o077)
    os.chdir("/")
    os.environ.clear()
    os.environ.update(PATH="/usr/sbin:/usr/bin:/sbin:/bin", LC_ALL="C")
    cfg = read(ROOT / "profile.json")
    raw = sys.stdin.buffer.read(8193)
    need(0 < len(raw) <= 8192, "REQUEST_LIMIT")
    envelope = json.loads(raw)
    need(set(envelope) == {"request", "token"}, "REQUEST_FIELDS")
    req = envelope["request"]
    validate(req, cfg)
    with trusted(ROOT / "lock", private=True).open("rb") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        token = envelope["token"]
        source_get = None
        image_key = "nextSuccessorImage" if req.get("release") == "next" else "successorImage"
        if req.get("direction") == "forward" and req["phase"] == "plan" and image_key in cfg:
            source_get = github_reader(cfg[image_key]["ci"]["repository"], token)
        response = dispatch(req, cfg, ROOT / "state", github_reader(cfg["repository"], token), source_get, token=token)
    print(json.dumps(response, separators=(",", ":")))


def public_error(error):
    if isinstance(error, Held):
        return " ".join(filter(None, (str(error), getattr(error, "public_context", None))))
    entry = Path(__file__).resolve()
    lib = ROOT / "lib"
    tb = error.__traceback__
    location = entry.name
    while tb:
        source = Path(tb.tb_frame.f_code.co_filename).resolve()
        if source == entry or source.is_relative_to(lib):
            location = f"{source.name}:{tb.tb_lineno}"
        tb = tb.tb_next
    return f"A2_EVIDENCE_UNPROVEN/{type(error).__name__}@{location}"


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        # Neither arbitrary API responses nor subprocess diagnostics are public.
        print(public_error(error), file=sys.stderr)
        sys.exit(1)
