diff --git a/test/s3/iam/s3_fixture_v2.go b/test/s3/iam/s3_fixture_v2.go
new file mode 100644
index 0000000..0df93f9
--- /dev/null
+++ b/test/s3/iam/s3_fixture_v2.go
@@ -0,0 +1,38 @@
+package iam
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+)
+
+// newIAMFixtureS3Client preserves the local IAM/STS test endpoint contract.
+// The test owns recovery: a failed or ambiguous request is returned once.
+func newIAMFixtureS3Client(endpoint, accessKey, secretKey, sessionToken string) *s3.Client {
+	return s3.NewFromConfig(aws.Config{
+		Region: "us-east-1",
+		Credentials: aws.CredentialsProviderFunc(func(context.Context) (aws.Credentials, error) {
+			if accessKey == "" || secretKey == "" {
+				return aws.Credentials{}, errors.New("fixture static credentials require both access key and secret key")
+			}
+			return aws.Credentials{AccessKeyID: accessKey, SecretAccessKey: secretKey, SessionToken: sessionToken}, nil
+		}),
+		HTTPClient:                 &http.Client{Timeout: 30 * time.Second},
+		Retryer:                    func() aws.Retryer { return aws.NopRetryer{} },
+		RequestChecksumCalculation: aws.RequestChecksumCalculationWhenSupported,
+		ResponseChecksumValidation: aws.ResponseChecksumValidationWhenSupported,
+	}, func(o *s3.Options) {
+		o.BaseEndpoint = aws.String(endpoint)
+		o.UsePathStyle = true
+	})
+}
+
+// A test context is cancelled before t.Cleanup callbacks. Cleanup therefore
+// gets an independent, finite context; it does not renew any runtime budget.
+func iamFixtureCleanupContext() (context.Context, context.CancelFunc) {
+	return context.WithTimeout(context.Background(), 30*time.Second)
+}
diff --git a/test/s3/iam/s3_fixture_v2_test.go b/test/s3/iam/s3_fixture_v2_test.go
new file mode 100644
index 0000000..8c6f261
--- /dev/null
+++ b/test/s3/iam/s3_fixture_v2_test.go
@@ -0,0 +1,143 @@
+package iam
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/smithy-go"
+	"github.com/stretchr/testify/require"
+)
+
+type iamFixtureTransport func(*http.Request) (*http.Response, error)
+
+func (f iamFixtureTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func fixtureResponse(r *http.Request, status int, body string) *http.Response {
+	return &http.Response{StatusCode: status, Header: http.Header{"Content-Type": {"application/xml"}},
+		Body: io.NopCloser(strings.NewReader(body)), Request: r}
+}
+
+func fixtureClientWithTransport(rt iamFixtureTransport) *s3.Client {
+	o := newIAMFixtureS3Client("http://localhost:8333", "fixture-key", "fixture-secret", "fixture-session").Options()
+	o.HTTPClient = &http.Client{Transport: rt, Timeout: 30 * time.Second}
+	return s3.New(o)
+}
+
+func TestIAMFixtureS3V2Contract(t *testing.T) {
+	o := newIAMFixtureS3Client("http://localhost:8333", "key", "secret", "token").Options()
+	require.Equal(t, "us-east-1", o.Region)
+	require.True(t, o.UsePathStyle)
+	require.Equal(t, "http://localhost:8333", aws.ToString(o.BaseEndpoint))
+	require.Equal(t, 1, o.Retryer.MaxAttempts())
+	require.Equal(t, 30*time.Second, o.HTTPClient.(*http.Client).Timeout)
+	require.Equal(t, aws.RequestChecksumCalculationWhenSupported, o.RequestChecksumCalculation)
+	require.Equal(t, aws.ResponseChecksumValidationWhenSupported, o.ResponseChecksumValidation)
+	calls := 0
+	client := fixtureClientWithTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		require.Equal(t, "PUT", r.Method)
+		require.Equal(t, "http", r.URL.Scheme)
+		require.Equal(t, "localhost:8333", r.URL.Host)
+		require.Equal(t, "/fixture-bucket/a%20b/%C3%A8.txt", r.URL.EscapedPath())
+		require.Equal(t, "fixture-session", r.Header.Get("X-Amz-Security-Token"))
+		require.Contains(t, r.Header.Get("Authorization"), "/us-east-1/s3/aws4_request")
+		require.Contains(t, r.Header.Get("Authorization"), "Credential=fixture-key/")
+		require.Equal(t, "2zEPiw==", r.Header.Get("X-Amz-Checksum-Crc32"))
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		require.Equal(t, "fixture-body", string(body))
+		return fixtureResponse(r, http.StatusOK, ""), nil
+	})
+	_, err := client.PutObject(t.Context(), &s3.PutObjectInput{Bucket: aws.String("fixture-bucket"),
+		Key: aws.String("a b/è.txt"), Body: strings.NewReader("fixture-body")})
+	require.NoError(t, err)
+	require.Equal(t, 1, calls)
+}
+
+func TestIAMFixtureS3V2FailureBudget(t *testing.T) {
+	for _, status := range []int{http.StatusForbidden, http.StatusServiceUnavailable} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			calls := 0
+			client := fixtureClientWithTransport(func(r *http.Request) (*http.Response, error) {
+				calls++
+				return fixtureResponse(r, status, "<Error><Code>AccessDenied</Code><Message>fixture denial</Message></Error>"), nil
+			})
+			_, err := client.ListBuckets(t.Context(), &s3.ListBucketsInput{})
+			require.Error(t, err)
+			var apiErr smithy.APIError
+			require.ErrorAs(t, err, &apiErr)
+			require.Equal(t, "AccessDenied", apiErr.ErrorCode())
+			require.Equal(t, 1, calls, "SDK retries must not multiply the fixture's recovery budget")
+		})
+	}
+}
+
+func TestIAMFixtureS3V2Cancellation(t *testing.T) {
+	client := fixtureClientWithTransport(func(r *http.Request) (*http.Response, error) {
+		t.Fatal("cancelled request must not reach the transport")
+		return nil, errors.New("unexpected transport")
+	})
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	_, err := client.ListBuckets(ctx, &s3.ListBucketsInput{})
+	require.ErrorIs(t, err, context.Canceled)
+}
+
+func TestIAMFixtureS3V2CleanupDeadline(t *testing.T) {
+	ctx, cancel := iamFixtureCleanupContext()
+	defer cancel()
+	deadline, ok := ctx.Deadline()
+	require.True(t, ok)
+	require.Greater(t, time.Until(deadline), 29*time.Second)
+	require.LessOrEqual(t, time.Until(deadline), 30*time.Second)
+}
+
+func TestIAMFixtureS3V2RejectsPartialCredentials(t *testing.T) {
+	for _, creds := range []struct{ access, secret, token string }{
+		{"", "", ""}, {"key", "", ""}, {"", "secret", ""}, {"", "", "token"},
+	} {
+		o := newIAMFixtureS3Client("http://localhost:8333", creds.access, creds.secret, creds.token).Options()
+		o.HTTPClient = &http.Client{Transport: iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+			t.Fatal("partial credentials must fail before transport")
+			return nil, errors.New("unexpected transport")
+		})}
+		_, err := s3.New(o).ListBuckets(t.Context(), &s3.ListBucketsInput{})
+		require.Error(t, err)
+		require.Contains(t, err.Error(), "require both access key and secret key")
+	}
+}
+
+func TestIAMFixtureRawQueryV2Signing(t *testing.T) {
+	// callIAMAPI creates a bounded http.Client using the default transport.
+	// Replace only the transport: no listener or remote IAM endpoint is used.
+	originalTransport := http.DefaultTransport
+	t.Cleanup(func() { http.DefaultTransport = originalTransport })
+	t.Setenv("STS_TEST_ACCESS_KEY", "fixture-iam-key")
+	t.Setenv("STS_TEST_SECRET_KEY", "fixture-iam-secret")
+	calls := 0
+	http.DefaultTransport = iamFixtureTransport(func(r *http.Request) (*http.Response, error) {
+		calls++
+		require.Equal(t, "POST", r.Method)
+		require.Equal(t, "http://localhost:8333/", r.URL.String())
+		require.Equal(t, "application/x-www-form-urlencoded", r.Header.Get("Content-Type"))
+		require.Contains(t, r.Header.Get("Authorization"), "/us-east-1/iam/aws4_request")
+		require.Contains(t, r.Header.Get("Authorization"), "Credential=fixture-iam-key/")
+		body, err := io.ReadAll(r.Body)
+		require.NoError(t, err)
+		require.Equal(t, "Action=CreateServiceAccount&Description=a%2Bb+fixture&ParentUser=fixture", string(body))
+		return fixtureResponse(r, http.StatusOK, "<CreateServiceAccountResponse/>"), nil
+	})
+	resp, err := callIAMAPI(t, "CreateServiceAccount", url.Values{"ParentUser": {"fixture"}, "Description": {"a+b fixture"}})
+	require.NoError(t, err)
+	defer resp.Body.Close()
+	require.Equal(t, http.StatusOK, resp.StatusCode)
+	require.Equal(t, 1, calls)
+}
