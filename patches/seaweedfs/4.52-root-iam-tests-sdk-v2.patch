+			}
+			body := fmt.Sprintf(`<%sResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/"><%sResult>%s</%sResult><ResponseMetadata><RequestId>fixture</RequestId></ResponseMetadata></%sResponse>`, action, action, result, action, action)
+			return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"text/xml"}}, Body: io.NopCloser(strings.NewReader(body)), Request: req}, nil
+		})}
+	}
+	created, err := c.CreateUser(t.Context(), &iam.CreateUserInput{UserName: aws.String("fixture-user")}, option)
+	require.NoError(t, err)
+	require.Equal(t, "fixture-user", aws.ToString(created.User.UserName))
+	listed, err := c.ListUsers(t.Context(), &iam.ListUsersInput{}, option)
+	require.NoError(t, err)
+	require.Len(t, listed.Users, 1)
+	require.Equal(t, "fixture-user", aws.ToString(listed.Users[0].UserName))
+	got, err := c.GetUser(t.Context(), &iam.GetUserInput{UserName: aws.String("fixture-user")}, option)
+	require.NoError(t, err)
+	require.Equal(t, "fixture-user", aws.ToString(got.User.UserName))
+	_, err = c.DeleteUser(t.Context(), &iam.DeleteUserInput{UserName: aws.String("fixture-user")}, option)
+	require.NoError(t, err)
+	require.Equal(t, []string{"CreateUser", "ListUsers", "GetUser", "DeleteUser"}, actions)
+}
