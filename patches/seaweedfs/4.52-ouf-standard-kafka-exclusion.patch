-			eventTypes: []string{"create", "delete", "update"},
-			notification: &filer_pb.EventNotification{
-				OldEntry:      &filer_pb.Entry{Name: "old.txt"},
-				NewEntry:      &filer_pb.Entry{Name: "new.txt"},
-				NewParentPath: "/new/path",
-			},
-			wantType:  "rename",
-			wantAllow: false,
-		},
-		{
