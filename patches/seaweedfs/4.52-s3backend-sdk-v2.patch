+		{name: "partial credentials", access: "id", region: "us-east-1", endpoint: "https://fixture.invalid"},
+		{name: "endpoint credentials", region: "us-east-1", endpoint: "https://user@example.invalid"},
+		{name: "endpoint query", region: "us-east-1", endpoint: "https://example.invalid?x=1"},
+		{name: "non HTTP endpoint", region: "us-east-1", endpoint: "ftp://example.invalid"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if _, err := createSession(tt.access, tt.secret, tt.region, tt.endpoint, true, httpOptions{}); err == nil {
+				t.Fatal("createSession accepted an ambiguous binding")
+			}
+		})
+	}
+}
