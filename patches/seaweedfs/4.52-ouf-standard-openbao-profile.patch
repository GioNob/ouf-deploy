@@ -0,0 +1,66 @@
+package kms
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// ErrOUFUnsupportedKMSProvider marks a configuration outside the qualified OUF
+// standard candidate. It is a hard configuration error, never a fallback signal.
+var ErrOUFUnsupportedKMSProvider = errors.New("OUF standard profile excludes OpenBao/Vault KMS")
+
+func validateOUFStandardProvider(provider string) error {
+	switch strings.ToLower(strings.TrimSpace(provider)) {
+	case "openbao", "vault":
+		return ErrOUFUnsupportedKMSProvider
+	default:
+		return nil
+	}
+}
+
+// ValidateOUFStandardConfig checks every declared provider before any provider
+// factory, existing-instance Close, health check, or identity publication. A
+// provider instance may be named "vault" when its actual type is supported; the
+// restriction concerns the provider type, not instance names or secret values.
+func ValidateOUFStandardConfig(config interface{}) error {
+	kmsMap, ok := config.(map[string]interface{})
+	if !ok {
+		return fmt.Errorf("invalid KMS configuration format")
+	}
+	// Reject explicit legacy single-provider declarations too. They must not be
+	// mistaken for an absent optional KMS configuration by a newer loader.
+	for _, field := range []string{"provider", "type"} {
+		if value, exists := kmsMap[field]; exists {
+			provider, ok := value.(string)
+			if !ok {
+				return fmt.Errorf("invalid KMS provider type")
+			}
+			if err := validateOUFStandardProvider(provider); err != nil {
+				return err
+			}
+		}
+	}
+	value, exists := kmsMap["providers"]
+	if !exists {
+		return nil
+	}
+	providers, ok := value.(map[string]interface{})
+	if !ok {
+		return fmt.Errorf("invalid KMS providers configuration")
+	}
+	for _, value := range providers {
+		config, ok := value.(map[string]interface{})
+		if !ok {
+			return fmt.Errorf("invalid KMS provider configuration")
+		}
+		provider, ok := config["type"].(string)
+		if !ok || strings.TrimSpace(provider) == "" {
+			return fmt.Errorf("invalid KMS provider type")
+		}
+		if err := validateOUFStandardProvider(provider); err != nil {
+			return err
+		}
+	}
+	return nil
+}
