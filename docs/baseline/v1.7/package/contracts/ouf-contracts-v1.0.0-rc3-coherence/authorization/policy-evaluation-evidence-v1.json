{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/authorization/policy-evaluation-evidence-v1.json",
  "title": "OUF PolicyEvaluationEvidence v1",
  "type": "object",
  "required": [
    "evaluationId",
    "timestamp",
    "subject",
    "actorType",
    "capabilityId",
    "decision",
    "reasonCode",
    "policyVersion",
    "bundleContentHash"
  ],
  "properties": {
    "evaluationId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string"
    },
    "actorType": {
      "type": "string",
      "enum": [
        "HUMAN_USER",
        "AI_AGENT",
        "MCP_SERVER",
        "SERVICE_IDENTITY",
        "EXTERNAL_SYSTEM"
      ]
    },
    "clientId": {
      "type": [
        "string",
        "null"
      ]
    },
    "delegatedVia": {
      "type": [
        "string",
        "null"
      ]
    },
    "capabilityId": {
      "type": "string"
    },
    "resourceRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "reasonCode": {
      "type": "string"
    },
    "policyVersion": {
      "type": "string"
    },
    "bundleContentHash": {
      "type": "string"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "field-level-reconciled-draft",
  "x-ouf-source-basis": [
    "Authorization & Access Control Specification v1.3"
  ],
  "x-ouf-scope-control": "Evidence contains security context, not bearer tokens, full application payloads or sensitive data."
}
