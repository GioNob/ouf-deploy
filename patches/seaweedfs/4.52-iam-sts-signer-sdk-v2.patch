diff --git a/test/s3/iam/sigv4_v2.go b/test/s3/iam/sigv4_v2.go
new file mode 100644
index 000000000..795431268
--- /dev/null
+++ b/test/s3/iam/sigv4_v2.go
@@ -0,0 +1,33 @@
+package iam
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+	"time"
+
+	awsv2 "github.com/aws/aws-sdk-go-v2/aws"
+	v4v2 "github.com/aws/aws-sdk-go-v2/aws/signer/v4"
+)
+
+type sigV4Credentials struct {
+	AccessKeyID  string
+	SecretKey    string
+	SessionToken string
+}
+
+func signSigV4Request(ctx context.Context, req *http.Request, body []byte, credentials sigV4Credentials, service, region string, signingTime time.Time) error {
+	payloadHash := sha256.Sum256(body)
+	signer := v4v2.NewSigner()
+	err := signer.SignHTTP(ctx, awsv2.Credentials{
+		AccessKeyID:     credentials.AccessKeyID,
+		SecretAccessKey: credentials.SecretKey,
+		SessionToken:    credentials.SessionToken,
+	}, req, hex.EncodeToString(payloadHash[:]), service, region, signingTime)
+	if err != nil {
+		return fmt.Errorf("failed to sign request: %w", err)
+	}
+	return nil
+}
diff --git a/test/s3/iam/sigv4_v2_test.go b/test/s3/iam/sigv4_v2_test.go
new file mode 100644
index 000000000..4d44f860c
--- /dev/null
+++ b/test/s3/iam/sigv4_v2_test.go
@@ -0,0 +1,55 @@
+package iam
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestSignSigV4RequestUsesStableSTSScopeAndBody(t *testing.T) {
+	body := []byte("Action=AssumeRole&Note=spaces+%2B+%26+%E2%98%83&Version=2011-06-15")
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, "http://127.0.0.1:8333/", strings.NewReader(string(body)))
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+
+	err = signSigV4Request(context.Background(), req, body, sigV4Credentials{
+		AccessKeyID: "AKIDEXAMPLE",
+		SecretKey:   "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
+	}, "sts", "us-east-1", time.Date(2026, time.November, 3, 12, 34, 56, 0, time.UTC))
+	require.NoError(t, err)
+
+	authorization := req.Header.Get("Authorization")
+	assert.Equal(t, "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20261103/us-east-1/sts/aws4_request, SignedHeaders=content-length;content-type;host;x-amz-date, Signature=14896a341b0f6ce3591985759f3d39f0287392981db135162bf5f06e94b6fd6e", authorization)
+	assert.Equal(t, 1, strings.Count(authorization, "host"), authorization)
+	assert.Equal(t, "20261103T123456Z", req.Header.Get("X-Amz-Date"))
+	assert.Empty(t, req.Header.Get("X-Amz-Security-Token"))
+
+	actualBody, err := io.ReadAll(req.Body)
+	require.NoError(t, err)
+	assert.Equal(t, body, actualBody)
+}
+
+func TestSignSigV4RequestIncludesTemporaryCredentialToken(t *testing.T) {
+	body := []byte("Action=AssumeRole&Version=2011-06-15")
+	req, err := http.NewRequestWithContext(context.Background(), http.MethodPost, "http://localhost:8333/", strings.NewReader(string(body)))
+	require.NoError(t, err)
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+
+	err = signSigV4Request(context.Background(), req, body, sigV4Credentials{
+		AccessKeyID:  "ASIAEXAMPLE",
+		SecretKey:    "temporary-secret",
+		SessionToken: "temporary-token",
+	}, "iam", "us-west-2", time.Date(2026, time.November, 3, 12, 34, 56, 0, time.UTC))
+	require.NoError(t, err)
+
+	authorization := req.Header.Get("Authorization")
+	assert.Contains(t, authorization, "Credential=ASIAEXAMPLE/20261103/us-west-2/iam/aws4_request")
+	assert.Contains(t, authorization, "x-amz-security-token")
+	assert.Equal(t, "temporary-token", req.Header.Get("X-Amz-Security-Token"))
+}
