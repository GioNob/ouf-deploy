+package sub
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/seaweedfs/seaweedfs/weed/util/googleprofile"
+)
+
+func TestOUFGoogleProfileInputNeverAcknowledges(t *testing.T) {
+	q := &GooglePubSubInput{}
+	if e := q.Initialize(nil, ""); !errors.Is(e, googleprofile.ErrUnsupported) {
+		t.Fatal(e)
+	}
+	key, m, ack, nack, e := q.ReceiveMessage()
+	if key != "" || m != nil || ack != nil || nack != nil || !errors.Is(e, googleprofile.ErrUnsupported) {
+		t.Fatal("unexpected input result", e)
+	}
+}
