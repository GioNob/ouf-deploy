+func TestKMSCredentialBindingsAndTimeouts(t *testing.T) {
+	isolateCredentials(t)
+	t.Setenv("AWS_ACCESS_KEY_ID", "environment-id")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "environment-secret")
+	for _, explicit := range []bool{true, false} {
+		t.Run(fmt.Sprint(explicit), func(t *testing.T) {
+			c := fixtureConfig()
+			want := "fixture-id"
+			if !explicit {
+				c.Set("access_key", "")
+				c.Set("secret_key", "")
+				c.Set("session_token", "")
+				want = "environment-id"
+			}
+			c.Set("connect_timeout", 7)
+			c.Set("request_timeout", 19)
+			p := providerFor(t, c)
+			o := p.client.Options()
+			creds, err := o.Credentials.Retrieve(context.Background())
+			if err != nil {
+				t.Fatal(err)
+			}
+			if creds.AccessKeyID != want {
+				t.Fatal("wrong credential source")
+			}
+			if explicit && creds.SessionToken != "fixture-session" {
+				t.Fatal("session token lost")
+			}
+			tr, ok := o.HTTPClient.(*awshttp.BuildableClient)
+			if !ok || tr.GetTimeout() != 19*time.Second || tr.GetDialer().Timeout != 7*time.Second || o.RetryMaxAttempts != 1 || o.Region != "us-east-1" {
+				t.Fatal("binding or bounded transport lost")
+			}
+		})
+	}
+}
