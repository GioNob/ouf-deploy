+func TestKMSWrappedAPIErrorAndTransportFailure(t *testing.T) {
+	p := &AWSKMSProvider{}
+	wrapped := fmt.Errorf("outer: %w", &smithy.GenericAPIError{Code: "AccessDeniedException", Message: "fixture"})
+	var mapped *seaweedkms.KMSError
+	if !errors.As(p.convertAWSError(wrapped, "key"), &mapped) || mapped.Code != seaweedkms.ErrCodeAccessDenied {
+		t.Fatal("wrapped API error lost")
+	}
+	calls := 0
+	p = sdkFixture(t, func(r *http.Request) (*http.Response, error) {
+		calls++
+		return nil, fmt.Errorf("fixture transport failure")
+	})
+	_, err := p.DescribeKey(context.Background(), &seaweedkms.DescribeKeyRequest{KeyID: "key"})
+	if !errors.As(err, &mapped) || mapped.Code != seaweedkms.ErrCodeKMSInternalFailure || calls != 1 {
+		t.Fatal("transport failure or single attempt lost")
+	}
+}
