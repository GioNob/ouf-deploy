+func TestS3BackendUploadIsSignedChecksummedAndNotRetried(t *testing.T) {
+	var attempts int
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		_, _ = io.Copy(io.Discard, r.Body)
+		if r.Method != http.MethodPut || r.URL.Path != "/bucket/key" {
+			t.Errorf("unexpected request %s %s", r.Method, r.URL.Path)
+		}
+		if !strings.Contains(r.Header.Get("Authorization"), "AWS4-HMAC-SHA256") {
+			t.Error("request was not signed with SigV4")
+		}
+		if !strings.Contains(r.UserAgent(), "SeaweedFS/") {
+			t.Errorf("missing SeaweedFS user-agent: %q", r.UserAgent())
+		}
+		if r.Header.Get("X-Amz-Sdk-Checksum-Algorithm") == "" && r.Header.Get("X-Amz-Checksum-Crc32") == "" && r.Trailer.Get("X-Amz-Checksum-Crc32") == "" {
+			t.Error("upload did not carry a flexible checksum")
+		}
+		w.Header().Set("Content-Type", "application/xml")
+		w.WriteHeader(http.StatusServiceUnavailable)
+		_, _ = w.Write([]byte("<Error><Code>SlowDown</Code><Message>fixture</Message></Error>"))
+	}))
+	defer server.Close()
+
+	client, err := createSession("fixture-id", "fixture-secret", "us-east-1", server.URL, true, httpOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	name := filepath.Join(t.TempDir(), "fixture.dat")
+	if err := os.WriteFile(name, []byte("fixture payload"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := uploadToS3(client, name, "bucket", "key", "STANDARD_IA", nil, 1); err == nil {
+		t.Fatal("upload unexpectedly succeeded")
+	}
+	if attempts != 1 {
+		t.Fatalf("upload attempts = %d, want 1", attempts)
+	}
+}
