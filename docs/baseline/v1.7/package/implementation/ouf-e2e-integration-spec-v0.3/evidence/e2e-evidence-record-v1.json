{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/e2e/evidence-record-v1.json",
  "title": "OUF E2E Evidence Record v1",
  "type": "object",
  "required": [
    "scenarioId",
    "executionId",
    "environment",
    "status",
    "assertions",
    "artifacts",
    "contractFreezeVersion"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "pattern": "^OUF-E2E-[0-9]{3}$"
    },
    "executionId": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_EXTERNAL",
        "BLOCKED_INTERNAL",
        "SKIPPED"
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "correlationIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contractFreezeVersion": {
      "const": "1.0.0-rc3-coherence"
    }
  },
  "additionalProperties": true
}
