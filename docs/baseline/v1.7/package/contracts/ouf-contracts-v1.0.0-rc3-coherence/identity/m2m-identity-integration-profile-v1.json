{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouf.trieste.it/contracts/identity/m2m-identity-integration-profile-v1.json",
  "title": "OUF M2M Identity Integration Profile v1",
  "description": "Scenario-neutral contract for integrating any supported OIDC/OAuth2 technical identity authority with OUF. It normalizes environment-specific token/claim details into the existing PrincipalContext without selecting IAM scenario A, B or C.",
  "type": "object",
  "required": [
    "profileId",
    "profileVersion",
    "environment",
    "trust",
    "tokenValidation",
    "principalMapping",
    "serviceIdentityPolicy",
    "status"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "profileVersion": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "trust": {
      "type": "object",
      "required": [
        "issuerRef",
        "jwksRef",
        "acceptedAudiences"
      ],
      "properties": {
        "issuerRef": {
          "type": "string",
          "minLength": 1,
          "description": "Environment binding/reference to the trusted issuer; not a hard-coded application constant."
        },
        "jwksRef": {
          "type": "string",
          "minLength": 1,
          "description": "Environment binding/reference to JWKS/discovery material."
        },
        "acceptedAudiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "tokenValidation": {
      "type": "object",
      "required": [
        "requireSignedToken",
        "requireIssuerMatch",
        "requireAudienceMatch",
        "clockSkewSeconds"
      ],
      "properties": {
        "requireSignedToken": {
          "const": true
        },
        "requireIssuerMatch": {
          "const": true
        },
        "requireAudienceMatch": {
          "const": true
        },
        "clockSkewSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedAlgorithms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "introspectionRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional environment binding when opaque-token introspection is used."
        }
      },
      "additionalProperties": true
    },
    "principalMapping": {
      "type": "object",
      "required": [
        "subjectClaim",
        "actorTypeRule",
        "clientIdClaim",
        "rolesClaim",
        "organizationsClaim"
      ],
      "properties": {
        "subjectClaim": {
          "type": "string",
          "minLength": 1,
          "description": "Configured token claim mapped to PrincipalContext.subject."
        },
        "clientIdClaim": {
          "type": "string",
          "minLength": 1,
          "description": "Configured token claim mapped to PrincipalContext.clientId."
        },
        "rolesClaim": {
          "type": [
            "string",
            "null"
          ],
          "description": "Configured claim/path mapped to PrincipalContext.externalRoleRefs."
        },
        "organizationsClaim": {
          "type": [
            "string",
            "null"
          ],
          "description": "Configured claim/path mapped to PrincipalContext.orgRefs."
        },
        "acrClaim": {
          "type": [
            "string",
            "null"
          ]
        },
        "amrClaim": {
          "type": [
            "string",
            "null"
          ]
        },
        "authTimeClaim": {
          "type": [
            "string",
            "null"
          ]
        },
        "purposeClaim": {
          "type": [
            "string",
            "null"
          ]
        },
        "domainClaim": {
          "type": [
            "string",
            "null"
          ]
        },
        "actorTypeRule": {
          "type": "object",
          "required": [
            "mode",
            "defaultActorType"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "FIXED_FOR_PROFILE",
                "CLAIM_MAPPED"
              ]
            },
            "defaultActorType": {
              "type": "string",
              "enum": [
                "SERVICE_IDENTITY",
                "EXTERNAL_SYSTEM",
                "MCP_SERVER",
                "AI_AGENT",
                "HUMAN_USER"
              ]
            },
            "claim": {
              "type": [
                "string",
                "null"
              ]
            },
            "valueMap": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "SERVICE_IDENTITY",
                  "EXTERNAL_SYSTEM",
                  "MCP_SERVER",
                  "AI_AGENT",
                  "HUMAN_USER"
                ]
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "serviceIdentityPolicy": {
      "type": "object",
      "required": [
        "clientCredentialsAllowed",
        "serviceIdentityLifecycleExternal",
        "credentialMaterialInContract"
      ],
      "properties": {
        "clientCredentialsAllowed": {
          "type": "boolean"
        },
        "serviceIdentityLifecycleExternal": {
          "const": true
        },
        "credentialMaterialInContract": {
          "const": false
        },
        "minimumScopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "scenarioDecision": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "UNRESOLVED_EXTERNAL_GATE"
        },
        "selectedScenario": {
          "type": [
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable note only; no implementation branch may depend on scenario A/B/C."
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "ACTIVE",
        "SUPERSEDED"
      ]
    }
  },
  "additionalProperties": true,
  "x-ouf-status": "scenario-neutral-integration-contract",
  "x-ouf-source-basis": [
    "Authorization & Access Control v1.3 — actor type from validated token, PrincipalContext normalization, external M2M A/B/C gate",
    "Urban API Gateway v1.2 — OIDC/OAuth2 validation, client credentials for M2M, scenario A/B/C does not alter normalized actor distinction",
    "MCP Server v1.1 — audience-bound service/delegation context propagated by Gateway; MCP does not own IAM authority"
  ],
  "x-ouf-invariants": [
    "No application module branches on scenario A/B/C.",
    "issuer/JWKS/audience/claim names are environment bindings, not hard-coded domain semantics.",
    "actorType comes from validated token/client trust configuration, never application payload.",
    "normalized output remains compatible with authorization/principal-context-v1.json.",
    "service identity provisioning/rotation remains external platform lifecycle.",
    "credential/token material is never embedded in this contract."
  ],
  "x-ouf-scope-control": "This contract does not select or configure an IAM product/realm, create a new IAM, define real issuer URLs, freeze real claim names, provision clients/secrets, or modify Gateway/Authorization/MCP ownership."
}
