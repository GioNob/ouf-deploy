+func TestNormalSDKV2RawSignerLegacyGolden(t *testing.T) {
+	req, err := http.NewRequestWithContext(t.Context(), "GET", "http://127.0.0.1:8333/bucket/a%20b?attributes", nil)
+	require.NoError(t, err)
+	req.Header.Set("X-Amz-Object-Attributes", "ETag,ObjectSize")
+	err = signNormalS3Request(t.Context(), req, time.Date(2026, 11, 3, 0, 0, 0, 0, time.UTC))
+	require.NoError(t, err)
+	// Frozen from the original v1 raw signer with the same request, credentials,
+	// time and default URI escaping. No v1 dependency is needed for this oracle.
+	require.Equal(t, "AWS4-HMAC-SHA256 Credential=admin/20261103/us-west-2/s3/aws4_request, SignedHeaders=host;x-amz-content-sha256;x-amz-date;x-amz-object-attributes, Signature=caa5f67e5701cd714893c5b58b8716d5975b0aad336aac8064513f0531914649", req.Header.Get("Authorization"))
+	require.Equal(t, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", req.Header.Get("X-Amz-Content-Sha256"))
+	require.Equal(t, "/bucket/a%20b", req.URL.EscapedPath())
+}
