diff --git a/weed/notification/aws_sqs/client.go b/weed/notification/aws_sqs/client.go
new file mode 100644
--- /dev/null
+++ b/weed/notification/aws_sqs/client.go
@@ -0,0 +1,57 @@
+package aws_sqs
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	awshttp "github.com/aws/aws-sdk-go-v2/aws/transport/http"
+	"github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/credentials"
+	"github.com/aws/aws-sdk-go-v2/service/sqs"
+	"github.com/aws/aws-sdk-go-v2/service/sqs/types"
+)
+
+// NewClient uses the maintained SDK default credential chain unless a complete
+// static credential pair is supplied. A partial pair must not select another identity.
+// SDK retries are disabled: a standard-queue send has no proven deduplication,
+// and an ambiguous result must return to the pipeline owner for reconciliation.
+// The transport bounds each request while allowing the existing 20-second long poll.
+func NewClient(ctx context.Context, accessKey, secretKey, region string) (*sqs.Client, error) {
+	if (accessKey == "") != (secretKey == "") {
+		return nil, fmt.Errorf("SQS requires both static credential fields or neither")
+	}
+	opts := []func(*config.LoadOptions) error{
+		config.WithRegion(region),
+		config.WithRetryMaxAttempts(1),
+		config.WithHTTPClient(awshttp.NewBuildableClient().WithTimeout(30 * time.Second)),
+	}
+	if accessKey != "" {
+		opts = append(opts, config.WithCredentialsProvider(credentials.NewStaticCredentialsProvider(accessKey, secretKey, "")))
+	}
+	cfg, err := config.LoadDefaultConfig(ctx, opts...)
+	if err != nil {
+		return nil, fmt.Errorf("load SQS configuration: %w", err)
+	}
+	return sqs.NewFromConfig(cfg), nil
+}
+
+type queueURLAPI interface {
+	GetQueueUrl(context.Context, *sqs.GetQueueUrlInput, ...func(*sqs.Options)) (*sqs.GetQueueUrlOutput, error)
+}
+
+func ResolveQueueURL(ctx context.Context, client queueURLAPI, queueName string) (string, error) {
+	result, err := client.GetQueueUrl(ctx, &sqs.GetQueueUrlInput{QueueName: &queueName})
+	if err != nil {
+		var missing *types.QueueDoesNotExist
+		if errors.As(err, &missing) {
+			return "", fmt.Errorf("unable to find queue %s: %w", queueName, err)
+		}
+		return "", fmt.Errorf("get queue %s url: %w", queueName, err)
+	}
+	if result == nil || result.QueueUrl == nil || *result.QueueUrl == "" {
+		return "", fmt.Errorf("queue %s returned no URL", queueName)
+	}
+	return *result.QueueUrl, nil
+}
