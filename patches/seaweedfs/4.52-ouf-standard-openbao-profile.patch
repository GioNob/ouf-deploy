+func TestOUFStandardS3BootstrapRejectsBeforeStoreAndFilerInitialization(t *testing.T) {
+	for _, field := range []string{"Config", "IamConfig"} {
+		t.Run(field, func(t *testing.T) {
+			path := writeTempIamConfig(t, `{"kms":{"providers":{"excluded":{"type":"vault"}}}}`)
+			option := &S3ApiServerOption{Filers: []pb.ServerAddress{"127.0.0.1:1"}}
+			if field == "Config" {
+				option.Config = path
+			} else {
+				option.IamConfig = path
+			}
+			server, err := NewS3ApiServerWithStore(nil, option, "invalid-store-must-not-be-initialized")
+			if server != nil || err == nil || !strings.Contains(err.Error(), "OUF standard profile excludes") {
+				t.Fatalf("bootstrap did not deny before store/filer: server=%v error=%v", server, err)
+			}
+			if len(option.AllowedOrigins) != 0 {
+				t.Fatal("denied bootstrap mutated options")
+			}
+		})
+	}
+}
+
+func TestOUFStandardS3StartupUsesValidatedBytesAndReloadRevalidates(t *testing.T) {
+	path := writeTempIamConfig(t, `{"identities":[{"name":"pinned","credentials":[{"accessKey":"PINNED","secretKey":"fixture"}],"actions":["Read"]}]}`)
+	filename, content, err := readOUFStandardS3Config(&S3ApiServerOption{Config: path})
+	if err != nil {
+		t.Fatal(err)
+	}
+	denied := []byte(`{"identities":[{"name":"denied"}],"kms":{"providers":{"excluded":{"type":"vault"}}}}`)
+	if err := os.WriteFile(path, denied, 0600); err != nil {
+		t.Fatal(err)
+	}
+	s3a := newTestS3ApiServerWithMemoryIAM(t, []*iam_pb.Identity{})
+	if err := s3a.iam.loadS3ApiConfigurationFromFileBytes(filename, content); err != nil {
+		t.Fatal(err)
+	}
+	if !hasIdentity(s3a.iam, "pinned") || hasIdentity(s3a.iam, "denied") {
+		t.Fatal("startup re-read changed file instead of using validated bytes")
+	}
+	if err := s3a.iam.loadS3ApiConfigurationFromFile(path); err == nil {
+		t.Fatal("reload accepted changed denied config")
+	}
+	if !hasIdentity(s3a.iam, "pinned") || hasIdentity(s3a.iam, "denied") {
+		t.Fatal("denied reload changed identity")
+	}
+}
