--- /dev/null
+++ b/test/s3/policy/iam_sdk_v2_test.go
@@ -0,0 +1,165 @@
+package policy
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	"github.com/aws/aws-sdk-go-v2/service/iam"
+	"github.com/aws/smithy-go"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPolicyIAMSDKV2Configuration(t *testing.T) {
+	for _, tc := range []struct{ name, accessKey, secretKey, wantAccess, wantSecret string }{
+		{"fallback", "", "", "admin", "admin"},
+		{"configured", "fixture-key", "fixture-secret", "fixture-key", "fixture-secret"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv("AWS_ACCESS_KEY_ID", tc.accessKey)
+			t.Setenv("AWS_SECRET_ACCESS_KEY", tc.secretKey)
+			client := newIAMClient(t, "http://127.0.0.1:8333")
+			o := client.Options()
+			require.Equal(t, "us-east-1", o.Region)
+			require.Equal(t, "http://127.0.0.1:8333", aws.ToString(o.BaseEndpoint))
+			require.Equal(t, 1, o.RetryMaxAttempts)
+			httpClient, ok := o.HTTPClient.(*http.Client)
+			require.True(t, ok)
+			require.Equal(t, 30*time.Second, httpClient.Timeout)
+			creds, err := o.Credentials.Retrieve(t.Context())
+			require.NoError(t, err)
+			require.Equal(t, tc.wantAccess, creds.AccessKeyID)
+			require.Equal(t, tc.wantSecret, creds.SecretAccessKey)
+		})
+	}
+}
+
+// The in-memory transport validates IAM Query serialization and XML response
+// handling. It does not claim a live policy evaluation or authority grant.
+func TestPolicyIAMSDKV2WireAndModels(t *testing.T) {
+	t.Setenv("AWS_ACCESS_KEY_ID", "fixture-key")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "fixture-secret")
+	client := newIAMClient(t, "http://127.0.0.1:8333")
+	const policyName = "fixture-policy"
+	const policyArn = "arn:aws:iam:::policy/fixture-policy"
+	const userName = "fixture-user"
+	const policyDoc = `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":"s3:GetObject","Resource":"arn:aws:s3:::fixture/*"}]}`
+	var actions []string
+	option := func(o *iam.Options) {
+		o.HTTPClient = &http.Client{Timeout: 30 * time.Second, Transport: policyRoundTripper(func(req *http.Request) (*http.Response, error) {
+			require.Equal(t, http.MethodPost, req.Method)
+			require.Equal(t, "127.0.0.1:8333", req.URL.Host)
+			require.Equal(t, "/", req.URL.Path)
+			require.Contains(t, req.Header.Get("Content-Type"), "application/x-www-form-urlencoded")
+			require.Contains(t, req.Header.Get("Authorization"), "Credential=fixture-key/")
+			require.Contains(t, req.Header.Get("Authorization"), "/us-east-1/iam/aws4_request")
+			body, err := io.ReadAll(req.Body)
+			require.NoError(t, err)
+			form, err := url.ParseQuery(string(body))
+			require.NoError(t, err)
+			require.Equal(t, "2010-05-08", form.Get("Version"))
+			action := form.Get("Action")
+			actions = append(actions, action)
+			result := ""
+			switch action {
+			case "CreateUser":
+				require.Equal(t, userName, form.Get("UserName"))
+				result = "<User><UserName>fixture-user</UserName></User>"
+			case "CreateAccessKey":
+				require.Equal(t, userName, form.Get("UserName"))
+				result = "<AccessKey><UserName>fixture-user</UserName><AccessKeyId>fixture-access</AccessKeyId></AccessKey>"
+			case "CreatePolicy":
+				require.Equal(t, policyName, form.Get("PolicyName"))
+				require.Equal(t, policyDoc, form.Get("PolicyDocument"))
+				result = "<Policy><PolicyName>fixture-policy</PolicyName><Arn>" + policyArn + "</Arn></Policy>"
+			case "GetPolicy":
+				require.Equal(t, policyArn, form.Get("PolicyArn"))
+				result = "<Policy><PolicyName>fixture-policy</PolicyName><Arn>" + policyArn + "</Arn></Policy>"
+			case "ListPolicies":
+				result = "<Policies><member><PolicyName>fixture-policy</PolicyName><Arn>" + policyArn + "</Arn></member></Policies><IsTruncated>false</IsTruncated>"
+			case "AttachUserPolicy", "DetachUserPolicy":
+				require.Equal(t, userName, form.Get("UserName"))
+				require.Equal(t, policyArn, form.Get("PolicyArn"))
+			case "ListAttachedUserPolicies":
+				require.Equal(t, userName, form.Get("UserName"))
+				result = "<AttachedPolicies><member><PolicyName>fixture-policy</PolicyName><PolicyArn>" + policyArn + "</PolicyArn></member></AttachedPolicies><IsTruncated>false</IsTruncated>"
+			case "DeletePolicy":
+				require.Equal(t, policyArn, form.Get("PolicyArn"))
+			default:
+				t.Fatalf("unexpected IAM action %s", action)
+			}
+			response := fmt.Sprintf(`<%sResponse xmlns="https://iam.amazonaws.com/doc/2010-05-08/"><%sResult>%s</%sResult><ResponseMetadata><RequestId>fixture</RequestId></ResponseMetadata></%sResponse>`, action, action, result, action, action)
+			return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"text/xml"}}, Body: io.NopCloser(strings.NewReader(response)), Request: req}, nil
+		})}
+	}
+	user, err := client.CreateUser(t.Context(), &iam.CreateUserInput{UserName: aws.String(userName)}, option)
+	require.NoError(t, err)
+	require.Equal(t, userName, aws.ToString(user.User.UserName))
+	key, err := client.CreateAccessKey(t.Context(), &iam.CreateAccessKeyInput{UserName: aws.String(userName)}, option)
+	require.NoError(t, err)
+	require.Equal(t, "fixture-access", aws.ToString(key.AccessKey.AccessKeyId))
+	created, err := client.CreatePolicy(t.Context(), &iam.CreatePolicyInput{PolicyName: aws.String(policyName), PolicyDocument: aws.String(policyDoc)}, option)
+	require.NoError(t, err)
+	require.Equal(t, policyArn, aws.ToString(created.Policy.Arn))
+	got, err := client.GetPolicy(t.Context(), &iam.GetPolicyInput{PolicyArn: aws.String(policyArn)}, option)
+	require.NoError(t, err)
+	require.Equal(t, policyName, aws.ToString(got.Policy.PolicyName))
+	policies, err := client.ListPolicies(t.Context(), &iam.ListPoliciesInput{}, option)
+	require.NoError(t, err)
+	require.True(t, managedPolicyContains(policies.Policies, policyName))
+	_, err = client.AttachUserPolicy(t.Context(), &iam.AttachUserPolicyInput{UserName: aws.String(userName), PolicyArn: aws.String(policyArn)}, option)
+	require.NoError(t, err)
+	attached, err := client.ListAttachedUserPolicies(t.Context(), &iam.ListAttachedUserPoliciesInput{UserName: aws.String(userName)}, option)
+	require.NoError(t, err)
+	require.True(t, attachedPolicyContains(attached.AttachedPolicies, policyName))
+	_, err = client.DetachUserPolicy(t.Context(), &iam.DetachUserPolicyInput{UserName: aws.String(userName), PolicyArn: aws.String(policyArn)}, option)
+	require.NoError(t, err)
+	_, err = client.DeletePolicy(t.Context(), &iam.DeletePolicyInput{PolicyArn: aws.String(policyArn)}, option)
+	require.NoError(t, err)
+	require.Equal(t, []string{"CreateUser", "CreateAccessKey", "CreatePolicy", "GetPolicy", "ListPolicies", "AttachUserPolicy", "ListAttachedUserPolicies", "DetachUserPolicy", "DeletePolicy"}, actions)
+}
+
+func TestPolicyIAMSDKV2ErrorsAndBudget(t *testing.T) {
+	client := newIAMClient(t, "http://127.0.0.1:8333")
+	for _, tc := range []struct {
+		code   string
+		status int
+	}{{"NoSuchEntity", 404}, {"DeleteConflict", 409}, {"ServiceFailure", 500}} {
+		t.Run(tc.code, func(t *testing.T) {
+			attempts := 0
+			_, err := client.DeletePolicy(t.Context(), &iam.DeletePolicyInput{PolicyArn: aws.String("arn:aws:iam:::policy/fixture")}, func(o *iam.Options) {
+				o.HTTPClient = &http.Client{Transport: policyRoundTripper(func(req *http.Request) (*http.Response, error) {
+					attempts++
+					body := `<ErrorResponse><Error><Type>Sender</Type><Code>` + tc.code + `</Code><Message>fixture</Message></Error><RequestId>fixture</RequestId></ErrorResponse>`
+					return &http.Response{StatusCode: tc.status, Header: http.Header{"Content-Type": {"text/xml"}}, Body: io.NopCloser(strings.NewReader(body)), Request: req}, nil
+				}), Timeout: 30 * time.Second}
+			})
+			var apiError smithy.APIError
+			require.True(t, errors.As(err, &apiError))
+			require.Equal(t, tc.code, apiError.ErrorCode())
+			require.Equal(t, 1, attempts)
+		})
+	}
+}
+
+func TestPolicyIAMSDKV2Cancellation(t *testing.T) {
+	client := newIAMClient(t, "http://127.0.0.1:8333")
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	attempts := 0
+	_, err := client.CreateUser(ctx, &iam.CreateUserInput{UserName: aws.String("fixture")}, func(o *iam.Options) {
+		o.HTTPClient = &http.Client{Transport: policyRoundTripper(func(req *http.Request) (*http.Response, error) {
+			attempts++
+			return nil, errors.New("unexpected request after cancellation")
+		}), Timeout: 30 * time.Second}
+	})
+	require.ErrorIs(t, err, context.Canceled)
+	require.Zero(t, attempts)
+}
