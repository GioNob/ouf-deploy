new file mode 100644
index 0000000..6a2dbf0
--- /dev/null
+++ b/weed/util/googleprofile/profile.go
@@ -0,0 +1,31 @@
+// Package googleprofile defines the explicit Google integration boundary of the
+// OUF standard storage candidate. It has no credential, network or state effects.
+package googleprofile
+
+import "errors"
+
+var ErrUnsupported = errors.New("OUF_STANDARD_PROFILE_GOOGLE_UNSUPPORTED: GCS remote storage and replication, and Google PubSub notification and replication require a separately qualified candidate")
+
+type Configuration interface{ GetBool(string) bool }
+
+func ValidateRemoteType(kind string) error {
+	if kind == "gcs" {
+		return ErrUnsupported
+	}
+	return nil
+}
+func ValidateNotification(c Configuration, prefix string) error {
+	if c != nil && c.GetBool(prefix+"google_pub_sub.enabled") {
+		return ErrUnsupported
+	}
+	return nil
+}
+func ValidateReplication(c Configuration) error {
+	if err := ValidateNotification(c, "notification."); err != nil {
+		return err
+	}
+	if c != nil && c.GetBool("sink.google_cloud_storage.enabled") {
+		return ErrUnsupported
+	}
+	return nil
+}
diff --git a/weed/util/googleprofile/profile_test.go b/weed/util/googleprofile/profile_test.go
new file mode 100644
index 0000000..8d16678
--- /dev/null
+++ b/weed/util/googleprofile/profile_test.go
@@ -0,0 +1,24 @@
+package googleprofile
+
+import (
+	"errors"
+	"testing"
+)
+
+type flags map[string]bool
+
+func (f flags) GetBool(k string) bool { return f[k] }
+func TestOUFGoogleProfileKeysAndMixedConfigurations(t *testing.T) {
+	for _, key := range []string{"notification.google_pub_sub.enabled", "sink.google_cloud_storage.enabled"} {
+		for _, other := range []string{"notification.kafka.enabled", "notification.webhook.enabled", "sink.s3.enabled", "kms.openbao.enabled"} {
+			t.Run(key+"/"+other, func(t *testing.T) {
+				if e := ValidateReplication(flags{key: true, other: true}); !errors.Is(e, ErrUnsupported) {
+					t.Fatal(e)
+				}
+			})
+		}
+	}
+	if e := ValidateReplication(flags{"notification.google_pub_sub.enabled": false, "sink.s3.enabled": true}); e != nil {
+		t.Fatal(e)
+	}
+}
