diff --git a/weed/iam/wire/types_test.go b/weed/iam/wire/types_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1f83b2e61b2edd1f5a1cd1e7f51f42ef90d9020c
--- /dev/null
+++ b/weed/iam/wire/types_test.go
@@ -0,0 +1,70 @@
+package wire
+
+import (
+	"encoding/xml"
+	"reflect"
+	"testing"
+	"time"
+
+	legacy "github.com/aws/aws-sdk-go/service/iam"
+)
+
+func fillWireFixture(v reflect.Value) {
+	if v.Type() == reflect.TypeOf(time.Time{}) {
+		v.Set(reflect.ValueOf(time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)))
+		return
+	}
+	switch v.Kind() {
+	case reflect.Ptr:
+		v.Set(reflect.New(v.Type().Elem()))
+		fillWireFixture(v.Elem())
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Field(i).CanSet() {
+				fillWireFixture(v.Field(i))
+			}
+		}
+	case reflect.Slice:
+		v.Set(reflect.MakeSlice(v.Type(), 2, 2))
+		for i := 0; i < v.Len(); i++ {
+			fillWireFixture(v.Index(i))
+		}
+	case reflect.String:
+		v.SetString("fixture<&\"")
+	case reflect.Bool:
+		v.SetBool(true)
+	case reflect.Int64:
+		v.SetInt(7)
+	}
+}
+
+func TestLegacyXMLWireCompatibility(t *testing.T) {
+	pairs := [][2]any{
+		{AccessKey{}, legacy.AccessKey{}}, {AccessKeyMetadata{}, legacy.AccessKeyMetadata{}},
+		{AttachedPolicy{}, legacy.AttachedPolicy{}}, {ErrorDetails{}, legacy.ErrorDetails{}},
+		{Group{}, legacy.Group{}}, {Policy{}, legacy.Policy{}}, {PolicyVersion{}, legacy.PolicyVersion{}},
+		{User{}, legacy.User{}}, {Tag{}, legacy.Tag{}},
+		{AttachedPermissionsBoundary{}, legacy.AttachedPermissionsBoundary{}},
+	}
+	for _, pair := range pairs {
+		t.Run(reflect.TypeOf(pair[0]).Name(), func(t *testing.T) {
+			for _, populated := range []bool{false, true} {
+				var data [2][]byte
+				for i, value := range pair {
+					fixture := reflect.New(reflect.TypeOf(value)).Elem()
+					if populated {
+						fillWireFixture(fixture)
+					}
+					var err error
+					data[i], err = xml.Marshal(fixture.Interface())
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				if string(data[0]) != string(data[1]) {
+					t.Fatalf("XML differs for populated=%v: got %s want %s", populated, data[0], data[1])
+				}
+			}
+		})
+	}
+}
