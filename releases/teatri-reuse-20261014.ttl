@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix teatri: <https://api.ouf-lab.it/semantic/teatri#> .

teatri:TeatriOntology a owl:Ontology ; rdfs:label "Profilo semantico dei luoghi teatrali"@it ;
  dct:source <https://schema.org/PerformingArtsTheater>, <https://schema.org/name>, <https://schema.org/additionalType> ;
  rdfs:comment "Proposta da approvare: riuso di termini standard e proprieta qualificate della fonte. Nessuna equivalenza con Cinema, approvazione o classificazione dei dati e implicita."@it .

schema:PerformingArtsTheater a owl:Class ; rdfs:label "Luogo per le arti performative"@it ; rdfs:isDefinedBy <https://schema.org/PerformingArtsTheater> .

schema:name a rdf:Property ; rdfs:label "Nome"@it ; rdfs:isDefinedBy <https://schema.org/name> .

schema:additionalType a rdf:Property ; rdfs:label "Tipologia aggiuntiva dichiarata"@it ; rdfs:isDefinedBy <https://schema.org/additionalType> .

teatri:toponimo a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "toponimo"@it ;
  rdfs:comment "Tipo di elemento stradale riportato dalla fonte, distinto dal nome e dal numero civico; non e un indirizzo completo."@it .

teatri:nome_indirizzo a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "nome indirizzo"@it ;
  rdfs:comment "Componente nominale dell indirizzo riportata dalla fonte; non include implicitamente toponimo e civico."@it .

teatri:civico a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "civico"@it ;
  rdfs:comment "Numero civico lessicale riportato dalla fonte, compresi eventuali suffissi; nessuna risoluzione di indirizzi discordanti."@it .

teatri:cap a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "cap"@it ;
  rdfs:comment "Codice postale lessicale del luogo riportato dalla fonte. Conservare gli zeri iniziali dai byte CSV; il tipo LONG del profiler non autorizza conversioni numeriche."@it .

teatri:citta a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "citta"@it ;
  rdfs:comment "Localita dell indirizzo riportata dalla fonte; questa proprieta piatta non asserisce una risorsa PostalAddress."@it .

teatri:provincia a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "provincia"@it ;
  rdfs:comment "Provincia dell indirizzo riportata dalla fonte; il testo non e risolto in una entita amministrativa."@it .

teatri:latitudine a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "latitudine"@it ;
  rdfs:comment "Valore di latitudine riportato dalla fonte, da interpretare insieme a sistema_riferimento e precisione_coordinate; non equivale a una trasformazione WGS84 verificata."@it .

teatri:longitudine a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "longitudine"@it ;
  rdfs:comment "Valore di longitudine riportato dalla fonte, da interpretare insieme a sistema_riferimento e precisione_coordinate; non equivale a una trasformazione WGS84 verificata."@it .

teatri:sistema_riferimento a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "sistema riferimento"@it ;
  rdfs:comment "Sistema di riferimento dichiarato dalla fonte per le coordinate; nessuna trasformazione o completamento implicito."@it .

teatri:precisione_coordinate a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "precisione coordinate"@it ;
  rdfs:comment "Descrizione della precisione e del riferimento geometrico riportata dalla fonte; non convertita in una tolleranza numerica."@it .

teatri:capienza_posti a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "capienza posti"@it ;
  rdfs:comment "Posti riportati dalla fonte. Il valore puo riferirsi a una singola sala secondo note; non asserisce la capienza totale del luogo."@it .

teatri:spettacoli_stagione a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "spettacoli stagione"@it ;
  rdfs:comment "Numero di spettacoli riportato dalla fonte per stagione_riferimento; non un totale senza periodo e non un elenco di eventi."@it .

teatri:stagione_riferimento a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "stagione riferimento"@it ;
  rdfs:comment "Etichetta della stagione cui si riferisce la misura spettacoli_stagione; nessuna data di inizio o fine inferita."@it .

teatri:note a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "note"@it ;
  rdfs:comment "Annotazioni della fonte che qualificano i valori riportati, compresi ambito della capienza e discrepanze dell indirizzo."@it .

teatri:fonte_indirizzo a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "fonte indirizzo"@it ;
  rdfs:comment "Riferimento di provenienza riportato per i dati di indirizzo; non il sito ufficiale del teatro e non un ordine di accesso alla URL."@it .

teatri:fonte_coordinate a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "fonte coordinate"@it ;
  rdfs:comment "Riferimento di provenienza riportato per le coordinate; non una verifica geografica e non un ordine di accesso alla URL."@it .

teatri:fonte_altri_dati a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "fonte altri dati"@it ;
  rdfs:comment "Riferimento di provenienza riportato per altri dati; non una equivalenza di identita e non un ordine di accesso alla URL."@it .

teatri:data_verifica a owl:DatatypeProperty ;
  rdfs:domain schema:PerformingArtsTheater ; rdfs:range <http://www.w3.org/2001/XMLSchema#string> ;
  rdfs:label "data verifica"@it ;
  rdfs:comment "Data di verifica dichiarata dalla fonte per il record; non data di modifica dell oggetto urbano o prova indipendente della verifica."@it .
